# Dependencies
node_modules/

# Build output
dist/
build/

# Environment files -- never commit secrets
.env
.env.*
!.env.example

# Ansible secrets and local overrides
ansible/vault_password
ansible/*.vault
ansible/host_vars/**/*.vault.yml
ansible/group_vars/**/*.vault.yml
# Real inventory and vars files (contain secrets/IPs) -- commit only *.example.yml
ansible/inventory/hosts.yml
ansible/group_vars/all.yml
# Ansible fact cache (auto-generated)
ansible/.ansible/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
logs/

# Misc
*.tmp
*.bak
