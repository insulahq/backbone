# Server
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info

# JWT
JWT_SECRET=change-me-to-a-secure-random-string-at-least-32-chars
JWT_EXPIRES_IN=1h

# MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=platform
DB_USER=platform
DB_PASSWORD=change-me

# PowerDNS (ns1 - primary)
PDNS_NS1_URL=http://100.76.182.198:8081
PDNS_NS1_API_KEY=change-me
# PowerDNS (ns2 - secondary) - for zone delete propagation
PDNS_NS2_URL=http://100.76.92.172:8081
PDNS_NS2_API_KEY=change-me

# Platform nameservers (returned to clients on domain add)
NAMESERVER_PRIMARY=ns1.phoenix-host.net
NAMESERVER_SECONDARY=ns2.phoenix-host.net

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
