# Managed by Ansible. Do not edit manually.
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# JWT
JWT_SECRET={{ management_api_jwt_secret }}
JWT_EXPIRES_IN=1h

# MariaDB (internal Docker network — service name is the hostname)
DB_HOST=mariadb
DB_PORT=3306
DB_NAME={{ management_api_db_name }}
DB_USER={{ management_api_db_user }}
DB_PASSWORD={{ management_api_db_password }}

# PowerDNS ns1 (primary)
PDNS_NS1_URL=http://{{ ns1_netbird_ip }}:{{ pdns_api_port }}
PDNS_NS1_API_KEY={{ pdns_api_key }}

# PowerDNS ns2 (secondary — for zone delete propagation)
PDNS_NS2_URL=http://{{ ns2_netbird_ip }}:{{ pdns_api_port }}
PDNS_NS2_API_KEY={{ pdns_api_key }}

# Platform nameservers returned to clients
NAMESERVER_PRIMARY=ns1.{{ platform_domain }}
NAMESERVER_SECONDARY=ns2.{{ platform_domain }}

# Admin credentials (Phase 1 MVP — replace with Dex OIDC in Phase 2)
ADMIN_USERNAME={{ management_api_admin_username }}
ADMIN_PASSWORD={{ management_api_admin_password }}

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
