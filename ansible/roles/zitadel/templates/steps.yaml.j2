# Zitadel First Instance Setup — {{ inventory_hostname }}
# Generated by Ansible — only used during initial setup.
# These values are applied once when the instance is created.
# Subsequent runs of start-from-init skip this if the instance exists.

FirstInstance:
  Org:
    Name: "{{ zitadel_org_name }}"
    Human:
      UserName: "{{ zitadel_admin_username }}"
      FirstName: "{{ zitadel_admin_first_name }}"
      LastName: "{{ zitadel_admin_last_name }}"
      Email:
        Address: "{{ zitadel_admin_email }}"
        Verified: true
      Password: {{ zitadel_admin_password | to_json }}
      PasswordChangeRequired: false
    # Login Client — required by Zitadel v4 login v2 UI.
    # Creates a service user with IAM_LOGIN_CLIENT role + PAT so the
    # built-in login UI at /ui/v2/login/ can authenticate against the API.
    LoginClient:
      Machine:
        Username: login-client
        Name: Login Client
  DefaultLanguage: en
{% if zitadel_smtp_host is defined and zitadel_smtp_host | length > 0 %}
  SMTPConfiguration:
    SMTP:
      Host: "{{ zitadel_smtp_host }}"
      User: "{{ zitadel_smtp_user | default('') }}"
      Password: "{{ zitadel_smtp_password | default('') }}"
    TLS: {{ zitadel_smtp_tls | default(true) | lower }}
    From: "{{ zitadel_smtp_from | default('noreply@' + platform_domain) }}"
    FromName: "{{ zitadel_smtp_from_name | default(zitadel_org_name) }}"
    ReplyToAddress: "{{ zitadel_smtp_reply_to | default('support@' + platform_domain) }}"
{% endif %}
