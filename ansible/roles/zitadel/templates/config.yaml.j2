# Zitadel Runtime Configuration — {{ inventory_hostname }}
# Generated by Ansible — do not edit manually.
#
# Zitadel runs behind Traefik (TLS termination).
# Connects to PostgreSQL HA cluster via Docker network (postgresql_default).

Port: {{ zitadel_port }}

ExternalDomain: {{ zitadel_domain }}
ExternalPort: {{ zitadel_external_port }}
ExternalSecure: {{ zitadel_external_secure | lower }}

{% set peer = groups['dns_servers'] | difference([inventory_hostname]) | first %}
Database:
  postgres:
    # Multi-host: local PG container first, peer via WireGuard second.
    # Combined with PGTARGETSESSIONATTRS=read-write (set in docker-compose),
    # pgx connects to whichever node is the current PG primary.
    Host: "postgresql,{{ hostvars[peer]['wireguard_ip'] }}"
    Port: 5432
    Database: {{ zitadel_db_name }}
    MaxOpenConns: {{ zitadel_db_max_open_conns }}
    MaxIdleConns: {{ zitadel_db_max_idle_conns }}
    MaxConnLifetime: {{ zitadel_db_max_conn_lifetime }}
    MaxConnIdleTime: {{ zitadel_db_max_conn_idle_time }}
    User:
      Username: {{ zitadel_db_user }}
      Password: "{{ zitadel_db_password }}"
      SSL:
        Mode: disable
    # ACCEPTED RISK: Zitadel migrations require SUPERUSER for CREATE EXTENSION.
    # A least-privilege admin user is not feasible without patching Zitadel's
    # migration engine. Mitigations: config file on host (not shared volume),
    # no Docker socket access, network limited to postgresql_default bridge.
    Admin:
      Username: postgres
      Password: "{{ postgresql_superuser_password }}"
      SSL:
        Mode: disable

Log:
  Level: {{ zitadel_log_level }}
  Formatter:
    Format: text

# Machine identification — use hostname to distinguish nodes
Machine:
  Identification:
    Hostname:
      Enabled: true
    Webhook:
      Enabled: false

# Telemetry — disabled for self-hosted
Telemetry:
  Enabled: false

# Disable Login V2 — the v2 login UI requires a separate Login Client
# service user + PAT (ZITADEL_SERVICE_USER_TOKEN) which adds complexity.
# The v1 login UI at /ui/login/ works out of the box.
DefaultInstance:
  Features:
    LoginV2:
      Required: false

# Force OIDC to use v1 login URLs
OIDC:
  DefaultLoginURLV2: ""
  DefaultLogoutURLV2: ""
