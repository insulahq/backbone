---
# Zitadel IAM — Docker Compose ({{ inventory_hostname }})
# Central identity provider behind Traefik reverse proxy.
# Connects to PostgreSQL HA cluster via Docker network.
# Stateless — all state lives in PostgreSQL (event store).

services:
  zitadel:
    image: {{ zitadel_image }}
    container_name: zitadel
    restart: unless-stopped
    command: 'start-from-init --config /etc/zitadel/config.yaml --steps /etc/zitadel/steps.yaml --masterkeyFromEnv --tlsMode external'
    environment:
      ZITADEL_MASTERKEY: "{{ zitadel_masterkey }}"
      # pgx reads this env var to filter multi-host connections.
      # Only connects to the PG node that is currently read-write (primary).
      # Without this, pgx connects to the first reachable host which may be
      # the read-only standby, causing all writes to fail.
      PGTARGETSESSIONATTRS: "read-write"
    networks:
      - traefik_public
      # Connect to postgresql_default so Zitadel can reach PostgreSQL via Docker DNS
      # ('postgresql' hostname) without needing the WireGuard tunnel.
      - postgresql_default
    volumes:
      - {{ zitadel_install_dir }}/config.yaml:/etc/zitadel/config.yaml:ro
      - {{ zitadel_install_dir }}/steps.yaml:/etc/zitadel/steps.yaml:ro
    labels:
      - traefik.enable=true
      # Main router — handles console UI, APIs, OIDC endpoints, login UI
      - traefik.http.routers.zitadel.rule=Host(`{{ zitadel_domain }}`)
      - traefik.http.routers.zitadel.entrypoints=websecure
      - traefik.http.routers.zitadel.tls=true
      - traefik.http.routers.zitadel.service=zitadel
      # Backend service — HTTP for web, gRPC uses content-type detection
      - traefik.http.services.zitadel.loadbalancer.server.port={{ zitadel_port }}
    # No Docker healthcheck — Traefik v3.6 filters unhealthy/starting containers
    # from routing (gotcha 74). Zitadel's 'ready' command may report not-ready
    # during initial setup or migration, causing Traefik to permanently exclude it.
    logging:
      driver: "json-file"
      options:
        max-size: "200m"
        max-file: "2"

networks:
  traefik_public:
    external: true
  postgresql_default:
    external: true
