#!/bin/bash
# ==========================================================================
# OpenZiti Controller Watchdog — Active-Standby Failover
# ==========================================================================
# Runs every {{ openziti_failover_check_interval }}s via systemd timer.
# Monitors the controller health and handles failover/failback.
#
# On the PREFERRED PRIMARY ({{ openziti_primary_node }}):
#   - If controller is running locally: check health
#   - If controller is running on peer: wait settling, then failback
#
# On the STANDBY:
#   - If preferred primary's controller is reachable: do nothing
#   - If unreachable for {{ openziti_failover_threshold }} cycles: promote self
#
# On BOTH, if both controllers serve at once (a healed partition): the
# preferred primary wins unless it was offline when the standby promoted
# (gotcha 177, see dual_active_loser).
#
# The node whose controller serves points {{ openziti_domain }} at itself
# (claim_dns), and every cycle pushes its state to Gatus (OpenZiti-Controller).
# ==========================================================================

set -euo pipefail

log() { echo "$(date): ZITI-WATCHDOG: $*"; }
source /usr/local/lib/platform-alert.sh 2>/dev/null || platform_alert() { echo "[alert:$1] [$2] $3"; }

exec 200>/var/lock/ziti-watchdog.lock
flock -n 200 || { log "Another watchdog instance is running — skipping"; exit 0; }

# Skip auto-failback during explicit maintenance windows. Self-cleans if the
# marker is stale (>24h) so a forgotten marker doesn't freeze the HA stack.
MAINTENANCE_MARKER="/etc/platform-maintenance-mode"
MAINTENANCE_MARKER_MAX_AGE_SEC=86400
FRESH_INSTALL_GRACE_SEC={{ (openziti_failback_fresh_install_grace_hours | default(2)) * 3600 }}

if [ -f "$MAINTENANCE_MARKER" ]; then
    MARKER_AGE=$(( $(date +%s) - $(stat -c %Y "$MAINTENANCE_MARKER") ))
    if [ "$MARKER_AGE" -lt "$MAINTENANCE_MARKER_MAX_AGE_SEC" ]; then
        log "/etc/platform-maintenance-mode present — skipping"
        exit 0
    fi
    log "stale maintenance marker (${MARKER_AGE}s old) — removing and resuming"
    rm -f "$MAINTENANCE_MARKER"
fi

INSTALL_DIR="{{ openziti_install_dir }}"
CTRL_DIR="{{ openziti_controller_dir }}"
NODE_NAME="{{ inventory_hostname }}"
PREFERRED_PRIMARY="{{ openziti_primary_node }}"
PEER_NAME="{{ groups['dns_servers'] | difference([inventory_hostname]) | first }}"
PEER_WG_IP="{{ hostvars[groups['dns_servers'] | difference([inventory_hostname]) | first]['wireguard_ip'] }}"
LOCAL_WG_IP="{{ wireguard_ip }}"
EDGE_PORT="{{ openziti_edge_port }}"
ZITI_DOMAIN="{{ openziti_domain }}"
LOCAL_PUBLIC_IP="{{ ansible_host }}"
LOCAL_PUBLIC_IPV6="{{ public_ipv6 | default('') }}"
# In the form dig prints, so the comparison in claim_dns holds.
if [ -n "$LOCAL_PUBLIC_IPV6" ]; then
    LOCAL_PUBLIC_IPV6=$(python3 -c 'import ipaddress,sys; print(ipaddress.ip_address(sys.argv[1]).compressed)' "$LOCAL_PUBLIC_IPV6" 2>/dev/null || echo "$LOCAL_PUBLIC_IPV6")
fi
STATE_DIR="/var/lib/openziti"
mkdir -p "$STATE_DIR"
FAILURE_FILE="${STATE_DIR}/watchdog-failures"
PROMOTED_FILE="${STATE_DIR}/controller-promoted"

# Check if controller is healthy at a given IP
check_controller() {
    local ip="$1"
    curl -fsSk --max-time 5 "https://${ip}:${EDGE_PORT}/edge/client/v1/version" >/dev/null 2>&1
}

# A controller container's StartedAt as epoch seconds, empty when unreadable.
local_started() {
    local at
    at=$(docker inspect ziti-controller --format '{% raw %}{{.State.StartedAt}}{% endraw %}' 2>/dev/null || true)
    [ -n "$at" ] && date -d "$at" +%s 2>/dev/null || true
}
peer_started() {
    local at
    at=$(ssh -o ConnectTimeout=5 -o StrictHostKeyChecking=yes -i /root/.ssh/peer_key "root@${PEER_WG_IP}" \
        "docker inspect ziti-controller --format '{% raw %}{{.State.StartedAt}}{% endraw %}'" 2>/dev/null || true)
    [ -n "$at" ] && date -d "$at" +%s 2>/dev/null || true
}

# Both controllers serving, each on its own DB (gotcha 177). A partition that
# heals leaves the standby's promoted controller next to the preferred
# primary's, which never stopped, and nothing used to stop either of them.
# The preferred primary wins unless it was offline when the standby promoted.
# Offline shows in the start times: a preferred controller that started after
# the standby's was down while the standby took over, so its DB is the older
# one. Both nodes apply this rule to the same two start times and each only
# ever stops its own controller, so exactly one of them stands down.
# Prints the node that stands down, or nothing when a start time is unreadable.
dual_active_loser() {
    local mine theirs preferred_start standby_start standby_node
    mine=$(local_started)
    theirs=$(peer_started)
    if [ -z "$mine" ] || [ -z "$theirs" ]; then
        return 0
    fi
    if [ "$NODE_NAME" = "$PREFERRED_PRIMARY" ]; then
        preferred_start=$mine; standby_start=$theirs; standby_node=$PEER_NAME
    else
        preferred_start=$theirs; standby_start=$mine; standby_node=$NODE_NAME
    fi
    if [ "$preferred_start" -gt "$standby_start" ]; then
        echo "$PREFERRED_PRIMARY"
    else
        echo "$standby_node"
    fi
}

# Stop the local controller and keep the DB it wrote, which the next db-sync
# (standby) or failback sync (preferred primary) replaces. The three newest
# copies are kept. A failed copy must not stop the router from moving over.
stand_down_local() {
    local archive
    archive="${STATE_DIR}/stood-down-$(date +%Y%m%dT%H%M%S)"
    (cd "${INSTALL_DIR}" && docker compose stop ziti-controller ziti-console)
    if mkdir -p "$archive" && cp -a "${CTRL_DIR}/db/." "$archive/"; then
        log "Local controller stopped; the DB it wrote is kept in ${archive}"
    else
        log "WARNING: local controller stopped, but its DB could not be copied to ${archive}"
    fi
    find "$STATE_DIR" -maxdepth 1 -type d -name 'stood-down-*' | sort -r | tail -n +4 | xargs -r rm -rf || true
    rm -f {{ openziti_router_dir }}/endpoints 2>/dev/null || true
    (cd "${INSTALL_DIR}" && docker compose restart ziti-router) || log "WARNING: router restart failed"
}

# {{ openziti_domain }} must name the node whose controller serves: Traefik
# routes it to the local controller only, so the other node answers 404. It
# used to follow the PG primary through platform-dns-switch, while the
# controller fails over here, on its own (gotcha 180). A node only points the
# name at itself when its own controller serves, or at the peer when it
# stands down. Cheap when nothing is to do: one query to the local server.
claim_dns() {
{% if openziti_create_dns_records | default(true) | bool %}
    local current current6=""
    current=$(dig +short "$ZITI_DOMAIN" A @"$LOCAL_PUBLIC_IP" +time=3 +tries=1 2>/dev/null | sort | paste -sd' ' || true)
    if [ -n "$LOCAL_PUBLIC_IPV6" ]; then
        current6=$(dig +short "$ZITI_DOMAIN" AAAA @"$LOCAL_PUBLIC_IP" +time=3 +tries=1 2>/dev/null | sort | paste -sd' ' || true)
    fi
    if [ "$current" = "$LOCAL_PUBLIC_IP" ] && [ "$current6" = "$LOCAL_PUBLIC_IPV6" ]; then
        return 0
    fi
    if /usr/local/bin/platform-dns-switch primary-only --name "$ZITI_DOMAIN" >/dev/null 2>&1; then
        log "DNS: ${ZITI_DOMAIN} now names this node (was ${current:-unresolved}${current6:+ / ${current6}})"
    else
        log "WARNING: could not point ${ZITI_DOMAIN} at this node — retrying next cycle"
    fi
{% endif %}
    return 0
}
release_dns() {
{% if openziti_create_dns_records | default(true) | bool %}
    /usr/local/bin/platform-dns-switch drain-self --name "$ZITI_DOMAIN" >/dev/null 2>&1 \
        || log "WARNING: could not point ${ZITI_DOMAIN} at ${PEER_NAME} — its watchdog claims it"
{% endif %}
    return 0
}

# Every cycle that gets past the lock and the maintenance check pushes this
# node's view to Gatus: green on the preferred primary while its controller
# alone serves, green on the standby while its own does not serve. A failover,
# two controllers or none are red, so the alerting providers page on them; the
# watchdog used to log them only. Events also go through platform_alert.
STATE_OK=false
STATE_MSG="watchdog cycle ended early"
set_state() { STATE_OK="$1"; STATE_MSG="$2"; }
push_state() {
    local token
    token=$(cat /etc/gatus-token 2>/dev/null || true)
    [ -n "$token" ] || return 0
    if [ "$STATE_OK" = "true" ]; then
        curl -fsS --max-time 3 -X POST \
            "http://127.0.0.1:{{ gatus_local_port | default('8080') }}/api/v1/endpoints/{{ inventory_hostname }}_openziti-controller/external?success=true" \
            -H "Authorization: Bearer ${token}" >/dev/null 2>&1 || true
    else
        curl -fsS --max-time 3 -X POST -G \
            "http://127.0.0.1:{{ gatus_local_port | default('8080') }}/api/v1/endpoints/{{ inventory_hostname }}_openziti-controller/external" \
            --data-urlencode "success=false" --data-urlencode "error=${STATE_MSG}" \
            -H "Authorization: Bearer ${token}" >/dev/null 2>&1 || true
    fi
}
trap push_state EXIT

# Get current failure count
FAILURES=$(cat "$FAILURE_FILE" 2>/dev/null || echo "0")

# Is the local controller running?
LOCAL_RUNNING=$(docker inspect ziti-controller --format '{% raw %}{{.State.Running}}{% endraw %}' 2>/dev/null || echo "false")

{% if inventory_hostname == (openziti_primary_node | default('ns1')) %}
# === PREFERRED PRIMARY NODE ===

if [ "$LOCAL_RUNNING" = "true" ] && check_controller "$LOCAL_WG_IP"; then
    # Controller healthy locally — normal state
    echo "0" > "$FAILURE_FILE"
    rm -f "$PROMOTED_FILE"
    if check_controller "$PEER_WG_IP"; then
        set_state false "two controllers serve (dual active)"
        LOSER=$(dual_active_loser)
        if [ "$LOSER" = "$NODE_NAME" ]; then
            log "=== DUAL ACTIVE: ${PEER_NAME} promoted while this controller was down — standing down (gotcha 177) ==="
            stand_down_local
            release_dns
            # The failback settling starts now; the failback syncs the peer's DB back.
            touch "$PROMOTED_FILE"
            platform_alert "warning" "OpenZiti-Controller" "Two controllers served: ${PEER_NAME} promoted while this one was down, so this one stood down. Its DB is kept under ${STATE_DIR}/stood-down-*; failback follows after the settling time."
            set_state false "stood down after dual active; ${PEER_NAME} serves"
        elif [ -n "$LOSER" ]; then
            log "DUAL ACTIVE: this controller ran throughout — ${PEER_NAME} stands down (gotcha 177)"
            claim_dns
        else
            log "DUAL ACTIVE: cannot read both controller start times — no action this cycle"
        fi
        exit 0
    fi
    claim_dns
    set_state true "controller serves on ${NODE_NAME}"
    exit 0
fi

# Controller not running locally — check if peer has it (failover happened)
if check_controller "$PEER_WG_IP"; then
    set_state false "controller serves on ${PEER_NAME}, not on ${NODE_NAME} (failover)"
    {% if openziti_failback_enabled | default(true) %}
    # Peer has the controller — attempt failback
    if [ ! -f "$PROMOTED_FILE" ]; then
        log "Controller running on peer. Starting failback settling period."
        touch "$PROMOTED_FILE"
        exit 0
    fi

    # Check settling period
    PROMOTED_AGE=$(( $(date +%s) - $(stat -c %Y "$PROMOTED_FILE") ))
    if [ "$PROMOTED_AGE" -lt $(( {{ openziti_failback_settling_minutes }} * 60 )) ]; then
        log "Failback settling: ${PROMOTED_AGE}s / $(( {{ openziti_failback_settling_minutes }} * 60 ))s"
        exit 0
    fi

    # Fresh-install grace — if the local ziti-controller container was created
    # within the grace window, the node is likely mid-deploy. Let Ansible finish
    # before racing to failback. Detected via `.Created` (reset only on
    # `--force-recreate`, not on plain `docker restart`).
    CTRL_CREATED=$(docker inspect ziti-controller --format '{% raw %}{{.Created}}{% endraw %}' 2>/dev/null || echo "")
    if [ -n "$CTRL_CREATED" ]; then
        CREATED_EPOCH=$(date -d "$CTRL_CREATED" +%s 2>/dev/null || echo "0")
        CREATED_AGE=$(( $(date +%s) - CREATED_EPOCH ))
        if [ "$CREATED_EPOCH" -gt 0 ] && [ "$CREATED_AGE" -lt "$FRESH_INSTALL_GRACE_SEC" ]; then
            log "Controller created ${CREATED_AGE}s ago (<${FRESH_INSTALL_GRACE_SEC}s grace) — skipping failback"
            exit 0
        fi
    fi

    log "=== FAILBACK: Returning controller to preferred primary ==="

    # 1. Stop DB sync on peer (prevent overwriting during transition)
    ssh -o ConnectTimeout=5 -o StrictHostKeyChecking=yes -i /root/.ssh/peer_key "root@${PEER_WG_IP}" \
        "systemctl stop ziti-db-sync.timer 2>/dev/null || true" 2>/dev/null || true

    # 2. Stop controller on peer FIRST (must quiesce writes before DB copy).
    # Zero the peer's failure count with it: it grew every cycle the peer
    # served, so the peer's next cycle, which finds neither controller
    # healthy while this one starts, would promote it straight back.
    log "Stopping controller on peer"
    ssh -o ConnectTimeout=5 -o StrictHostKeyChecking=yes -i /root/.ssh/peer_key "root@${PEER_WG_IP}" \
        "echo 0 > ${FAILURE_FILE}; cd ${INSTALL_DIR} && docker compose stop ziti-controller ziti-console 2>/dev/null || true" 2>/dev/null || {
        log "ERROR: Could not stop controller on peer — aborting failback to prevent split-brain"
        platform_alert "warning" "OpenZiti-Controller" "Failback aborted: the controller on ${PEER_NAME} could not be stopped; it keeps serving."
        exit 1
    }

    # 3. Sync DB from peer (controller is stopped — safe to copy)
    log "Syncing DB from peer (controller quiesced)"
    rsync -az -e "ssh -o ConnectTimeout=5 -i /root/.ssh/peer_key" \
        "root@${PEER_WG_IP}:${CTRL_DIR}/db/" "${CTRL_DIR}/db/" 2>/dev/null || {
        log "ERROR: DB sync from peer failed — restarting peer controller"
        platform_alert "warning" "OpenZiti-Controller" "Failback aborted: the DB sync from ${PEER_NAME} failed; its controller is started again."
        # Restart peer controller since we stopped it but can't proceed
        ssh -o ConnectTimeout=5 -o StrictHostKeyChecking=yes -i /root/.ssh/peer_key "root@${PEER_WG_IP}" \
            "cd ${INSTALL_DIR} && docker compose up -d --force-recreate ziti-controller ziti-console 2>/dev/null || true" 2>/dev/null || true
        exit 1
    }

    # 4. Start controller locally.
    # CRITICAL: peer controller is already stopped. If the local start fails
    # (image pull error, Docker daemon glitch, disk full), `set -e` would exit
    # and leave BOTH controllers stopped — a complete OpenZiti outage. Restart
    # the peer controller so at least one side is serving clients.
    log "Starting controller locally"
    if ! (cd "${INSTALL_DIR}" && docker compose up -d --force-recreate ziti-controller ziti-console); then
        log "ERROR: local controller start failed — restarting peer controller to avoid outage"
        platform_alert "critical" "OpenZiti-Controller" "Failback failed: the controller on ${NODE_NAME} did not start; the one on ${PEER_NAME} is started again."
        ssh -o ConnectTimeout=5 -o StrictHostKeyChecking=yes -i /root/.ssh/peer_key "root@${PEER_WG_IP}" \
            "cd ${INSTALL_DIR} && docker compose up -d --force-recreate ziti-controller ziti-console 2>/dev/null || true" 2>/dev/null || true
        exit 1
    fi

    # 5. Wait for controller to be ready
    for i in $(seq 1 12); do
        check_controller "$LOCAL_WG_IP" && break
        sleep 5
    done
    if check_controller "$LOCAL_WG_IP"; then
        claim_dns
    fi

    rm -f "$PROMOTED_FILE"
    echo "0" > "$FAILURE_FILE"

    # 6. Restart local router to discover the local controller
    log "Restarting local router to connect to failback controller"
    rm -f {{ openziti_router_dir }}/endpoints 2>/dev/null || true
    cd "${INSTALL_DIR}" && docker compose restart ziti-router

    # 7. Restart peer router to discover the failback controller
    ssh -o ConnectTimeout=5 -o StrictHostKeyChecking=yes -i /root/.ssh/peer_key "root@${PEER_WG_IP}" \
        "rm -f {{ openziti_router_dir }}/endpoints 2>/dev/null || true; cd ${INSTALL_DIR} && docker compose restart ziti-router 2>/dev/null || true" 2>/dev/null || true

    # 8. Restart DB sync on peer
    ssh -o ConnectTimeout=5 -o StrictHostKeyChecking=yes -i /root/.ssh/peer_key "root@${PEER_WG_IP}" \
        "systemctl start ziti-db-sync.timer 2>/dev/null || true" 2>/dev/null || true

    log "=== FAILBACK COMPLETE ==="
    if check_controller "$LOCAL_WG_IP"; then
        platform_alert "info" "OpenZiti-Controller" "Failback complete: the controller serves on ${NODE_NAME} again."
        set_state true "controller serves on ${NODE_NAME}"
    else
        platform_alert "critical" "OpenZiti-Controller" "Failback finished, but the controller on ${NODE_NAME} does not answer."
        set_state false "controller on ${NODE_NAME} does not answer after failback"
    fi
    {% endif %}
    # The peer serves (or just handed over). The self-heal below would start a
    # second controller, and after a failback it recreated the one just
    # started, because LOCAL_RUNNING still holds the value from before.
    exit 0
fi

# Neither local nor peer controller is running — self-heal
set_state false "no controller serves"
if [ "$LOCAL_RUNNING" != "true" ]; then
    log "WARNING: No controller running anywhere — attempting self-heal on preferred primary"
    cd "${INSTALL_DIR}" && docker compose up -d --force-recreate ziti-controller ziti-console
    sleep 10
    if check_controller "$LOCAL_WG_IP"; then
        log "Self-heal successful — controller running on preferred primary"
        rm -f "${STATE_DIR}/watchdog-failures" "${STATE_DIR}/controller-promoted" 2>/dev/null
        claim_dns
        platform_alert "warning" "OpenZiti-Controller" "No controller was serving; it was started again on ${NODE_NAME}."
        set_state true "controller serves on ${NODE_NAME} (self-healed)"
        # Restart local router to connect to local controller
        rm -f {{ openziti_router_dir }}/endpoints 2>/dev/null || true
        cd "${INSTALL_DIR}" && docker compose restart ziti-router
    else
        log "ERROR: Self-heal failed — controller could not start"
        platform_alert "critical" "OpenZiti-Controller" "No controller serves, and starting it on ${NODE_NAME} failed."
    fi
fi

{% else %}
# === STANDBY NODE ===

PREFERRED_PUBLIC_IPS="{{ hostvars[openziti_primary_node]['ansible_host'] }}{% if hostvars[openziti_primary_node]['public_ipv6'] is defined %} [{{ hostvars[openziti_primary_node]['public_ipv6'] }}]{% endif %}"

# Whether the preferred primary's controller answers through its own Traefik
# on a public address. Routers reach it there as well (their ctrl endpoints
# list the peer's public address), so a standby that loses only the WireGuard
# path has nothing to take over: promoting would make a second controller, and
# both would claim {{ openziti_domain }}. A preferred primary whose Traefik is
# down fails this too, and then the failover is wanted.
preferred_serves_publicly() {
    local ip
    for ip in $PREFERRED_PUBLIC_IPS; do
        curl -fsSk --max-time 5 --resolve "${ZITI_DOMAIN}:443:${ip}" \
            "https://${ZITI_DOMAIN}/edge/client/v1/version" >/dev/null 2>&1 && return 0
    done
    return 1
}

# Check if preferred primary's controller is reachable
if check_controller "{{ hostvars[openziti_primary_node]['wireguard_ip'] }}"; then
    # Primary is healthy — reset failure count
    echo "0" > "$FAILURE_FILE"
    if [ "$LOCAL_RUNNING" = "true" ]; then
        set_state false "two controllers serve (dual active)"
        LOSER=$(dual_active_loser)
        if [ "$LOSER" = "$NODE_NAME" ]; then
            log "=== DUAL ACTIVE: ${PREFERRED_PRIMARY}'s controller ran throughout — standing down (gotcha 177) ==="
            stand_down_local
            release_dns
            rm -f "$PROMOTED_FILE"
            systemctl start ziti-db-sync.timer 2>/dev/null || true
            platform_alert "warning" "OpenZiti-Controller" "Two controllers served: ${PREFERRED_PRIMARY}'s ran throughout, so the one on ${NODE_NAME} stood down. Its DB is kept under ${STATE_DIR}/stood-down-*."
            set_state true "stood down after dual active; ${PREFERRED_PRIMARY} serves"
        elif [ -n "$LOSER" ]; then
            log "DUAL ACTIVE: ${PREFERRED_PRIMARY}'s controller started after this one — it stands down, and its failback syncs this DB (gotcha 177)"
            claim_dns
        else
            log "DUAL ACTIVE: cannot read both controller start times — no action this cycle"
        fi
        exit 0
    fi
    rm -f "$PROMOTED_FILE"
    set_state true "standby; ${PREFERRED_PRIMARY} serves"
    exit 0
fi

# Unreachable over WireGuard only: no failover, and no claim on the record.
if preferred_serves_publicly; then
    echo "0" > "$FAILURE_FILE"
    if [ "$LOCAL_RUNNING" = "true" ]; then
        log "WARNING: ${PREFERRED_PRIMARY}'s controller is unreachable over WireGuard but serves publicly, and this one serves too; the dual-active rule applies once WireGuard is back"
        set_state false "two controllers may serve: ${PREFERRED_PRIMARY}'s is unreachable over WireGuard only"
    else
        log "${PREFERRED_PRIMARY}'s controller is unreachable over WireGuard but serves publicly, no failover"
        set_state true "standby; ${PREFERRED_PRIMARY} serves (unreachable over WireGuard only)"
    fi
    exit 0
fi

# Primary unreachable — increment failure count
FAILURES=$((FAILURES + 1))
echo "$FAILURES" > "$FAILURE_FILE"
log "Primary controller unreachable. Failure count: ${FAILURES}/{{ openziti_failover_threshold }}"

# Already promoted and serving: keep the name here even below the threshold,
# for when the preferred primary just stood down (release_dns covers that
# too, unless its write failed).
if [ "$LOCAL_RUNNING" = "true" ] && check_controller "$LOCAL_WG_IP"; then
    claim_dns
    set_state false "controller serves on ${NODE_NAME}: ${PREFERRED_PRIMARY}'s is unreachable (failover)"
    log "Already promoted and healthy"
    exit 0
fi

if [ "$FAILURES" -lt "{{ openziti_failover_threshold }}" ]; then
    # A blip until the threshold: not reported yet.
    set_state true "standby; ${PREFERRED_PRIMARY}'s controller missed ${FAILURES} check(s)"
    exit 0
fi

log "=== FAILOVER: Promoting standby to active controller ==="

# 1. Stop DB sync (prevent overwriting our DB with stale data)
systemctl stop ziti-db-sync.timer 2>/dev/null || true

# 2. Start controller using synced DB
log "Starting controller from synced DB"
cd "${INSTALL_DIR}" && docker compose up -d --force-recreate ziti-controller ziti-console

# 3. Wait for controller to be ready
for i in $(seq 1 12); do
    check_controller "$LOCAL_WG_IP" && break
    sleep 5
done

if check_controller "$LOCAL_WG_IP"; then
    log "=== FAILOVER COMPLETE: Controller active on {{ inventory_hostname }} ==="
    touch "$PROMOTED_FILE"
    claim_dns
    platform_alert "warning" "OpenZiti-Controller" "Failover: ${PREFERRED_PRIMARY}'s controller was unreachable for ${FAILURES} checks, so the controller now serves on ${NODE_NAME}."
    set_state false "controller serves on ${NODE_NAME}: ${PREFERRED_PRIMARY}'s is unreachable (failover)"

    # 4. Restart local router so it discovers the local controller.
    # The router caches controller endpoints in /openziti/router/endpoints
    # (from the controller's advertiseAddress). After failover, the cached
    # endpoint points to the dead node. Clear it so the router falls back
    # to ctrl.endpoints from config (which includes 127.0.0.1).
    log "Restarting local router to connect to promoted controller"
    rm -f {{ openziti_router_dir }}/endpoints 2>/dev/null || true
    cd "${INSTALL_DIR}" && docker compose restart ziti-router
else
    log "ERROR: Controller failed to start after promotion"
    platform_alert "critical" "OpenZiti-Controller" "Failover failed: ${PREFERRED_PRIMARY}'s controller is unreachable and the one on ${NODE_NAME} did not start."
    set_state false "no controller serves: promotion on ${NODE_NAME} failed"
fi

{% endif %}
