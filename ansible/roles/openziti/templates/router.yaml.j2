# OpenZiti Edge Router Configuration — {{ inventory_hostname }}
# Generated by Ansible — do not edit manually.

v: 3

identity:
  cert: /openziti/router/certs/router-{{ inventory_hostname }}.cert
  server_cert: /openziti/router/certs/router-{{ inventory_hostname }}.server.chain.cert
  key: /openziti/router/keys/router-{{ inventory_hostname }}.key
  ca: /openziti/pki/cas.pem

# Controller endpoints — lists both nodes for failover
ctrl:
  endpoints:
{% for host in groups['dns_servers'] %}
    - tls:{{ hostvars[host]['wireguard_ip'] }}:{{ openziti_ctrl_port }}
{% endfor %}
  heartbeatIntervalSeconds: 10

# Link listeners — router-to-router mesh
link:
  listeners:
    - binding: transport
      bind: tls:0.0.0.0:6262
      advertise: tls:{{ wireguard_ip }}:6262

# Edge listener — tunneler clients connect here (public-facing)
listeners:
  - binding: edge
    address: tls:0.0.0.0:{{ openziti_router_port }}
    options:
      advertise: {{ ansible_host }}:{{ openziti_router_port }}
      maxQueuedConnects: 50
      maxOutstandingConnects: 100
      connectTimeoutMs: 3000

# Edge settings
edge:
  heartbeatIntervalSeconds: 60

# Tunneler mode — allows this router to host services
tunnel:
  mode: host

# Logging
logLevel: {{ openziti_log_level }}
