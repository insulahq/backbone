services:
  # Controller — present on both nodes; only started on the active node.
  # The standby's controller stays stopped until the watchdog promotes it.
  ziti-controller:
    image: {{ openziti_controller_image }}
    container_name: ziti-controller
    restart: unless-stopped
    networks:
      - ziti_internal
      - traefik_public
    ports:
      # Fabric port — public, mTLS-secured (not HTTP, can't go through Traefik)
      - '0.0.0.0:{{ openziti_ctrl_port }}:{{ openziti_ctrl_port }}'
      - '[::]:{{ openziti_ctrl_port }}:{{ openziti_ctrl_port }}'
      # Edge API on WireGuard — for internal router enrollment and CLI access
      - '{{ wireguard_ip }}:{{ openziti_edge_port }}:{{ openziti_edge_port }}'
    volumes:
      - {{ openziti_install_dir }}/pki:/openziti/pki:ro
      - {{ openziti_controller_dir }}:/openziti/controller
    command: ["run", "/openziti/controller/controller.yaml"]
    labels:
      - traefik.enable=true
      # Edge API — proxied through Traefik with Let's Encrypt cert
      # Handles: tunneler auth, enrollment, service discovery, ZAC API calls
      - traefik.http.routers.ziti-api.rule=Host(`{{ openziti_domain }}`) && (PathPrefix(`/edge`) || PathPrefix(`/fabric`) || PathPrefix(`/oidc`) || PathPrefix(`/.well-known`))
      - traefik.http.routers.ziti-api.entrypoints=websecure
      - traefik.http.routers.ziti-api.tls=true
      - traefik.http.routers.ziti-api.priority=100
      - traefik.http.routers.ziti-api.middlewares=ratelimit@file
      - traefik.http.services.ziti-api.loadbalancer.server.port={{ openziti_edge_port }}
      - traefik.http.services.ziti-api.loadbalancer.server.scheme=https
      - traefik.http.services.ziti-api.loadbalancer.serversTransport=insecureTransport@file
    healthcheck:
      test: ["CMD", "ziti", "agent", "stats"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s
    logging:
      driver: "json-file"
      options:
        max-size: "100m"
        max-file: "3"

  # ZAC Admin Console — behind Traefik (catch-all for ziti.<domain>)
  # Present on both nodes; only started on the active controller node.
  ziti-console:
    image: {{ openziti_console_image }}
    container_name: ziti-console
    restart: unless-stopped
    networks:
      - traefik_public
    environment:
      # Public URL — ZAC JavaScript calls the controller API from the browser
      ZAC_CONTROLLER_URLS: "https://{{ openziti_domain }}"
    labels:
      - traefik.enable=true
      - traefik.http.routers.ziti-console.rule=Host(`{{ openziti_domain }}`)
      - traefik.http.routers.ziti-console.entrypoints=websecure
      - traefik.http.routers.ziti-console.tls=true
      - traefik.http.routers.ziti-console.middlewares=ratelimit@file
      - traefik.http.routers.ziti-console.priority=1
      - traefik.http.services.ziti-console.loadbalancer.server.port=1408
    logging:
      driver: "json-file"
      options:
        max-size: "50m"
        max-file: "2"

  # Edge Router — runs on both nodes (active-active, public-facing)
  # Uses host network so it can reach the local controller via 127.0.0.1
  # (avoids hairpin NAT when router and controller are on the same host).
  # Ports 3022 (edge) and 6262 (link mesh) bind directly on the host.
  ziti-router:
    image: {{ openziti_router_image }}
    container_name: ziti-router
    entrypoint: ["ziti", "router"]
    restart: unless-stopped
    network_mode: host
    volumes:
      - {{ openziti_pki_dir }}:/openziti/pki:ro
      - {{ openziti_router_dir }}:/openziti/router
    command: ["run", "/openziti/router/router.yaml"]
    healthcheck:
      test: ["CMD", "ziti", "agent", "stats"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s
    logging:
      driver: "json-file"
      options:
        max-size: "100m"
        max-file: "3"

networks:
  ziti_internal:
    driver: bridge
  traefik_public:
    external: true
    name: {{ traefik_public_network | default('traefik_public') }}
