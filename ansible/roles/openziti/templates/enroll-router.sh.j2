#!/bin/bash
# Enroll edge router with the OpenZiti controller.
# Runs inside the ziti-cli container. Idempotent — skips if already enrolled.
#
# Uses the direct WireGuard URL for enrollment (OpenZiti PKI verification).
# The public URL (via Traefik) can't be used for enrollment because
# Traefik terminates TLS with Let's Encrypt, but enrollment needs the
# OpenZiti CA chain for JWT signature verification.

set -eu

# Controller endpoints — try all WireGuard IPs (primary first)
CTRL_ENDPOINTS=(
    "https://{{ hostvars[openziti_primary_node]['wireguard_ip'] }}:{{ openziti_edge_port }}"
{% for host in groups['dns_servers'] %}
{% if host != openziti_primary_node %}
    "https://{{ hostvars[host]['wireguard_ip'] }}:{{ openziti_edge_port }}"
{% endif %}
{% endfor %}
)
ADMIN_USER="{{ openziti_admin_user }}"
ADMIN_PASS="{{ openziti_admin_password }}"
ROUTER_NAME="router-{{ inventory_hostname }}"
NODE_NAME="{{ inventory_hostname }}"

log() { echo "[$(date -Iseconds)] ENROLL: $*"; }

# Check if already enrolled
if [ -f "/openziti/router/certs/router-${NODE_NAME}.cert" ]; then
    log "Router already enrolled, skipping"
    exit 0
fi

# Wait for controller to be ready (try all endpoints)
log "Waiting for controller..."
LOGGED_IN=false
for i in $(seq 1 30); do
    for CTRL in "${CTRL_ENDPOINTS[@]}"; do
        if ziti edge login "${CTRL}" -u "${ADMIN_USER}" -p "${ADMIN_PASS}" --yes 2>/dev/null; then
            log "Controller login successful at ${CTRL}"
            LOGGED_IN=true
            break 2
        fi
    done
    sleep 5
done

if [ "$LOGGED_IN" != "true" ]; then
    log "ERROR: Could not login to any controller endpoint"
    exit 1
fi

# Delete existing router if present (clean slate for re-enrollment)
log "Removing existing router identity (if any)"
ziti edge delete edge-router "${ROUTER_NAME}" 2>/dev/null || true

# Create edge router and capture JWT
log "Creating edge router: ${ROUTER_NAME}"
ziti edge create edge-router "${ROUTER_NAME}" \
    --jwt-output-file /tmp/router.jwt \
    --tunneler-enabled

if [ ! -f /tmp/router.jwt ]; then
    echo "ERROR: Failed to create router or get enrollment JWT"
    exit 1
fi

# Enroll the router using the direct controller connection
log "Enrolling router with JWT"
ziti router enroll /openziti/router/router.yaml \
    --jwt /tmp/router.jwt

rm -f /tmp/router.jwt

log "Router ${ROUTER_NAME} enrolled successfully"
