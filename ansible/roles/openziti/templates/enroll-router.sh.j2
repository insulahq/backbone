#!/bin/sh
# Enroll edge router with the OpenZiti controller.
# Runs inside the ziti-cli container. Idempotent — skips if already enrolled.

set -eu

CTRL_URL="https://{{ hostvars[openziti_primary_node]['wireguard_ip'] }}:{{ openziti_edge_port }}"
ADMIN_USER="{{ openziti_admin_user }}"
ADMIN_PASS="{{ openziti_admin_password }}"
ROUTER_NAME="router-{{ inventory_hostname }}"
NODE_NAME="{{ inventory_hostname }}"

log() { echo "[$(date -Iseconds)] ENROLL: $*"; }

# Check if already enrolled
if [ -f "/openziti/router/certs/router-${NODE_NAME}.cert" ]; then
    log "Router already enrolled, skipping"
    exit 0
fi

# Wait for controller to be ready
log "Waiting for controller at ${CTRL_URL}..."
for i in $(seq 1 30); do
    if ziti edge login "${CTRL_URL}" -u "${ADMIN_USER}" -p "${ADMIN_PASS}" --yes 2>/dev/null; then
        log "Controller login successful"
        break
    fi
    sleep 5
done

# Delete existing router if present (clean slate for re-enrollment)
log "Removing existing router identity (if any)"
ziti edge delete edge-router "${ROUTER_NAME}" 2>/dev/null || true

# Create edge router and capture JWT
log "Creating edge router: ${ROUTER_NAME}"
ziti edge create edge-router "${ROUTER_NAME}" \
    --jwt-output-file /tmp/router.jwt \
    --tunneler-enabled

if [ ! -f /tmp/router.jwt ]; then
    echo "ERROR: Failed to create router or get enrollment JWT"
    exit 1
fi

# Enroll the router
log "Enrolling router with JWT"
ziti router enroll /openziti/router/router.yaml \
    --jwt /tmp/router.jwt

log "Router ${ROUTER_NAME} enrolled successfully"
