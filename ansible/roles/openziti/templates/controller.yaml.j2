# OpenZiti Controller Configuration — {{ inventory_hostname }}
# Generated by Ansible — do not edit manually.

v: 3

identity:
  cert: /openziti/pki/intermediate-ca/certs/controller-server.cert
  server_cert: /openziti/pki/intermediate-ca/certs/controller-server.cert
  key: /openziti/pki/intermediate-ca/keys/controller-server.key
  ca: /openziti/pki/cas.pem

# Fabric control channel — routers connect here (public, mTLS-secured)
ctrl:
  listener: tls:0.0.0.0:{{ openziti_ctrl_port }}
  options:
    advertiseAddress: tls:{{ ansible_host }}:{{ openziti_ctrl_port }}

# Database
db: /openziti/controller/db/ctrl.db

# Edge configuration
edge:
  api:
    # Public address — how tunnelers and ZAC reach the edge API (via Traefik)
    address: {{ openziti_domain }}:443
    activityUpdateInterval: 90s
    activityUpdateBatchSize: 250
    sessionTimeout: 30m
  enrollment:
    signingCert:
      cert: /openziti/pki/edge-signer/certs/edge-signer.cert
      key: /openziti/pki/edge-signer/keys/edge-signer.key
    edgeIdentity:
      duration: 180m
    edgeRouter:
      duration: 180m

# Web listeners — edge API (proxied by Traefik on :443)
web:
  - name: all-apis
    bindPoints:
      - interface: 0.0.0.0:{{ openziti_edge_port }}
        address: {{ openziti_domain }}:443
    identity:
      cert: /openziti/pki/intermediate-ca/certs/controller-server.cert
      server_cert: /openziti/pki/intermediate-ca/certs/controller-server.cert
      key: /openziti/pki/intermediate-ca/keys/controller-server.key
      ca: /openziti/pki/cas.pem
    options:
      idleTimeout: 5000ms
      readTimeout: 5000ms
      writeTimeout: 100000ms
      minTLSVersion: TLS1.2
    apis:
      - binding: edge-management
        options: {}
      - binding: edge-client
        options: {}
      - binding: fabric
        options: {}

healthChecks:
  boltCheck:
    interval: 30s
    timeout: 20s
    initialDelay: 30s

# Logging
logLevel: {{ openziti_log_level }}
