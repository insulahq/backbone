# Nginx Proxy Configuration for PowerDNS ({{ inventory_hostname }})
# Exposes PowerDNS API on NetBird interface only — no public access

user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';

    access_log /var/log/nginx/access.log main;

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    types_hash_max_size 2048;

    # PowerDNS API (port 8081)
    server {
        listen 8081;
        listen [::]:8081;
        server_name _;

        location / {
            proxy_pass http://pdns:{{ powerdns_webserver_internal_port | default(8091) }};
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            # API-specific settings
            proxy_read_timeout 90;
            proxy_connect_timeout 90;
            proxy_send_timeout 90;

            # Allow large zone payloads
            client_max_body_size 100M;
        }

        # Health check endpoint
        location /api/v1/servers/localhost {
            proxy_pass http://pdns:{{ powerdns_webserver_internal_port | default(8091) }}/api/v1/servers/localhost;
            access_log off;
        }
    }

{% if powerdns_admin_enabled | bool %}
    # PowerDNS-Admin UI (port 8080)
    server {
        listen 8080;
        listen [::]:8080;
        server_name _;

        location / {
            proxy_pass http://pdns-admin:8000;
            # Use $http_host (preserves port) instead of $host (strips port).
            # PDA uses Flask url_for(_external=True) which reads the Host
            # header — without the port, generated URLs are incorrect.
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            # WebSocket support (if needed)
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";

            # Timeouts
            proxy_read_timeout 300;
            proxy_connect_timeout 300;
            proxy_send_timeout 300;

            # Allow large uploads
            client_max_body_size 50M;
        }

        # Static assets
        location /static/ {
            proxy_pass http://pdns-admin:8000/static/;
            expires 1d;
            add_header Cache-Control "public, immutable";
        }
    }
{% endif %}
}
