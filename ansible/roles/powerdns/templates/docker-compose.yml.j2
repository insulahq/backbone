---
# PowerDNS — Docker Compose ({{ inventory_hostname }})
# Runs PowerDNS authoritative server with PostgreSQL HA backend.
# Both ns1 and ns2 run this same stack — zone data replicates via PostgreSQL
# streaming replication (repmgr), NOT AXFR.
#
# The standalone PostgreSQL container is gone — PowerDNS connects to the
# shared postgresql_default Docker network where the HA cluster runs.

services:
  # PowerDNS Authoritative Server
  pdns:
    image: {{ powerdns_image }}
    container_name: powerdns-auth
    restart: unless-stopped
    hostname: {{ inventory_hostname }}.{{ platform_domain }}
    volumes:
      - {{ powerdns_install_dir }}/pdns.conf:/etc/powerdns/pdns.conf:ro
    ports:
      - "0.0.0.0:53:53/tcp"
      - "0.0.0.0:53:53/udp"
      - "[::]:53:53/tcp"
      - "[::]:53:53/udp"
    networks:
      - powerdns_internal
      - postgresql_default  # Connect to HA PostgreSQL cluster via Docker DNS
    healthcheck:
      test: ["CMD-SHELL", "pdns_control uptime > /dev/null 2>&1 || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 3
    logging:
      driver: "json-file"
      options:
        max-size: "100m"
        max-file: "2"

{% if powerdns_admin_enabled %}
  # PowerDNS-Admin — Web UI for managing PowerDNS ({{ powerdns_admin_node }} only)
  pdns-admin:
    image: {{ powerdns_admin_image }}
    container_name: powerdns-admin
    restart: unless-stopped
    depends_on:
      pdns:
        condition: service_started
    environment:
      SECRET_KEY: {{ powerdns_admin_secret_key }}
      BIND_ADDRESS: 0.0.0.0
      PORT: {{ powerdns_admin_port }}
      SQLA_DB_HOST: postgresql
      SQLA_DB_PORT: 5432
      SQLA_DB_NAME: {{ powerdns_admin_sqla_db_name }}
      SQLA_DB_USER: {{ powerdns_admin_sqla_db_user }}
      SQLA_DB_PASSWORD: {{ powerdns_admin_sqla_db_password }}
      PDNS_API_KEY: {{ powerdns_api_key }}
      PDNS_API_URL: http://pdns:{{ powerdns_webserver_port }}
      PDNS_VERSION: {{ powerdns_version }}
    volumes:
      - pdns_admin_data:/data
    networks:
      - powerdns_internal
      - postgresql_default  # For PowerDNS-Admin database
    logging:
      driver: "json-file"
      options:
        max-size: "100m"
        max-file: "2"
{% endif %}

  # Nginx Proxy — Exposes PowerDNS API + Admin UI on NetBird interface only
  nginx:
    image: {{ nginx_image }}
    container_name: powerdns-nginx
    restart: unless-stopped
    depends_on:
      - pdns
{% if powerdns_admin_enabled %}
      - pdns-admin
{% endif %}
    volumes:
      - {{ powerdns_install_dir }}/nginx.conf:/etc/nginx/nginx.conf:ro
    ports:
      - "{{ powerdns_bind_interface }}:{{ powerdns_nginx_api_port }}:8081"
{% if powerdns_admin_enabled %}
      - "{{ powerdns_bind_interface }}:{{ powerdns_nginx_admin_port }}:8080"
{% endif %}
    networks:
      - powerdns_internal
    healthcheck:
      test: ["CMD-SHELL", "wget -q --spider http://localhost:8081/api/v1/servers/localhost || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 3
    logging:
      driver: "json-file"
      options:
        max-size: "100m"
        max-file: "2"

networks:
  powerdns_internal:
    driver: bridge
  postgresql_default:
    external: true

{% if powerdns_admin_enabled %}
volumes:
  pdns_admin_data:
{% endif %}
