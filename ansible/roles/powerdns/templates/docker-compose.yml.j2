---
# PowerDNS — Docker Compose ({{ inventory_hostname }})
# Runs PowerDNS authoritative server with PostgreSQL HA backend.
# Both ns1 and ns2 run this same stack — zone data replicates via PostgreSQL
# streaming replication (repmgr), NOT AXFR.
#
# The standalone PostgreSQL container is gone — PowerDNS connects to the
# shared postgresql_default Docker network where the HA cluster runs.

services:
  # PowerDNS Authoritative Server
  pdns:
    image: {{ powerdns_image }}
    container_name: powerdns-auth
    restart: unless-stopped
    hostname: {{ inventory_hostname }}.{{ platform_domain }}
    # Docker bridge networking — LUA health checks are disabled (gotcha 130),
    # so host network is no longer needed. PG connection via pgproxy container.
    ports:
      # Bind to public + WireGuard IPs only (NOT 0.0.0.0 — conflicts with NetBird DNS on 100.x)
      - "{{ ansible_host }}:53:53/tcp"
      - "{{ ansible_host }}:53:53/udp"
      - "{{ wireguard_ip }}:53:53/tcp"
      - "{{ wireguard_ip }}:53:53/udp"
{% if public_ipv6 is defined %}
      - "[{{ public_ipv6 }}]:53:53/tcp"
      - "[{{ public_ipv6 }}]:53:53/udp"
{% endif %}
    networks:
      - powerdns_internal
      - postgresql_default  # For pgproxy access
    volumes:
      - {{ powerdns_install_dir }}/pdns.conf:/etc/powerdns/pdns.conf:ro
    deploy:
      resources:
        limits:
          memory: 512m
          cpus: "1.0"
    healthcheck:
      test: ["CMD-SHELL", "pdns_control uptime > /dev/null 2>&1 || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 3
    logging:
      driver: "json-file"
      options:
        max-size: "100m"
        max-file: "2"

{% if powerdns_admin_enabled | bool %}
  # PowerDNS-Admin — Web UI for managing PowerDNS
  pdns-admin:
    image: {{ powerdns_admin_image }}
    container_name: powerdns-admin
    restart: unless-stopped
    environment:
      SECRET_KEY: "{{ powerdns_admin_secret_key }}"
      BIND_ADDRESS: "0.0.0.0"
      PORT: "{{ powerdns_admin_port }}"
      # PDA connects to PG via pgproxy (always routes to current primary)
      SQLALCHEMY_DATABASE_URI: "postgresql://{{ powerdns_admin_sqla_db_user }}:{{ powerdns_admin_sqla_db_password }}@pgproxy:5432/{{ powerdns_admin_sqla_db_name }}"
      PDNS_API_KEY: "{{ powerdns_api_key }}"
      # PDNS is now on the same Docker network — use container name directly
      PDNS_API_URL: "http://pdns:{{ powerdns_webserver_internal_port | default(8091) }}"
      PDNS_VERSION: "{{ powerdns_version }}"
    volumes:
      - {{ powerdns_install_dir }}/admin-data:/data
    networks:
      - powerdns_internal
      - postgresql_default  # For PowerDNS-Admin database
    healthcheck:
      test: ["CMD-SHELL", "wget -q --spider http://127.0.0.1:8000/ || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s
    logging:
      driver: "json-file"
      options:
        max-size: "100m"
        max-file: "2"
{% endif %}

  # Nginx Proxy — Exposes PowerDNS API + Admin UI on NetBird interface only
  nginx:
    image: {{ nginx_image }}
    container_name: powerdns-nginx
    restart: unless-stopped
    volumes:
      - {{ powerdns_install_dir }}/nginx.conf:/etc/nginx/nginx.conf:ro
    # Bind to 0.0.0.0 — public access blocked by DOCKER-USER iptables chain
    # (nftables FORWARD rules are bypassed by Docker's iptables-nft NAT).
    ports:
      - "0.0.0.0:{{ powerdns_nginx_api_port }}:8081"
{% if powerdns_admin_enabled | bool %}
      - "0.0.0.0:{{ powerdns_nginx_admin_port }}:8080"
{% endif %}
    networks:
      - powerdns_internal
    healthcheck:
      test: ["CMD-SHELL", "wget -q --spider http://localhost:8081/ || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 3
    logging:
      driver: "json-file"
      options:
        max-size: "100m"
        max-file: "2"

networks:
  powerdns_internal:
    external: true
  postgresql_default:
    external: true

