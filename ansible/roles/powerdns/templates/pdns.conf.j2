# PowerDNS Authoritative Server Configuration
# PowerDNS 5.0 — Docker deployment on {{ inventory_hostname }}
# Backend: PostgreSQL HA cluster (shared between ns1 and ns2)
#
# Both nodes run as Native (read-write). Zone data replicates via
# PostgreSQL streaming replication, NOT AXFR/NOTIFY.

####################
# Server Settings
####################

# Server identity
server-id={{ inventory_hostname }}.{{ platform_domain }}
local-address=0.0.0.0, ::
local-port={{ powerdns_dns_port }}

# Native mode — both nodes can read and write zones.
# No primary/secondary distinction; replication happens at the database level.
primary=no
secondary=no

####################
# Zone Defaults
####################

# Default SOA content for new zones created via the API.
# Without this, PowerDNS uses 'a.misconfigured.dns.server.invalid' as primary NS.
# Format: <primary-ns> <hostmaster-email> <serial> <refresh> <retry> <expire> <minimum-ttl>
# Serial 0 triggers INCEPTION-INCREMENT on first edit when soa_edit_api is set.
default-soa-content=ns1.{{ platform_domain }}. hostmaster.{{ platform_domain }}. 0 10800 3600 604800 3600

####################
# API & Web Server
####################

api={{ 'yes' if powerdns_api_enabled else 'no' }}
api-key={{ powerdns_api_key }}

webserver={{ 'yes' if powerdns_webserver_enabled else 'no' }}
# Bind to 0.0.0.0 — PowerDNS runs with network_mode: host.
# Access restricted by webserver-allow-from (loopback + private ranges only).
# Nginx container reaches this via host.docker.internal (Docker bridge gateway).
webserver-address=0.0.0.0
webserver-port={{ powerdns_webserver_internal_port | default(8091) }}
webserver-allow-from=127.0.0.0/8,172.16.0.0/12,10.0.0.0/8,::1/128,fd00::/8,fe80::/10

####################
# Database Backend (PostgreSQL HA Cluster)
####################

launch=gpgsql

# Connect via pgproxy container (on postgresql_default network) which always
# routes to the current PG primary. After PG failover, the entrypoint-wrapper
# updates pgproxy-target and restarts the pgproxy container.
gpgsql-host=pgproxy
gpgsql-port=5432
gpgsql-dbname={{ powerdns_db_name }}
gpgsql-user={{ powerdns_db_user }}
gpgsql-password={{ powerdns_db_password }}

# DNSSEC support
gpgsql-dnssec={{ 'yes' if powerdns_dnssec_enabled else 'no' }}

####################
# Security & Performance
####################

# Security
security-poll-suffix=

# Cache settings
cache-ttl=20
negquery-cache-ttl=60
query-cache-ttl=20

####################
# Cache Limits
####################

# Bound cache memory usage
max-cache-entries={{ powerdns_max_cache_entries }}
max-packet-cache-entries={{ powerdns_max_packet_cache_entries }}

####################
# Logging
####################

log-dns-details={{ 'yes' if powerdns_log_level | int >= 6 else 'no' }}
log-dns-queries={{ 'yes' if powerdns_log_level | int >= 8 else 'no' }}
loglevel={{ powerdns_log_level }}

# Disable unnecessary logging
query-logging=no

####################
# LUA Records
####################

# Enables ifurlup()/ifportup() for health-checked DNS failover.
# LUA records check actual service health and exclude dead servers from responses.
enable-lua-records={{ 'yes' if powerdns_lua_records_enabled else 'no' }}
{% if powerdns_version is version('5.1', '>=') %}

# 5.1 blocks LUA-type record modifications via API/DNS-Update by default.
# platform-dns-switch sends a LUA DELETE changetype in every switch payload
# (cleanup of the pre-active-passive health-check records) — keep that
# working, otherwise failover DNS switching breaks.
enable-lua-record-updates=yes
{% endif %}
