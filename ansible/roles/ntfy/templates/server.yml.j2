# ntfy server configuration — {{ inventory_hostname }}
# Generated by Ansible — do not edit manually.
# Re-deploy: ansible-playbook -i inventory/hosts.yml deploy-ntfy.yml

base-url: "https://{{ ntfy_domain }}"
listen-http: ":{{ ntfy_port }}"

# Traefik terminates TLS in front of this; rate limiting and the ban feed must
# key on the forwarded client IP, not on Traefik's container address.
behind-proxy: true

# --- Storage --------------------------------------------------------------
# One DSN covers the message cache, auth/ACL and web-push subscriptions.
# cache-file / auth-file / web-push-file MUST NOT be set alongside this.
#
# Connects via pgproxy, which always routes to the current PG primary — the
# same indirection every other consumer uses (gotcha 119). Because ntfy is
# fenced to the primary, its pool can never be left pointing at a demoted,
# read-only node the way netbird's activity store was (gotcha 148).
database-url: "postgres://{{ ntfy_db_user }}:{{ postgresql_ntfy_password }}@pgproxy:5432/{{ ntfy_db_name }}?sslmode=disable&pool_max_conns={{ ntfy_db_pool_max_conns }}"

cache-duration: "{{ ntfy_cache_duration }}"

{% if not ntfy_attachments_enabled %}
# Attachments deliberately disabled: ntfy writes them to local disk or S3,
# never to the database, so they would not survive a failover to the peer.
{% else %}
attachment-cache-dir: "/var/cache/ntfy/attachments"
{% endif %}

# --- Authentication and access control ------------------------------------
# Setting database-url implicitly enables auth. Default to a closed server.
auth-default-access: "{{ ntfy_auth_default_access }}"
enable-signup: {{ ntfy_enable_signup | lower }}
enable-login: {{ ntfy_enable_login | lower }}

# deny-all covers the API; these cover the web app itself. Without
# require-login the SPA is served to anonymous visitors, who can add a topic
# in the UI and watch it silently receive nothing (every call 403s).
require-login: {{ ntfy_require_login | lower }}
web-root: "{{ ntfy_web_root }}"

# Users, ACL entries and tokens below are PROVISIONED: ntfy deletes any
# provisioned entry that disappears from this file on restart. This file is
# the source of truth — do not add users with `ntfy user add`, they will not
# survive a redeploy.
auth-users:
  - "{{ ntfy_admin_user }}:{{ ntfy_admin_password_hash }}:admin"
{% if ntfy_subscriber_enabled %}
  - "{{ ntfy_subscriber_user }}:{{ ntfy_subscriber_password_hash }}:user"
{% endif %}
{% for u in ntfy_extra_users %}
  - "{{ u }}"
{% endfor %}

{% if ntfy_subscriber_enabled or ntfy_extra_access | length > 0 %}
auth-access:
{% if ntfy_subscriber_enabled %}
  # Consumers (Windows Scheduled Task, phone, CLI) may READ the alert topic
  # and nothing else — a workstation must never be able to forge an alert.
  - "{{ ntfy_subscriber_user }}:{{ ntfy_alert_topic }}:read-only"
{% endif %}
{% for a in ntfy_extra_access %}
  - "{{ a }}"
{% endfor %}
{% endif %}

auth-tokens:
  - "{{ ntfy_publish_user }}:{{ ntfy_publish_token }}:platform alert publisher (Gatus)"
{% if ntfy_subscriber_enabled %}
  - "{{ ntfy_subscriber_user }}:{{ ntfy_subscriber_token }}:desktop/mobile subscriber (read-only)"
{% endif %}
{% for t in ntfy_extra_tokens %}
  - "{{ t }}"
{% endfor %}

{% if ntfy_web_push_enabled %}
# --- Web Push (browser) ---------------------------------------------------
# Subscriptions are stored in PostgreSQL alongside everything else.
# Web Push only works for topics on THIS server.
web-push-public-key: "{{ ntfy_web_push_public_key }}"
web-push-private-key: "{{ ntfy_web_push_private_key }}"
web-push-email-address: "{{ ntfy_web_push_email }}"
{% endif %}

{% if ntfy_upstream_base_url | length > 0 %}
# --- iOS wake-up relay ----------------------------------------------------
# Forwards a poll request containing only the message ID upstream so the
# stock iOS app can be woken via APNs. Message bodies stay on this server.
upstream-base-url: "{{ ntfy_upstream_base_url }}"
{% if ntfy_upstream_access_token | length > 0 %}
upstream-access-token: "{{ ntfy_upstream_access_token }}"
{% endif %}
{% endif %}

log-level: "{{ ntfy_log_level }}"
