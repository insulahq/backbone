# Platform DNS Switch — environment configuration
# Deployed to /etc/platform-dns-switch.env by the common Ansible role.
# Sourced by /usr/local/bin/platform-dns-switch and the PG entrypoint-wrapper.
PDNS_API_KEY="{{ powerdns_api_key | default('') }}"
PDNS_API_PORT="{{ powerdns_nginx_api_port | default('8081') }}"
PLATFORM_DOMAIN="{{ platform_domain }}"
LOCAL_PUBLIC_IP="{{ ansible_host }}"
PEER_PUBLIC_IP="{{ hostvars[groups['dns_servers'] | difference([inventory_hostname]) | first]['ansible_host'] }}"
{% if public_ipv6 is defined %}
LOCAL_PUBLIC_IPV6="{{ public_ipv6 }}"
{% endif %}
{% if hostvars[groups['dns_servers'] | difference([inventory_hostname]) | first]['public_ipv6'] is defined %}
PEER_PUBLIC_IPV6="{{ hostvars[groups['dns_servers'] | difference([inventory_hostname]) | first]['public_ipv6'] }}"
{% endif %}
