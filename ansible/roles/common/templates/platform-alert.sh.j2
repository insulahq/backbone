#!/bin/bash
# Hosting Platform — shared alert helper library.
# Deployed by Ansible (common role, updated by gatus role).
# Sourced by all maintenance scripts.
#
# Usage:
#   source /usr/local/lib/platform-alert.sh
#   platform_alert "critical" "backup" "Backup failed with exit code 1"
#   platform_alert "warning"  "disk"   "/ is 85% full (2.1G available)"
#   platform_alert "info"     "repmgr" "Standby promoted to primary"

PLATFORM_HOSTNAME="{{ inventory_hostname }}"
PLATFORM_WEBHOOK_URL="{{ alert_webhook_url }}"

# Gatus external endpoint configuration
# Set after gatus role deploys — empty until then (graceful fallback)
PLATFORM_GATUS_URL="http://127.0.0.1:{{ gatus_local_port | default('8080') }}"
PLATFORM_GATUS_TOKEN="{{ gatus_external_token | default('') }}"

# Send an alert via Gatus external endpoint and/or raw webhook.
# Args: $1=level (info|warning|critical), $2=service, $3=message
platform_alert() {
    local level="$1"
    local service="$2"
    local message="$3"
    local timestamp
    timestamp="$(date -Iseconds)"

    # Always log to stdout (captured by systemd journal)
    echo "[${timestamp}] ALERT ${level^^}: [${service}] ${message}"

    # Map level to Gatus success/failure
    local gatus_success="true"
    if [ "$level" = "warning" ] || [ "$level" = "critical" ]; then
        gatus_success="false"
    fi

    # Escape message for JSON
    local safe_msg
    safe_msg=$(printf '%s' "$message" | sed 's/\\/\\\\/g; s/"/\\"/g; s/\t/\\t/g' | tr '\n' ' ')

    # Push to local Gatus external endpoint (primary alert path)
    # Key format: {hostname}_{service} (matches Gatus config external-endpoints)
    if [ -n "$PLATFORM_GATUS_TOKEN" ]; then
        local gatus_key="${PLATFORM_HOSTNAME}_${service}"
        curl -fsS --retry 2 --max-time 5 -X POST \
            "${PLATFORM_GATUS_URL}/api/v1/endpoints/${gatus_key}/external" \
            -H "Authorization: Bearer ${PLATFORM_GATUS_TOKEN}" \
            -H "Content-Type: application/json" \
            -d "{\"success\": ${gatus_success}, \"errors\": [\"${safe_msg}\"]}" \
            > /dev/null 2>&1 || \
            echo "[${timestamp}] WARNING: Failed to push to Gatus (endpoint: ${gatus_key})"
    fi

    # Fallback: send to raw webhook if configured (for non-Gatus setups)
    if [ -n "$PLATFORM_WEBHOOK_URL" ]; then
        curl -fsS --retry 3 --max-time 10 -X POST \
            -H "Content-Type: application/json" \
            -d "{\"host\": \"${PLATFORM_HOSTNAME}\", \"service\": \"${service}\", \"level\": \"${level}\", \"message\": \"${safe_msg}\", \"timestamp\": \"${timestamp}\"}" \
            "$PLATFORM_WEBHOOK_URL" > /dev/null 2>&1 || \
            echo "[${timestamp}] WARNING: Failed to send webhook alert"
    fi
}
