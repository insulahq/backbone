#!/bin/bash
# DOCKER-USER chain rules — applied after Docker starts.
# Blocks internal-only ports from public-facing interfaces.
# Docker evaluates DOCKER-USER before its own ACCEPT rules.

iptables -N DOCKER-USER 2>/dev/null || true
iptables -F DOCKER-USER

# Allow VPN interfaces (WireGuard, NetBird, loopback)
iptables -A DOCKER-USER -i {{ wireguard_interface | default('wg0') }} -j RETURN
iptables -A DOCKER-USER -i wt0 -j RETURN
iptables -A DOCKER-USER -i lo -j RETURN

# Allow Docker bridge traffic to PowerDNS API only (post-promote DNS switch)
iptables -A DOCKER-USER -s 172.16.0.0/12 -p tcp --dport 8081 -j RETURN

# Block internal-only ports from all other (public) interfaces.
# After Docker DNAT, destination port is the CONTAINER port (not host port).
# Match both host and container ports to cover all mapping scenarios.
# Port 8081: PowerDNS API (host 8081 → container 8081)
iptables -A DOCKER-USER -p tcp --dport 8081 -j DROP
# Port 8180→8080: PowerDNS Admin (host 8180 → container 8080 via powerdns_internal bridge)
iptables -A DOCKER-USER -p tcp --dport 8180 -j DROP
iptables -A DOCKER-USER -p tcp --dport 8080 -j DROP
# OpenZiti: 8440 (controller fabric), 8441 (edge API) — WireGuard only
iptables -A DOCKER-USER -p tcp --dport 8440 -j DROP
iptables -A DOCKER-USER -p tcp --dport 8441 -j DROP
# Portainer: 9000 (UI), 8000 (edge agent tunnel), 9443 (HTTPS UI)
iptables -A DOCKER-USER -p tcp --dport 9000 -j DROP
iptables -A DOCKER-USER -p tcp --dport 8000 -j DROP
iptables -A DOCKER-USER -p tcp --dport 9443 -j DROP

# Allow everything else through
iptables -A DOCKER-USER -j RETURN
