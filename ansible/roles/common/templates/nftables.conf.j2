#!/usr/sbin/nft -f
# nftables firewall configuration
# Managed by Ansible. Do not edit manually.
# Host: {{ inventory_hostname }}.{{ platform_domain }}
#
# SSH brute-force protection via per-source-IP rate limiting (meter).
# fail2ban is not available on Debian 13 (trixie); ufw was removed.

flush ruleset

table inet filter {

    chain input {
        type filter hook input priority 0; policy drop;

        # Allow established and related connections
        ct state established,related accept

        # Drop invalid packets
        ct state invalid drop

        # Allow loopback
        iif lo accept

        # Allow ICMP (ping) — rate-limited to prevent flood
        ip protocol icmp limit rate 10/second accept
        ip6 nexthdr icmpv6 limit rate 10/second accept

        # SSH — admin IPs bypass rate limiting entirely
{% for ip in admin_ips %}
        tcp dport {{ ssh_port }} ip saddr {{ ip }} accept
{% endfor %}

        # SSH — per-source-IP rate limit: max 5 new connections per minute
        tcp dport {{ ssh_port }} ct state new \
            meter ssh_ratelimit { ip saddr limit rate 5/minute burst 5 packets } accept
        tcp dport {{ ssh_port }} ct state new drop
        tcp dport {{ ssh_port }} accept

        # DNS (UDP + TCP)
        udp dport 53 accept
        tcp dport 53 accept

        # WireGuard / NetBird data plane
        udp dport 51820 accept

{% if inventory_hostname in groups['dns_master'] %}
        # PowerDNS API — Docker binds to 0.0.0.0:{{ pdns_api_port }}; nftables restricts access
        # localhost: Management API on same host; wt0 from ns2: reconciliation cron + future Management API
        tcp dport {{ pdns_api_port }} ip saddr 127.0.0.1 accept
        tcp dport {{ pdns_api_port }} iifname "wt0" ip saddr {{ ns2_netbird_ip }} accept
        # Block everything else reaching the API port (public internet, other IPs)
        tcp dport {{ pdns_api_port }} drop

        # PowerDNS-Admin web UI — NetBird mesh only; Docker binds to 0.0.0.0, nftables restricts access
        tcp dport {{ pdns_admin_port }} iifname "wt0" accept
        # Block pdns-admin from public internet
        tcp dport {{ pdns_admin_port }} drop
{% endif %}

{% if inventory_hostname in groups['dns_slave'] %}
        # PowerDNS API — NetBird mesh only (DNAT'd from wt0 to 127.0.0.1:{{ pdns_api_port }})
        # Accessible to any NetBird peer (Management API, reconciliation cron on other slaves, etc.)
        tcp dport {{ pdns_api_port }} iifname "wt0" accept
{% endif %}

{% if inventory_hostname in groups['netbird_management'] %}
        # NetBird management server (HTTPS + HTTP for ACME)
        tcp dport 80 accept
        tcp dport 443 accept

        # STUN/TURN relay
        udp dport 3478 accept
        tcp dport 3478 accept
{% endif %}

        # Log and drop everything else
        log prefix "[nft-drop] " level warn
        drop
    }

    chain forward {
        type filter hook forward priority 0; policy drop;

        # Allow Docker container outbound traffic (container → internet)
        iifname "docker*" accept
        iifname "br-*" accept

        # Allow established/related forwarded traffic (return paths)
        ct state established,related accept

{% if inventory_hostname in groups['dns_master'] %}
        # dns_master exposes services via 0.0.0.0 bindings (pdns-admin, pdns API).
        # Without this restriction, Docker's kernel DNAT would forward public-internet
        # traffic to containers. Only allow external→container traffic from NetBird (wt0).
        iifname "wt0" oifname "br-*" accept
        iifname "lo"  oifname "br-*" accept
        oifname "br-*" drop
        oifname "docker*" accept
{% else %}
        # Allow Docker NAT outbound and inter-container (other hosts have no exposed ports)
        oifname "docker*" accept
        oifname "br-*" accept
{% endif %}
    }

    chain output {
        type filter hook output priority 0; policy accept;
    }
}

# NAT masquerade — required for Docker containers to reach the internet
table ip nat {
    chain postrouting {
        type nat hook postrouting priority 100;
        # Masquerade outbound traffic from Docker bridge networks
        ip saddr 172.16.0.0/12 masquerade
        ip saddr 192.168.0.0/16 masquerade
    }

{% if inventory_hostname in groups['dns_master'] or inventory_hostname in groups['dns_slave'] %}
    # DNAT: forward wt0 traffic arriving on NetBird to services bound to 127.0.0.1.
    # route_localnet=1 (set via sysctl) is required for DNAT-to-loopback to work on non-lo interfaces.
    chain prerouting {
        type nat hook prerouting priority -100;
{% if inventory_hostname in groups['dns_master'] %}
        # pdns-admin and PowerDNS API are both bound to 0.0.0.0 — no DNAT needed.
        # nftables input rules (above) restrict access to wt0/localhost only.
{% endif %}
{% if inventory_hostname in groups['dns_slave'] %}
        # PowerDNS API — bound to 127.0.0.1, reachable from any NetBird peer via DNAT
        iifname "wt0" tcp dport {{ pdns_api_port }} dnat to 127.0.0.1:{{ pdns_api_port }}
{% endif %}
    }
{% endif %}
}
