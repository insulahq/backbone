#!/bin/bash
# Docker cleanup script — removes unused images, containers, networks, build cache.
# Deployed by Ansible (common role). Runs weekly via systemd timer.
# Does NOT prune named volumes (those hold PostgreSQL data, etc.).

set -euo pipefail
source /usr/local/lib/platform-alert.sh

log() {
    echo "[$(date -Iseconds)] DOCKER-CLEANUP: $*"
}

# Alert on unexpected errors
trap 'platform_alert "critical" "Images-Up-to-Date" "Docker cleanup failed unexpectedly on line $LINENO"' ERR

log "Starting Docker cleanup"

# Remove stopped containers (older than 24h) — never one that compose manages.
# A stopped compose container is a desired state, not litter: the PG role
# watchdog keeps netbird-server/-proxy/-dashboard and ntfy stopped on the
# standby and netbird-fence stopped on the primary, then starts them with
# `docker start` on the next role change. Pruning them left nothing to start:
# a failover moved DNS to a node with no NetBird and no ntfy (gotcha 167).
CONTAINERS=$(docker container prune -f --filter "until=24h" --filter "label!=com.docker.compose.project" 2>&1)
log "Containers: $CONTAINERS"

# Remove dangling images (untagged, no container reference)
DANGLING=$(docker image prune -f 2>&1)
log "Dangling images: $DANGLING"

# Remove unused images not referenced by any container (older than 7 days)
# This catches old pinned versions after an upgrade
UNUSED=$(docker image prune -af --filter "until={{ docker_cleanup_image_age }}" 2>&1)
log "Unused images: $UNUSED"

# Remove unused networks (not attached to any running container) — again not a
# compose one: a fenced container's network has no running member, and
# `docker start` fails on a container whose network is gone.
NETWORKS=$(docker network prune -f --filter "label!=com.docker.compose.project" 2>&1)
log "Networks: $NETWORKS"

# Remove build cache older than 7 days
BUILDCACHE=$(docker builder prune -f --filter "until={{ docker_cleanup_image_age }}" 2>&1)
log "Build cache: $BUILDCACHE"

# Report final disk usage
log "Current Docker disk usage:"
docker system df 2>&1

log "Docker cleanup completed"

# Post success to Gatus so the shared Images-Up-to-Date endpoint stays CONNECTED
# between image-monitor runs. Without this, a single ERR-trap failure in history
# leaves the endpoint stuck red (same bug class as pg-maintenance fix).
platform_alert "info" "Images-Up-to-Date" "Docker cleanup completed on {{ inventory_hostname }}"
