#!/usr/bin/env bash
# pdns-reconcile-zones.sh
# Managed by Ansible. Do not edit manually.
#
# Runs on every PowerDNS secondary. Compares the local zone list against
# the primary (ns1) REST API and deletes any zone that is present locally
# but absent on the primary. Provides eventual consistency for zone deletion,
# since the DNS protocol has no "delete zone" NOTIFY.
#
# Scheduled via /etc/cron.d/pdns-reconcile (every 5 minutes).
# Logs to syslog — view with: journalctl -t pdns-reconcile

set -euo pipefail

NS1_API="http://{{ ns1_netbird_ip }}:{{ pdns_api_port }}/api/v1"
LOCAL_API="http://127.0.0.1:{{ pdns_api_port }}/api/v1"
API_KEY="{{ pdns_api_key }}"
TAG="pdns-reconcile"

log() { logger -t "$TAG" -- "$*"; }
die() { log "ERROR: $*"; exit 1; }

parse_zone_ids() {
    python3 -c "
import sys, json
data = json.loads(sys.stdin.read())
for z in data:
    print(z['id'].rstrip('.'))
"
}

# ---------------------------------------------------------------------------
# 1. Fetch zone list from ns1 (primary) via NetBird WireGuard tunnel
# ---------------------------------------------------------------------------
ns1_raw=$(curl -sf --max-time 10 \
    -H "X-API-Key: $API_KEY" \
    "$NS1_API/servers/localhost/zones" 2>/dev/null) \
  || die "Failed to query ns1 API at $NS1_API — skipping to avoid false deletions"

ns1_zones=$(parse_zone_ids <<< "$ns1_raw") \
  || die "Failed to parse ns1 API response"

if [[ -z "$ns1_zones" ]]; then
    die "ns1 returned empty zone list — refusing to act (safety guard)"
fi

# ---------------------------------------------------------------------------
# 2. Fetch zone list from local secondary REST API
# ---------------------------------------------------------------------------
local_raw=$(curl -sf --max-time 10 \
    -H "X-API-Key: $API_KEY" \
    "$LOCAL_API/servers/localhost/zones" 2>/dev/null) \
  || die "Failed to query local API at $LOCAL_API"

local_zones=$(parse_zone_ids <<< "$local_raw") \
  || die "Failed to parse local API response"

# ---------------------------------------------------------------------------
# 3. Delete any local zone absent from ns1
# ---------------------------------------------------------------------------
deleted=0
while IFS= read -r zone; do
    [[ -z "$zone" ]] && continue

    if ! grep -qxF "$zone" <<< "$ns1_zones"; then
        log "Deleting orphan zone: $zone"
        http_status=$(curl -sf --max-time 10 -o /dev/null -w "%{http_code}" \
            -X DELETE \
            -H "X-API-Key: $API_KEY" \
            "$LOCAL_API/servers/localhost/zones/${zone}." 2>/dev/null) || true

        if [[ "$http_status" == "204" ]]; then
            log "Deleted: $zone"
            (( deleted++ )) || true
        else
            log "ERROR: DELETE $zone returned HTTP $http_status"
        fi
    fi
done <<< "$local_zones"

(( deleted > 0 )) && log "Done — $deleted orphan zone(s) deleted"

exit 0
