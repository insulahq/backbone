# Nginx Proxy Configuration for PowerDNS Secondary (NS2)
# Exposes PowerDNS API on NetBird interface only — no public access
# No PowerDNS-Admin UI on secondary (read-only secondary, API for zone management only)

user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent"';

    access_log /var/log/nginx/access.log main;

    sendfile on;
    keepalive_timeout 65;

    # PowerDNS API (port 8081) — NetBird access only
    server {
        listen 8081;
        server_name _;

        location / {
            proxy_pass http://pdns:{{ powerdns_webserver_port }};
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            proxy_read_timeout 90;
            proxy_connect_timeout 90;
            proxy_send_timeout 90;

            # Allow zone data payloads
            client_max_body_size 10M;
        }

        # Health check endpoint
        location /api/v1/servers/localhost {
            proxy_pass http://pdns:{{ powerdns_webserver_port }}/api/v1/servers/localhost;
            access_log off;
        }
    }
}
