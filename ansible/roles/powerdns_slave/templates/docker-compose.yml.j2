---
# PowerDNS Slave — Docker Compose
# Runs on ns2 as secondary DNS server with SQLite backend
# Receives zone transfers from ns1 via NetBird mesh (AXFR/NOTIFY)
# API exposed on NetBird IP via nginx proxy (Management API needs it for zone deletion)

version: '3.8'

services:
  # PowerDNS Authoritative Server (Secondary)
  pdns:
    image: {{ powerdns_image }}
    container_name: powerdns-slave
    restart: unless-stopped
    hostname: ns2.{{ platform_domain }}
    volumes:
      - {{ powerdns_install_dir }}/pdns.conf:/etc/powerdns/pdns.conf:ro
      - pdns_data:/var/lib/powerdns
    ports:
      - "0.0.0.0:53:53/tcp"
      - "0.0.0.0:53:53/udp"
    networks:
      - powerdns_internal
    healthcheck:
      test: ["CMD-SHELL", "pdns_control uptime > /dev/null 2>&1 || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 3

  # Nginx Proxy — Exposes PowerDNS API on NetBird interface only
  # Mirrors the NS1 pattern. Public internet cannot reach port 8081.
  nginx:
    image: nginx:alpine
    container_name: powerdns-nginx
    restart: unless-stopped
    depends_on:
      - pdns
    volumes:
      - {{ powerdns_install_dir }}/nginx.conf:/etc/nginx/nginx.conf:ro
    ports:
      - "{{ powerdns_bind_interface }}:{{ powerdns_nginx_api_port }}:8081"
    networks:
      - powerdns_internal
      - powerdns_external  # Needed for host port binding on NetBird IP
    healthcheck:
      test: ["CMD-SHELL", "wget -q --spider http://localhost:8081/api/v1/servers/localhost || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 3

networks:
  powerdns_internal:
    driver: bridge
    internal: false  # Must allow outbound to ns1 NetBird IP for AXFR
  powerdns_external:
    driver: bridge   # Non-internal network for nginx host port binding

volumes:
  pdns_data:
