# PowerDNS Secondary — Docker Compose stack
# Managed by Ansible. Do not edit manually.
# Host: {{ inventory_hostname }}.{{ platform_domain }} (ns2 — Helsinki)

services:

  # PowerDNS authoritative secondary (SQLite backend — no separate DB container needed)
  # network_mode: host — preserves source IPs for NOTIFY/AXFR (avoids Docker bridge masquerade
  # via NetBird postrouting rules which would rewrite src 100.76.182.198 → 172.18.0.1 inside
  # the container). Host networking means port 53 is bound directly on the host; no docker-proxy,
  # no NAT, no masquerade — allow-notify-from=ns1_netbird_ip works as expected.
  pdns:
    image: powerdns/pdns-auth-49:latest
    restart: unless-stopped
    network_mode: host
    user: root
    volumes:
      - ./pdns.conf:/etc/powerdns/pdns.conf:ro
      - pdns_sqlite:/var/lib/powerdns

volumes:
  pdns_sqlite:
    driver: local
