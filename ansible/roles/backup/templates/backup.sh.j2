#!/bin/bash
# Managed by Ansible. Do not edit manually.
# Restic backup script for {{ inventory_hostname }}.{{ platform_domain }}
# Run manually: /usr/local/bin/restic-backup.sh
# Or via systemd: systemctl start restic-backup.service

set -euo pipefail

source /etc/restic/env

HOSTNAME="{{ inventory_hostname }}"
TIMESTAMP="$(date +%Y-%m-%dT%H:%M:%S)"

log()  { echo "[restic-backup ${HOSTNAME} ${TIMESTAMP}] $*"; }
fail() { log "ERROR: $*"; exit 1; }

log "=== Backup started ==="

{% if inventory_hostname in groups['dns_master'] %}
# -----------------------------------------------------------------------
# PostgreSQL — PowerDNS primary database
# Pipe pg_dumpall directly into restic; no temp file on disk.
# -----------------------------------------------------------------------
log "Dumping PostgreSQL (powerdns)..."
docker exec -u postgres powerdns-postgres-1 pg_dumpall -U {{ pdns_db_user }} \
  | restic backup \
      --stdin \
      --stdin-filename "postgres-dumpall.sql" \
      --tag postgres \
      --tag "{{ inventory_hostname }}" \
  || fail "PostgreSQL dump failed"
log "PostgreSQL dump done."

# -----------------------------------------------------------------------
# NetBird SQLite — pause container briefly for a consistent snapshot
# -----------------------------------------------------------------------
log "Pausing NetBird server for SQLite snapshot..."
docker pause netbird-server 2>/dev/null || true
restic backup \
  --tag netbird \
  --tag "{{ inventory_hostname }}" \
  --exclude "*.lock" \
  "/var/lib/docker/volumes/netbird_netbird_data/_data" \
  || { docker unpause netbird-server 2>/dev/null || true; fail "NetBird data backup failed"; }
docker unpause netbird-server 2>/dev/null || true
log "NetBird data backed up."

# -----------------------------------------------------------------------
# Let's Encrypt certificates (Traefik acme.json)
# -----------------------------------------------------------------------
log "Backing up Traefik Let's Encrypt certs..."
restic backup \
  --tag letsencrypt \
  --tag "{{ inventory_hostname }}" \
  "/var/lib/docker/volumes/netbird_netbird_letsencrypt/_data" \
  || fail "Letsencrypt backup failed"
log "Letsencrypt backed up."

{% endif %}
{% if inventory_hostname in groups['dns_slave'] %}
# -----------------------------------------------------------------------
# PowerDNS SQLite — secondary nameserver zone cache
# Pause pdns container briefly for consistency.
# -----------------------------------------------------------------------
log "Pausing PowerDNS for SQLite snapshot..."
docker pause powerdns-pdns-1 2>/dev/null || true
restic backup \
  --tag pdns-sqlite \
  --tag "{{ inventory_hostname }}" \
  "/var/lib/docker/volumes/powerdns_pdns_sqlite/_data" \
  || { docker unpause powerdns-pdns-1 2>/dev/null || true; fail "PowerDNS SQLite backup failed"; }
docker unpause powerdns-pdns-1 2>/dev/null || true
log "PowerDNS SQLite backed up."

{% endif %}
{% if inventory_hostname in groups['management_api'] %}
# -----------------------------------------------------------------------
# MariaDB — management API database
# Pipe mysqldump directly into restic; no temp file on disk.
# MYSQL_PWD avoids the password appearing in the process list.
# -----------------------------------------------------------------------
log "Dumping MariaDB ({{ management_api_db_name }})..."
docker exec \
  -e MYSQL_PWD="{{ management_api_db_root_password }}" \
  management-api-mariadb-1 \
  mysqldump -u root --all-databases --single-transaction \
  | restic backup \
      --stdin \
      --stdin-filename "mariadb-dumpall.sql" \
      --tag mariadb \
      --tag "{{ inventory_hostname }}" \
  || fail "MariaDB dump failed"
log "MariaDB dump done."

{% endif %}
# -----------------------------------------------------------------------
# Config files — /opt/* directories managed by Ansible
# Small but useful for quick reference after disaster recovery.
# -----------------------------------------------------------------------
log "Backing up config files..."
restic backup \
  --tag configs \
  --tag "{{ inventory_hostname }}" \
  --exclude "*.key" \
  --exclude "*.pem" \
{% if inventory_hostname in groups['dns_master'] %}
  /opt/powerdns \
  /opt/netbird \
{% endif %}
{% if inventory_hostname in groups['dns_slave'] %}
  /opt/powerdns \
{% endif %}
{% if inventory_hostname in groups['management_api'] %}
  /opt/management-api \
{% endif %}
  || fail "Config backup failed"
log "Config files backed up."

# -----------------------------------------------------------------------
# Prune — enforce 14-day retention
# -----------------------------------------------------------------------
log "Pruning snapshots (keep-daily={{ backup_retention_days }})..."
restic forget \
  --prune \
  --keep-daily {{ backup_retention_days }} \
  --group-by "host,paths" \
  || fail "Prune failed"
log "Prune done."

log "=== Backup complete ==="
