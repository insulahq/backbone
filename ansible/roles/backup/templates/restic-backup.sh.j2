#!/bin/bash
# Restic Backup Script for {{ inventory_hostname }}
# Backs up critical data to SFTP backup server

set -euo pipefail
source /usr/local/lib/platform-alert.sh

# Configuration
export RESTIC_REPOSITORY="{{ restic_repository }}"
export RESTIC_PASSWORD_FILE="{{ restic_config_dir }}/password"
export RESTIC_CACHE_DIR="{{ restic_cache_dir }}"

{% if backup_backend == 's3' %}
# S3 backend — load credentials from environment file
set -a; source {{ restic_config_dir }}/s3.env; set +a
RESTIC_OPTS=()
{% else %}
# SFTP backend — use sftp.command for full control over SSH port/keys.
# Bypasses NetBird ProxyCommand interception (-F /dev/null).
SFTP_CMD="ssh -F /dev/null -p {{ backup_sftp_port }} -oBatchMode=yes -oStrictHostKeyChecking=yes -oUserKnownHostsFile={{ restic_config_dir }}/known_hosts -i {{ restic_ssh_key_path }} {{ backup_sftp_user }}@{{ backup_sftp_host }} -s sftp"
RESTIC_OPTS=("-o" "sftp.command=${SFTP_CMD}")
{% endif %}

# Logging
LOG_FILE="/var/log/restic/backup-{{ inventory_hostname }}.log"
mkdir -p "$(dirname "$LOG_FILE")"

log() {
    echo "[$(date -Iseconds)] $*" | tee -a "$LOG_FILE"
}

error() {
    echo "[$(date -Iseconds)] ERROR: $*" | tee -a "$LOG_FILE" >&2
}

# Failure notification function
notify_failure() {
    local msg="$1"
    error "$msg"
    platform_alert "critical" "Backup OK" "Backup FAILED on {{ inventory_hostname }}: $msg"
{% if restic_healthcheck_url %}
    curl -fsS --retry 3 "{{ restic_healthcheck_url }}/fail" > /dev/null 2>&1 || true
{% endif %}
{% if restic_notify_on_failure and restic_notify_email %}
    if command -v mail &> /dev/null; then
        echo "Backup FAILED on {{ inventory_hostname }} at $(date -Iseconds): $msg" | \
            mail -s "[Hosting Platform] Backup FAILED on {{ inventory_hostname }}" "{{ restic_notify_email }}"
    fi
{% endif %}
}

# Trap unexpected errors
trap 'notify_failure "Unexpected error on line $LINENO"' ERR

# Health check ping (start)
{% if restic_healthcheck_url %}
curl -fsS --retry 3 "{{ restic_healthcheck_url }}/start" > /dev/null 2>&1 || true
{% endif %}

log "Starting backup for {{ inventory_hostname }}"

# PostgreSQL dump — pipe directly to restic (no plaintext staging on disk)
{% if restic_pgdump_enabled %}
if docker ps --format '{% raw %}{{.Names}}{% endraw %}' | grep -q '^postgresql$'; then
    log "Dumping all PostgreSQL databases (streaming to restic)"
    if docker exec postgresql pg_dumpall -U postgres 2>>"$LOG_FILE" | \
        restic "${RESTIC_OPTS[@]}" backup --stdin --stdin-filename "pg_dumpall.sql" \
        --tag pgdump --tag "{{ inventory_hostname }}" 2>>"$LOG_FILE"; then
        log "PostgreSQL dump backed up successfully"
    else
        error "pg_dumpall or restic stdin backup failed — continuing with file backup"
    fi
else
    log "PostgreSQL container not running — skipping database dump"
fi
{% endif %}

# Pre-backup hook
{% if restic_pre_backup_hook %}
log "Running pre-backup hook"
{{ restic_pre_backup_hook }} || {
    error "Pre-backup hook failed"
    exit 1
}
{% endif %}

# Check if repository exists, initialize if not
if ! restic "${RESTIC_OPTS[@]}" snapshots > /dev/null 2>&1; then
    log "Repository not found, initializing"
    restic "${RESTIC_OPTS[@]}" init || {
        error "Failed to initialize repository"
        exit 1
    }
fi

# Create backup
log "Creating backup snapshot"
{% if restic_backup_paths | length > 0 %}
restic "${RESTIC_OPTS[@]}" backup \
{% for path in restic_backup_paths %}
    "{{ path }}" \
{% endfor %}
{% for pattern in restic_exclude_patterns %}
    --exclude "{{ pattern }}" \
{% endfor %}
    --host "{{ inventory_hostname }}" \
    --tag "{{ inventory_hostname }}" \
    --tag "$(date +%Y-%m-%d)" \
    --verbose 2>&1 | tee -a "$LOG_FILE"

BACKUP_EXIT_CODE=${PIPESTATUS[0]}

if [ $BACKUP_EXIT_CODE -ne 0 ]; then
    notify_failure "Backup failed with exit code $BACKUP_EXIT_CODE"
    exit $BACKUP_EXIT_CODE
fi
{% else %}
log "No backup paths configured for {{ inventory_hostname }}"
{% endif %}

# Forget old snapshots according to retention policy
log "Applying retention policy"
restic "${RESTIC_OPTS[@]}" forget \
    --host "{{ inventory_hostname }}" \
    --keep-daily {{ restic_keep_daily }} \
    --keep-weekly {{ restic_keep_weekly }} \
    --keep-monthly {{ restic_keep_monthly }} \
    --keep-yearly {{ restic_keep_yearly }} \
    --prune \
    --verbose 2>&1 | tee -a "$LOG_FILE"

# Verify repository integrity (weekly only)
if [ "$(date +%u)" -eq 7 ]; then
    log "Running weekly repository check"
    restic "${RESTIC_OPTS[@]}" check --read-data-subset=5% 2>&1 | tee -a "$LOG_FILE"

    # Clean up stale Restic cache entries (prevents unbounded cache growth)
    log "Cleaning up Restic cache"
    restic "${RESTIC_OPTS[@]}" cache --cleanup 2>&1 | tee -a "$LOG_FILE" || {
        log "WARNING: Restic cache cleanup failed (non-fatal)"
    }
fi

# Post-backup hook
{% if restic_post_backup_hook %}
log "Running post-backup hook"
{{ restic_post_backup_hook }} || {
    error "Post-backup hook failed (backup succeeded)"
}
{% endif %}

# Get backup statistics
SNAPSHOT_COUNT=$(restic "${RESTIC_OPTS[@]}" snapshots --host "{{ inventory_hostname }}" --json | jq length)
REPO_SIZE=$(restic "${RESTIC_OPTS[@]}" stats --host "{{ inventory_hostname }}" --json | jq -r '.total_size')

log "Backup completed successfully"
log "Snapshots for {{ inventory_hostname }}: $SNAPSHOT_COUNT"
log "Repository size: $REPO_SIZE bytes"

# Report success to Gatus dashboard
platform_alert "info" "Backup OK" "Backup completed: $SNAPSHOT_COUNT snapshots, $REPO_SIZE bytes"

# Health check ping (success)
{% if restic_healthcheck_url %}
curl -fsS --retry 3 "{{ restic_healthcheck_url }}" > /dev/null 2>&1 || true
{% endif %}

exit 0
