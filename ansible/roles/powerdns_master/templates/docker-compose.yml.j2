# PowerDNS Primary — Docker Compose stack
# Managed by Ansible. Do not edit manually.
# Host: {{ inventory_hostname }}.{{ platform_domain }} (ns1 — Falkenstein)

services:

  # PostgreSQL backend — data persisted on named volume for easy backup
  postgres:
    image: postgres:16-alpine
    restart: unless-stopped
    environment:
      POSTGRES_DB: "{{ pdns_db_name }}"
      POSTGRES_USER: "{{ pdns_db_user }}"
      POSTGRES_PASSWORD: "{{ pdns_db_password }}"
    volumes:
      - pdns_pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ pdns_db_user }} -d {{ pdns_db_name }}"]
      interval: 5s
      timeout: 5s
      retries: 10

  # PowerDNS authoritative primary
  pdns:
    image: powerdns/pdns-auth-49:latest
    restart: unless-stopped
    depends_on:
      postgres:
        condition: service_healthy
    ports:
      - "0.0.0.0:53:53/udp"
      - "0.0.0.0:53:53/tcp"
      - "0.0.0.0:{{ pdns_api_port }}:8081"   # API — nftables restricts to 127.0.0.1 + ns2 NetBird IP
    volumes:
      - ./pdns.conf:/etc/powerdns/pdns.conf:ro
    environment:
      PDNS_AUTH_API_KEY: "{{ pdns_api_key }}"

  # PowerDNS-Admin — web UI, accessible over NetBird mesh only
  pdns-admin:
    image: powerdnsadmin/pda-legacy:latest
    restart: unless-stopped
    depends_on:
      postgres:
        condition: service_healthy
      pdns:
        condition: service_started
    ports:
      - "0.0.0.0:{{ pdns_admin_port }}:80"   # nftables restricts to wt0 (NetBird) only
    environment:
      SECRET_KEY: "{{ pdns_admin_secret_key }}"
      SQLALCHEMY_DATABASE_URI: >-
        postgresql://{{ pdns_db_user }}:{{ pdns_db_password }}@postgres/{{ pdns_db_name }}_admin
      # PowerDNS API connection — uses internal Docker network name 'pdns'
      PDNS_API_URL: "http://pdns:8081"
      PDNS_API_KEY: "{{ pdns_api_key }}"
      PDNS_VERSION: "4.9"
      GUNICORN_TIMEOUT: "60"
      GUNICORN_WORKERS: "2"
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

volumes:
  pdns_pgdata:
    driver: local
