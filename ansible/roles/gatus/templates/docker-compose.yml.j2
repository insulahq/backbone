---
# Gatus Monitoring — Docker Compose ({{ inventory_hostname }})
# HA status dashboard and alert receiver behind Traefik.
# Connects to PostgreSQL HA cluster via Docker network.
# Both ns1 and ns2 run Gatus — shared database via PostgreSQL replication.

services:
  gatus:
    image: {{ gatus_image }}
    container_name: gatus
    restart: unless-stopped
    ports:
      # Localhost binding for host-side scripts (platform-alert.sh)
      # Not publicly accessible — Traefik handles public TLS access
      - "127.0.0.1:{{ gatus_local_port }}:{{ gatus_port }}"
    networks:
      - traefik_public
      # Connect to postgresql_default so Gatus can reach PostgreSQL via Docker DNS
      - postgresql_default
    volumes:
      - {{ gatus_install_dir }}/config.yaml:/config/config.yaml:ro
    labels:
      - traefik.enable=true
      - traefik.http.routers.gatus.rule=Host(`{{ gatus_domain }}`)
      - traefik.http.routers.gatus.entrypoints=websecure
      - traefik.http.routers.gatus.tls=true
      - traefik.http.routers.gatus.service=gatus
      - traefik.http.services.gatus.loadbalancer.server.port={{ gatus_port }}
    healthcheck:
      test: ["CMD", "wget", "-q", "--spider", "http://localhost:{{ gatus_port }}/health"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 15s
    logging:
      driver: "json-file"
      options:
        max-size: "100m"
        max-file: "2"

networks:
  traefik_public:
    external: true
  postgresql_default:
    external: true
