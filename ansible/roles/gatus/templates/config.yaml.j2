# Gatus Monitoring Configuration — {{ inventory_hostname }}
# Generated by Ansible — do not edit manually.
# To add notification targets, set variables in group_vars/all.yml
# and re-deploy: ansible-playbook -i inventory/hosts.yml deploy-gatus.yml

storage:
  type: postgres
  # Gatus uses lib/pq which doesn't support multi-host DSN (gotcha 119).
  # Connects via pgproxy which always routes to the current PG primary.
  # After failover, the PG entrypoint-wrapper updates pgproxy and restarts Gatus.
  path: "postgres://{{ gatus_db_user }}:{{ postgresql_gatus_password }}@pgproxy:5432/{{ gatus_db_name }}?sslmode=disable"

ui:
  title: "Hosting Platform"
  header: "Infrastructure Status"

# ============================================================================
# Notification targets
# ============================================================================
# Configure in group_vars/all.yml via gatus_alerting_* variables.
# Each provider uses default-alert which auto-applies to ALL endpoints.
# Re-deploy after changing: ansible-playbook -i inventory/hosts.yml deploy-gatus.yml
alerting:
{% if gatus_alerting_slack_webhook %}
  slack:
    webhook-url: "{{ gatus_alerting_slack_webhook }}"
    default-alert:
      enabled: true
      failure-threshold: 1
      success-threshold: 2
      send-on-resolved: true
{% endif %}
{% if gatus_alerting_discord_webhook %}
  discord:
    webhook-url: "{{ gatus_alerting_discord_webhook }}"
    default-alert:
      enabled: true
      failure-threshold: 1
      success-threshold: 2
      send-on-resolved: true
{% endif %}
{% if gatus_alerting_ntfy_url and gatus_alerting_ntfy_topic %}
  ntfy:
    url: "{{ gatus_alerting_ntfy_url }}"
    topic: "{{ gatus_alerting_ntfy_topic }}"
{% if gatus_alerting_ntfy_token %}
    # Required against the self-hosted server, which runs auth-default-access:
    # deny-all. Gatus validates the "tk_" prefix and sends it as a bearer token.
    token: "{{ gatus_alerting_ntfy_token }}"
{% endif %}
    priority: {{ gatus_alerting_ntfy_priority | default(4) }}
    default-alert:
      enabled: true
      failure-threshold: 1
      success-threshold: 2
      send-on-resolved: true
{% endif %}
{% if gatus_alerting_email_host %}
  email:
    host: "{{ gatus_alerting_email_host }}"
    port: {{ gatus_alerting_email_port }}
    username: "{{ gatus_alerting_email_username }}"
    password: "{{ gatus_alerting_email_password }}"
    from: "{{ gatus_alerting_email_from }}"
    to: "{{ gatus_alerting_email_to }}"
    default-alert:
      enabled: true
      failure-threshold: 1
      success-threshold: 2
      send-on-resolved: true
{% endif %}
{% if gatus_alerting_telegram_token and gatus_alerting_telegram_id %}
  telegram:
    token: "{{ gatus_alerting_telegram_token }}"
    id: "{{ gatus_alerting_telegram_id }}"
    default-alert:
      enabled: true
      failure-threshold: 1
      success-threshold: 2
      send-on-resolved: true
{% endif %}
{% if gatus_alerting_pagerduty_integration_key %}
  pagerduty:
    integration-key: "{{ gatus_alerting_pagerduty_integration_key }}"
    default-alert:
      enabled: true
      failure-threshold: 1
      success-threshold: 2
      send-on-resolved: true
{% endif %}
{% if gatus_alerting_custom_url %}
  custom:
    url: "{{ gatus_alerting_custom_url }}"
    method: POST
    body: |
      {
        "title": "[ALERT_TRIGGERED_OR_RESOLVED] - [ENDPOINT_GROUP]/[ENDPOINT_NAME]",
        "description": "[RESULT_ERRORS]"
      }
    default-alert:
      enabled: true
      failure-threshold: 1
      success-threshold: 2
      send-on-resolved: true
{% endif %}

# ============================================================================
# External endpoints — receive pushes from infrastructure scripts
# ============================================================================
# platform-alert.sh and entrypoint-wrapper.sh push status updates here.
# Key format: {group}_{name} (e.g., ns1_Backup-OK, ns2_Disk-Below-80-Percent)
# Alerts auto-applied from alerting providers with default-alert enabled.
external-endpoints:
{% for host in groups['dns_servers'] %}
{% set is_preferred_primary = (host == (postgresql_primary_node | default('ns1'))) %}
  - name: Backup-OK
    group: {{ host }}
    token: "{{ gatus_external_token }}"
    conditions:
      - "[CONNECTED] == true"
  - name: Disk-Below-{{ disk_monitor_warn_percent }}-Percent
    group: {{ host }}
    token: "{{ gatus_external_token }}"
    conditions:
      - "[CONNECTED] == true"
  - name: Images-Up-to-Date
    group: {{ host }}
    token: "{{ gatus_external_token }}"
    conditions:
      - "[CONNECTED] == true"
  - name: PG-Maintenance-OK
    group: {{ host }}
    token: "{{ gatus_external_token }}"
    conditions:
      - "[CONNECTED] == true"
  - name: Repmgr-Healthy
    group: {{ host }}
    token: "{{ gatus_external_token }}"
    conditions:
      - "[CONNECTED] == true"
  - name: {{ 'Role-Primary' if is_preferred_primary else 'Role-Standby' }}
    group: {{ host }}
    token: "{{ gatus_external_token }}"
    conditions:
      - "[CONNECTED] == true"
  - name: PG-Writable
    group: {{ host }}
    token: "{{ gatus_external_token }}"
    conditions:
      - "[CONNECTED] == true"
  # Pushed every watchdog cycle: the standby reports its own WAL receiver, the
  # primary reports whether a standby streams from it (gotcha 151). Without
  # this entry every push 404s and the alert only ever reached the journal.
  - name: PG-Standby-Streaming
    group: {{ host }}
    token: "{{ gatus_external_token }}"
    conditions:
      - "[CONNECTED] == true"
  - name: NetBird-Mesh-Peers-Healthy
    group: {{ host }}
    token: "{{ gatus_external_token }}"
    conditions:
      - "[CONNECTED] == true"
{% endfor %}

# ============================================================================
# Active monitoring — Gatus probes these endpoints directly
# ============================================================================
endpoints:
{% for host in groups['dns_servers'] %}
  - name: "DNS Resolution"
    group: {{ host }}
    url: "{{ hostvars[host]['ansible_host'] }}"
    dns:
      query-name: "{{ platform_domain }}"
      query-type: A
    conditions:
      - "[DNS_RCODE] == NOERROR"
    interval: 2m
{% endfor %}
  - name: "HTTPS and TLS Certificate"
    group: platform
    url: "https://{{ platform_domain }}"
    client:
      insecure: true
    conditions:
      - "[STATUS] < 500"
      - "[CERTIFICATE_EXPIRATION] > 720h"
    interval: 2m
{% if zitadel_domain is defined %}
  - name: "Zitadel IAM Ready"
    group: platform
    url: "https://{{ zitadel_domain }}/debug/ready"
    client:
      insecure: true
    conditions:
      - "[STATUS] == 200"
      - "[CERTIFICATE_EXPIRATION] > 720h"
    interval: 2m
{% endif %}
{% if netbird_dashboard_domain is defined %}
  - name: "NetBird VPN Mesh"
    group: platform
    url: "https://{{ netbird_dashboard_domain }}"
    client:
      insecure: true
    conditions:
      - "[STATUS] < 500"
      - "[CERTIFICATE_EXPIRATION] > 720h"
    interval: 2m
{% endif %}
{% if ntfy_enabled | default(false) | bool %}
  - name: "Push Notifications"
    group: platform
    # ntfy is fenced to the PG primary, so this probe follows the active-passive
    # DNS record. A 200 with healthy=false, or no answer at all, means alerts
    # published to the self-hosted server are going nowhere.
    url: "https://{{ ntfy_domain | default('ntfy.' + platform_domain) }}/v1/health"
    client:
      insecure: true
    conditions:
      - "[STATUS] == 200"
      - "[BODY].healthy == true"
      - "[CERTIFICATE_EXPIRATION] > 720h"
    interval: 2m
{% endif %}
  - name: "Status Dashboard"
    group: platform
    url: "https://{{ gatus_domain }}/health"
    client:
      insecure: true
    conditions:
      - "[STATUS] == 200"
      - "[CERTIFICATE_EXPIRATION] > 720h"
    interval: 5m
{% if openziti_enabled | default(false) | bool %}
  - name: "OpenZiti Edge API"
    group: platform
    url: "https://{{ openziti_domain | default('ziti.' + platform_domain) }}/edge/client/v1/version"
    client:
      insecure: true
    conditions:
      - "[STATUS] == 200"
      - "[CERTIFICATE_EXPIRATION] > 720h"
    interval: 2m
  - name: "OpenZiti Console"
    group: platform
    url: "https://{{ openziti_domain | default('ziti.' + platform_domain) }}"
    client:
      insecure: true
    conditions:
      - "[STATUS] < 500"
      - "[CERTIFICATE_EXPIRATION] > 720h"
    interval: 5m
{% endif %}
