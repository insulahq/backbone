# Endpoints
NETBIRD_MGMT_API_ENDPOINT=https://{{ netbird_dashboard_domain }}
NETBIRD_MGMT_GRPC_API_ENDPOINT=https://{{ netbird_dashboard_domain }}
# OIDC — Zitadel
AUTH_AUDIENCE={{ netbird_oidc_client_id }}
AUTH_CLIENT_ID={{ netbird_oidc_client_id }}
AUTH_CLIENT_SECRET={{ netbird_oidc_client_secret | default('') }}
AUTH_AUTHORITY=https://{{ zitadel_domain | default('auth.' + platform_domain) }}
USE_AUTH0=false
AUTH_SUPPORTED_SCOPES=openid profile email groups offline_access
AUTH_REDIRECT_URI=/nb-auth
AUTH_SILENT_REDIRECT_URI=/nb-silent-auth
# SSL — Traefik handles TLS
NGINX_SSL_PORT=443
LETSENCRYPT_DOMAIN=none
