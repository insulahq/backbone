# Traefik Static Configuration for NetBird

api:
  dashboard: false
  insecure: false

entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https

  websecure:
    address: ":443"

providers:
  docker:
    endpoint: "unix:///var/run/docker.sock"
    exposedByDefault: false
    network: netbird

  file:
    filename: /etc/traefik/traefik-dynamic.yml
    watch: true

certificatesResolvers:
  letsencrypt:
    acme:
      email: {{ netbird_traefik_email }}
      storage: /acme.json
{% if netbird_traefik_acme_challenge == 'dns-01' %}
      dnsChallenge:
        provider: {{ netbird_traefik_dns_provider }}
        delayBeforeCheck: 10
        resolvers:
          - "{{ hostvars['ns1']['ansible_host'] }}:53"
          - "{{ hostvars['ns2']['ansible_host'] }}:53"
{% else %}
      httpChallenge:
        entryPoint: web
{% endif %}

log:
  level: INFO

accessLog:
  filters:
    statusCodes:
      - "400-599"
