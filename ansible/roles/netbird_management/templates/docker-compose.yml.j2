services:
  # UI dashboard
  dashboard:
    image: netbirdio/dashboard:{{ netbird_dashboard_version }}
    container_name: netbird-dashboard
    restart: unless-stopped
    networks:
      - netbird
      - traefik_public
    env_file:
      - ./dashboard.env
    labels:
      - traefik.enable=true
      - traefik.http.routers.netbird-dashboard.rule=Host(`{{ netbird_dashboard_domain }}`)
      - traefik.http.routers.netbird-dashboard.entrypoints=websecure
      - traefik.http.routers.netbird-dashboard.tls=true
      - traefik.http.routers.netbird-dashboard.middlewares=ratelimit@file
      - traefik.http.routers.netbird-dashboard.service=dashboard
      - traefik.http.routers.netbird-dashboard.priority=1
      - traefik.http.services.dashboard.loadbalancer.server.port=80
    volumes:
      - ./dashboard-nginx.conf:/etc/nginx/conf.d/default.conf:ro
    healthcheck:
      test: ["CMD-SHELL", "wget -q --spider http://localhost:80/ || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 15s
    logging:
      driver: "json-file"
      options:
        max-size: "100m"
        max-file: "2"

  # Combined server: Management + Signal + Relay + STUN
  netbird-server:
    image: netbirdio/netbird-server:{{ netbird_server_version }}
    container_name: netbird-server
    restart: unless-stopped
    networks:
      - netbird
      - traefik_public
      # Connect to postgresql_default so netbird-server can reach PostgreSQL via Docker DNS
      # ('postgresql' hostname) WITHOUT needing the WireGuard tunnel to be up first.
      # This breaks the boot-time circular dependency on BOTH nodes:
      #   netbird-server needs PG → PG needs WireGuard IP → WireGuard needs netbird-server
      - postgresql_default
    environment:
{% set peer = groups['dns_servers'] | difference([inventory_hostname]) | first %}
{% set peer_ip = hostvars[peer]['wireguard_ip'] %}
      # Multi-host DSN: local PostgreSQL via Docker DNS first, peer via WireGuard IP as fallback.
      # Local-first ordering avoids 30s timeout when the peer is unreachable (gotcha 38).
      NB_STORE_ENGINE_POSTGRES_DSN: "host=postgresql,{{ peer_ip }} port=5432 user=netbird password={{ postgresql_netbird_password }} dbname=netbird sslmode=disable target_session_attrs=read-write"
    ports:
      - '0.0.0.0:{{ netbird_stun_port }}:{{ netbird_stun_port }}/udp'
      - '[::]:{{ netbird_stun_port }}:{{ netbird_stun_port }}/udp'
    volumes:
      - netbird_data:/var/lib/netbird
      - ./config.yaml:/etc/netbird/config.yaml
    command: ["--config", "/etc/netbird/config.yaml"]
    labels:
      - traefik.enable=true
      # gRPC router (h2c backend required for HTTP/2 cleartext)
      - traefik.http.routers.netbird-grpc.rule=Host(`{{ netbird_dashboard_domain }}`) && (PathPrefix(`/signalexchange.SignalExchange/`) || PathPrefix(`/management.ManagementService/`))
      - traefik.http.routers.netbird-grpc.entrypoints=websecure
      - traefik.http.routers.netbird-grpc.tls=true
      - traefik.http.routers.netbird-grpc.service=netbird-server-h2c
      - traefik.http.routers.netbird-grpc.priority=100
      # Backend router: relay, API, embedded IdP (oauth2)
      - traefik.http.routers.netbird-backend.rule=Host(`{{ netbird_dashboard_domain }}`) && (PathPrefix(`/relay`) || PathPrefix(`/ws-proxy/`) || PathPrefix(`/api`) || PathPrefix(`/oauth2`))
      - traefik.http.routers.netbird-backend.entrypoints=websecure
      - traefik.http.routers.netbird-backend.tls=true
      - traefik.http.routers.netbird-backend.middlewares=ratelimit@file
      - traefik.http.routers.netbird-backend.service=netbird-server
      - traefik.http.routers.netbird-backend.priority=100
      # Services
      - traefik.http.services.netbird-server.loadbalancer.server.port=80
      - traefik.http.services.netbird-server-h2c.loadbalancer.server.port=80
      - traefik.http.services.netbird-server-h2c.loadbalancer.server.scheme=h2c
    # NOTE: No Docker healthcheck on netbird-server. Traefik v3.6 filters
    # unhealthy containers from routing (gotcha #74). The NetBird image has
    # no wget/curl, and /dev/tcp is bash-only (image uses sh). Without a
    # working healthcheck, Traefik would permanently exclude this container,
    # breaking all management/gRPC/OAuth2 routes.
    logging:
      driver: "json-file"
      options:
        max-size: "200m"
        max-file: "2"

volumes:
  netbird_data:

networks:
  netbird:
    driver: bridge
    enable_ipv6: true
    ipam:
      config:
        - subnet: {{ netbird_docker_subnet }}
          gateway: {{ netbird_docker_gateway }}
        - subnet: "fd00:dead:beef:2::/112"
  traefik_public:
    external: true
  postgresql_default:
    external: true
