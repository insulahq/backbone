version: '3.8'

networks:
  netbird:
    driver: bridge
{% if 'powerdns_master' in group_names or 'powerdns_slave' in group_names %}
  powerdns_external:
    external: true
    name: powerdns_powerdns_external
{% endif %}

services:
  # Traefik reverse proxy (HTTPS termination + Let's Encrypt)
  traefik:
    image: traefik:v2.11
    container_name: netbird-traefik
    restart: unless-stopped
    command:
      - "--api.insecure=false"
      - "--providers.docker=true"
      - "--providers.docker.exposedbydefault=false"
      - "--entrypoints.web.address=:80"
      - "--entrypoints.websecure.address=:443"
      - "--certificatesresolvers.letsencrypt.acme.dnschallenge=true"
      - "--certificatesresolvers.letsencrypt.acme.dnschallenge.provider=pdns"
      - "--certificatesresolvers.letsencrypt.acme.email={{ netbird_traefik_email }}"
      - "--certificatesresolvers.letsencrypt.acme.storage=/letsencrypt/acme.json"
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - {{ netbird_install_dir }}/acme.json:/letsencrypt/acme.json
      - {{ netbird_install_dir }}/traefik.yml:/etc/traefik/traefik.yml:ro
      - {{ netbird_install_dir }}/traefik-dynamic.yml:/etc/traefik/dynamic.yml:ro
    environment:
      PDNS_API_URL: "{{ powerdns_api_url }}"
      PDNS_API_KEY: "{{ powerdns_api_key }}"
    networks:
      - netbird
{% if 'powerdns_master' in group_names or 'powerdns_slave' in group_names %}
      - powerdns_external
{% endif %}

  # NetBird Management (API, gRPC, embedded IdP)
  # New architecture (0.66+): Management serves on port 80 internally
  management:
    image: netbirdio/management:{{ netbird_management_version }}
    container_name: netbird-management
    restart: unless-stopped
    environment:
      NETBIRD_STORE_ENGINE: sqlite
      NETBIRD_DATADIR: /var/lib/netbird
      NETBIRD_DOMAIN: {{ netbird_dashboard_domain }}
      NETBIRD_TURN_ENABLED: "true"
      NETBIRD_TURN_HOST: {{ ansible_default_ipv4.address }}
      NETBIRD_TURN_PORT: 3478
      NETBIRD_TURN_SECRET: {{ netbird_coturn_secret }}
    volumes:
      - {{ netbird_install_dir }}/data:/var/lib/netbird
      - {{ netbird_install_dir }}/management.json:/etc/netbird/management.json:ro
    ports:
      - "33073:33073"  # Backward compatibility gRPC port
    networks:
      - netbird
    labels:
      - "traefik.enable=true"
      # Route API and OAuth2 traffic to management (higher priority)
      - "traefik.http.routers.netbird-api.rule=Host(`{{ netbird_dashboard_domain }}`) && (PathPrefix(`/api`) || PathPrefix(`/oauth2`) || PathPrefix(`/management.ManagementService`))"
      - "traefik.http.routers.netbird-api.entrypoints=websecure"
      - "traefik.http.routers.netbird-api.tls.certresolver=letsencrypt"
      - "traefik.http.routers.netbird-api.priority=10"
      - "traefik.http.services.netbird-api.loadbalancer.server.port=80"
      - "traefik.http.services.netbird-api.loadbalancer.server.scheme=http"

  # NetBird Dashboard (Web UI)
  # Separate container serving static dashboard files
  dashboard:
    image: netbirdio/dashboard:{{ netbird_dashboard_version }}
    container_name: netbird-dashboard
    restart: unless-stopped
    environment:
      NETBIRD_MGMT_API_ENDPOINT: https://{{ netbird_dashboard_domain }}
      NETBIRD_MGMT_GRPC_API_ENDPOINT: https://{{ netbird_dashboard_domain }}
      AUTH_AUTHORITY: https://{{ netbird_dashboard_domain }}/oauth2
      AUTH_CLIENT_ID: netbird-dashboard
      AUTH_AUDIENCE: netbird-dashboard
      USE_AUTH0: "false"
      AUTH_SUPPORTED_SCOPES: "openid profile email"
      AUTH_REDIRECT_URI: "https://{{ netbird_dashboard_domain }}/nb-auth"
      AUTH_SILENT_REDIRECT_URI: "https://{{ netbird_dashboard_domain }}/nb-silent-auth"
    networks:
      - netbird
    labels:
      - "traefik.enable=true"
      # Route dashboard UI traffic (everything else, lower priority)
      - "traefik.http.routers.netbird-dashboard.rule=Host(`{{ netbird_dashboard_domain }}`)"
      - "traefik.http.routers.netbird-dashboard.entrypoints=websecure"
      - "traefik.http.routers.netbird-dashboard.tls.certresolver=letsencrypt"
      - "traefik.http.routers.netbird-dashboard.priority=1"
      - "traefik.http.services.netbird-dashboard.loadbalancer.server.port=80"

  # NetBird Signal Server (direct access on port 10000, no Traefik)
  signal:
    image: netbirdio/signal:{{ netbird_signal_version }}
    container_name: netbird-signal
    restart: unless-stopped
    environment:
      NETBIRD_SIGNAL_PORT: {{ netbird_signal_port }}
      NETBIRD_SIGNAL_PROTOCOL: http
    ports:
      - "{{ netbird_signal_port }}:{{ netbird_signal_port }}"
    networks:
      - netbird

  # Coturn (TURN/STUN relay for NAT traversal)
  coturn:
    image: coturn/coturn:{{ netbird_coturn_version }}
    container_name: netbird-coturn
    restart: unless-stopped
    command:
      - -n
      - --log-file=stdout
      - --external-ip={{ ansible_default_ipv4.address }}
      - --listening-port={{ netbird_signal_port }}
      - --min-port={{ netbird_coturn_min_port }}
      - --max-port={{ netbird_coturn_max_port }}
      - --fingerprint
      - --lt-cred-mech
      - --user=netbird:{{ netbird_coturn_secret }}
      - --static-auth-secret={{ netbird_coturn_secret }}
      - --realm={{ netbird_dashboard_domain }}
    network_mode: host
    volumes:
      - {{ netbird_install_dir }}/coturn:/var/lib/coturn

  # Litestream (SQLite database replication)
  litestream:
    image: litestream/litestream:{{ netbird_litestream_version }}
    container_name: netbird-litestream
    restart: unless-stopped
    command: replicate
    volumes:
      - {{ netbird_install_dir }}/data:/var/lib/netbird
      - {{ netbird_install_dir }}/litestream:/var/lib/litestream
      - {{ netbird_install_dir }}/litestream.yml:/etc/litestream.yml:ro
    networks:
      - netbird
