# Combined NetBird Server Configuration
# Replaces management.json — covers management, signal, relay, STUN

server:
  listenAddress: ":80"
  exposedAddress: "https://{{ netbird_dashboard_domain }}:443"
  stunPorts:
    - {{ netbird_stun_port }}
  metricsPort: 9090
  healthcheckAddress: ":9000"
  logLevel: "info"
  logFile: "console"

  authSecret: "{{ netbird_relay_auth_secret }}"
  dataDir: "/var/lib/netbird"

  auth:
    # Embedded IdP — the management server runs its own Dex instance at /oauth2.
    # Dashboard authenticates via this endpoint, not directly to Zitadel.
    # External IdPs (Zitadel, Google, etc.) are added via dashboard Settings.
    issuer: "https://{{ netbird_dashboard_domain }}/oauth2"
    signKeyRefreshEnabled: true
    dashboardRedirectURIs:
      - "https://{{ netbird_dashboard_domain }}/nb-auth"
      - "https://{{ netbird_dashboard_domain }}/nb-silent-auth"
    cliRedirectURIs:
      - "http://localhost:53000/"

  reverseProxy:
    trustedHTTPProxies:
      - "{{ traefik_container_ip }}/32"
{% if traefik_container_ipv6 is defined %}
      - "{{ traefik_container_ipv6 }}/128"
{% endif %}

  dnsDomain: "{{ netbird_peer_dns_domain | default('netbird') }}"

  store:
    engine: "postgres"
    encryptionKey: "{{ netbird_datastore_encryption_key }}"

  # NOTE: Embedded Dex IdP stores credentials in SQLite (idp.db), NOT PostgreSQL.
  # NetBird 0.66.x does not support idpStorage config. The idp.db file is synced
  # from primary to secondary during deployment (see sync tasks in main.yml).
