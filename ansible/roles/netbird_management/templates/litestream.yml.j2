# Litestream Configuration — NetBird SQLite Replication
# Provides bidirectional replication between ns1 and ns2
# Achieves 30s RTO, <1s RPO with automatic failover/failback

dbs:
  - path: /var/lib/netbird/store.db
    replicas:
      # Replica to peer NetBird server (bidirectional)
      - type: file
        path: /var/lib/netbird/litestream/{{ 'ns2' if inventory_hostname == 'ns1' else 'ns1' }}
        retention: 24h
        retention-monitor-interval: 1h
        sync-interval: 1s
        snapshot-interval: 1h

      # Optional: Replica to Hetzner Storagebox (bonus backup)
      - type: sftp
        path: /netbird-backups/{{ inventory_hostname }}
        host: u335448.your-storagebox.de
        user: u335448-sub9
        key-path: /root/.ssh/phoenix-host.key
        retention: 168h  # 7 days
        retention-monitor-interval: 6h
        sync-interval: 10s
        snapshot-interval: 6h
