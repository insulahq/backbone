# coturn STUN/TURN configuration for NetBird relay
# Managed by Ansible. Do not edit manually.

# Listening ports
listening-port=3478
tls-listening-port=5349

# External IP
external-ip={{ ns1_public_ip }}

# Realm
realm={{ netbird_domain }}

# Credentials (must match management.json TURNConfig)
user=netbird:{{ netbird_turn_password }}
lt-cred-mech

# Security
no-multicast-peers
no-cli
no-rfc5780
no-stun-backward-compatibility
response-origin-only-with-rfc5780

# Logging
log-file=stdout
