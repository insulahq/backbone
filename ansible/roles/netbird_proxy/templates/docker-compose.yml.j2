---
# NetBird Reverse Proxy — auto-generated by Ansible.
# Coexists with the netbird-server all-in-one container on the same Docker
# bridge (netbird_default). Traefik terminates TCP at :443 with HostSNI
# matching *.{{ netbird_proxy_apex }} and passes through to :8443 here,
# where this proxy terminates TLS itself with ACME TLS-ALPN-01.

services:
  netbird-proxy:
    image: {{ netbird_proxy_image }}
    container_name: netbird-proxy
    restart: unless-stopped
    networks:
      - netbird            # same bridge as netbird-server (Docker DNS resolves "netbird-server")
      - traefik_public     # Traefik routes TCP-passthrough here
    expose:
      - "8443"
    environment:
      # Domain apex — used as the cert-issued name for the proxy itself
      # plus as the suffix where exposed services live.
      NB_PROXY_DOMAIN: "{{ netbird_proxy_apex }}"
      NB_PROXY_URL: "https://{{ netbird_proxy_apex }}"

      # Authenticate to management. M2M token created via:
      #   docker exec netbird-server /go/bin/netbird-server -c /etc/netbird/config.yaml token create --name proxy-{{ inventory_hostname }}
      NB_PROXY_TOKEN: "{{ netbird_proxy_token }}"
      NB_PROXY_MANAGEMENT_ADDRESS: "http://netbird-server:80"
      NB_PROXY_ALLOW_INSECURE: "true"  # gRPC to management on local Docker net

      # Listen address inside the container.
      NB_PROXY_ADDRESS: "{{ netbird_proxy_listen }}"

      # ACME — terminate TLS ourselves with per-service certs from Let's Encrypt.
      NB_PROXY_ACME_CERTIFICATES: "true"
      NB_PROXY_ACME_CHALLENGE_TYPE: "tls-alpn-01"
      NB_PROXY_ACME_EMAIL: "{{ netbird_proxy_acme_email }}"
      NB_PROXY_CERTIFICATE_DIRECTORY: "/certs"
{% if netbird_proxy_acme_ca | length > 0 %}
      NB_PROXY_ACME_CA: "{{ netbird_proxy_acme_ca }}"
{% endif %}

      NB_PROXY_LOG_LEVEL: "{{ netbird_proxy_log_level }}"
    volumes:
      - netbird_proxy_certs:/certs
    deploy:
      resources:
        limits:
          memory: 256M
          cpus: '0.5'

networks:
  netbird:
    external: true
    name: netbird_netbird   # compose-namespaced (project "netbird" + network "netbird")
  traefik_public:
    external: true
    name: "{{ traefik_public_network | default('traefik_public') }}"

volumes:
  netbird_proxy_certs:
