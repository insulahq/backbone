---
# Portainer — Docker Management ({{ inventory_hostname }})
# nftables blocks public access on ports 9000/9001 (gotcha 114).
# Accessible via WireGuard (wg0) and NetBird (wt0) only.

services:
{% if inventory_hostname == portainer_server_node %}
  # Portainer CE — Docker management UI (single instance, manages all nodes via agents)
  portainer:
    image: {{ portainer_image }}
    container_name: portainer
    restart: unless-stopped
    network_mode: host
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - portainer_data:/data
    # No Docker healthcheck — image has no wget/curl (gotcha 112)
    logging:
      driver: "json-file"
      options:
        max-size: "100m"
        max-file: "2"
{% endif %}

  # Portainer Agent — managed by the CE instance on {{ portainer_server_node }}
  portainer-agent:
    image: {{ portainer_agent_image }}
    container_name: portainer-agent
    restart: unless-stopped
    ports:
      - "0.0.0.0:{{ portainer_agent_port }}:9001"
      - "[::]:{{ portainer_agent_port }}:9001"
    environment:
      AGENT_SECRET: "{{ portainer_agent_secret }}"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - /var/lib/docker/volumes:/var/lib/docker/volumes
    logging:
      driver: "json-file"
      options:
        max-size: "100m"
        max-file: "2"

{% if inventory_hostname == portainer_server_node %}
volumes:
  portainer_data:
{% endif %}
