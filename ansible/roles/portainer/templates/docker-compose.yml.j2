---
# Portainer CE — Docker Management ({{ inventory_hostname }})
# Each node runs its own Portainer CE managing local Docker via socket.
# nftables blocks public access on port 9000 (gotcha 114).
# Accessible via WireGuard (wg0) and NetBird (wt0) only.

services:
  portainer:
    image: {{ portainer_image }}
    container_name: portainer
    restart: unless-stopped
    # Docker bridge (not host network). DOCKER-USER iptables chain blocks
    # ports 9000/8000/9443 from public interfaces; VPN access allowed.
    ports:
      - "0.0.0.0:9000:9000"
      - "0.0.0.0:8000:8000"
      - "0.0.0.0:9443:9443"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - {{ portainer_install_dir }}/data:/data
    # No Docker healthcheck — image has no wget/curl (gotcha 112)
    logging:
      driver: "json-file"
      options:
        max-size: "100m"
        max-file: "2"
