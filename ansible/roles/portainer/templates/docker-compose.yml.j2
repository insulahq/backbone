---
# Portainer CE + Agent — Docker Management ({{ inventory_hostname }})
# Portainer server on 0.0.0.0:9000 — nftables blocks public access (gotcha 114).
# Portainer agent on 0.0.0.0:9001 — same nftables protection.
# Reachable via WireGuard (wg0) and NetBird (wt0) only.

services:
  # Portainer CE — Docker management UI
  portainer:
    image: {{ portainer_image }}
    container_name: portainer
    restart: unless-stopped
    ports:
      - "0.0.0.0:{{ portainer_port }}:9000"
      - "[::]:{{ portainer_port }}:9000"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - portainer_data:/data
    # No Docker healthcheck — image has no wget/curl (gotcha 112)
    logging:
      driver: "json-file"
      options:
        max-size: "100m"
        max-file: "2"

  # Portainer Agent — allows remote management from the other node's Portainer
  portainer-agent:
    image: {{ portainer_agent_image }}
    container_name: portainer-agent
    restart: unless-stopped
    ports:
      - "0.0.0.0:{{ portainer_agent_port }}:9001"
      - "[::]:{{ portainer_agent_port }}:9001"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - /var/lib/docker/volumes:/var/lib/docker/volumes
    logging:
      driver: "json-file"
      options:
        max-size: "100m"
        max-file: "2"

volumes:
  portainer_data:
