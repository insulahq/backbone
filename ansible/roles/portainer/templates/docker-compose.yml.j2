---
# Portainer CE — Docker Management ({{ inventory_hostname }})
# Bound to NetBird IP only — access via http://{{ portainer_bind_interface }}:{{ portainer_port }}
# No TLS — WireGuard tunnel encrypts traffic. Avoids self-signed cert browser warnings.

services:
  portainer:
    image: {{ portainer_image }}
    container_name: portainer
    restart: unless-stopped
    command: --http-disabled=false --tunnel-server-addr=
    ports:
      # Bind to NetBird WireGuard IP only — not reachable from the public internet
      - "{{ portainer_bind_interface }}:{{ portainer_port }}:9000"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - portainer_data:/data
    healthcheck:
      test: ["CMD", "wget", "-q", "--spider", "http://localhost:9000/api/system/status"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 15s
    logging:
      driver: "json-file"
      options:
        max-size: "100m"
        max-file: "2"

volumes:
  portainer_data:
