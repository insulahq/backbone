# WireGuard configuration for {{ inventory_hostname }}
# Auto-generated by Ansible — do not edit manually.
# Infrastructure backbone tunnel between dns_servers nodes.

[Interface]
Address = {{ wireguard_ip }}/24
PrivateKey = {{ wireguard_private_key }}
ListenPort = {{ wireguard_port }}

{% for peer in groups['dns_servers'] | difference([inventory_hostname]) %}
[Peer]
# {{ peer }}
PublicKey = {{ hostvars[peer]['wireguard_public_key'] }}
AllowedIPs = {{ hostvars[peer]['wireguard_ip'] }}/32
Endpoint = {{ hostvars[peer]['ansible_host'] }}:{{ wireguard_port }}
PersistentKeepalive = {{ wireguard_keepalive }}

{% endfor %}
