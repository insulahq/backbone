---
apiVersion: v1
kind: Namespace
metadata:
  name: platform

---
apiVersion: v1
kind: Secret
metadata:
  name: mariadb-secrets
  namespace: platform
type: Opaque
stringData:
  root-password: "{{ mariadb_root_password | default('change-me') }}"
  db-user: "platform"
  db-password: "{{ management_api_db_password | default('change-me') }}"

---
apiVersion: v1
kind: Secret
metadata:
  name: management-api-secrets
  namespace: platform
type: Opaque
stringData:
  DB_HOST: "mariadb"
  DB_PORT: "3306"
  DB_NAME: "platform"
  DB_USER: "platform"
  DB_PASSWORD: "{{ management_api_db_password | default('change-me') }}"
  PDNS_API_KEY: "{{ pdns_api_key }}"
  ADMIN_PASSWORD: "{{ admin_password | default('change-me') }}"
  JWT_SECRET: "{{ jwt_secret | default('change-me-generate-with-openssl') }}"
