services:
  traefik:
    image: traefik:{{ traefik_version }}
    container_name: traefik
    restart: unless-stopped
    networks:
      traefik_public:
        ipv4_address: {{ traefik_container_ip }}
{% if traefik_public_ipv6_enabled | default(true) %}
        ipv6_address: {{ traefik_container_ipv6 }}
{% endif %}
      # Join PowerDNS internal network for DNS-01 ACME — Traefik reaches the
      # PowerDNS API via container DNS (http://powerdns-nginx:8081) instead of
      # relying on Docker DNAT through the host's WireGuard IP (gotcha 75).
      powerdns_internal: {}
    extra_hosts:
      - "host.docker.internal:host-gateway"
    command:
      - "--log.level={{ traefik_log_level }}"
      - "--accesslog=true"
      - "--providers.docker=true"
      - "--providers.docker.exposedbydefault=false"
      - "--providers.docker.network={{ traefik_public_network }}"
      # HTTP → HTTPS redirect
      - "--entrypoints.web.address=:80"
      - "--entrypoints.web.http.redirections.entrypoint.to=websecure"
      - "--entrypoints.web.http.redirections.entrypoint.scheme=https"
      # HTTPS entrypoint — zero timeouts for gRPC/WebSocket long-lived streams
      - "--entrypoints.websecure.address=:443"
      - "--entrypoints.websecure.allowACMEByPass=true"
      - "--entrypoints.websecure.transport.respondingTimeouts.readTimeout=0"
      - "--entrypoints.websecure.transport.respondingTimeouts.writeTimeout=0"
      - "--entrypoints.websecure.transport.respondingTimeouts.idleTimeout=0"
      - "--serverstransport.forwardingtimeouts.responseheadertimeout=0s"
      - "--serverstransport.forwardingtimeouts.idleconntimeout=0s"
      # DNS-01 ACME via PowerDNS
      - "--certificatesresolvers.letsencrypt.acme.dnschallenge=true"
      - "--certificatesresolvers.letsencrypt.acme.dnschallenge.provider={{ traefik_acme_dns_provider }}"
      - "--certificatesresolvers.letsencrypt.acme.dnschallenge.resolvers=8.8.8.8:53,1.1.1.1:53"
      - "--certificatesresolvers.letsencrypt.acme.email={{ traefik_acme_email }}"
      - "--certificatesresolvers.letsencrypt.acme.storage=/letsencrypt/acme.json"
      # Health check endpoint (used by Docker healthcheck below)
      - "--ping=true"
{% if traefik_wildcard_cert | default(true) %}
      # Wildcard certificate: *.{{ platform_domain }} + {{ platform_domain }}
      # All subdomains covered automatically — services don't need individual certresolver labels.
      # Uses a file provider to define the wildcard TLS configuration.
      - "--providers.file.filename=/etc/traefik/dynamic.yml"
{% endif %}
    ports:
      - '0.0.0.0:80:80'
      - '0.0.0.0:443:443'
      - '[::]:80:80'
      - '[::]:443:443'
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - {{ traefik_install_dir }}/acme.json:/letsencrypt/acme.json
{% if traefik_wildcard_cert | default(true) %}
      - {{ traefik_install_dir }}/dynamic.yml:/etc/traefik/dynamic.yml:ro
{% endif %}
    environment:
      PDNS_API_URL: "{{ traefik_pdns_api_url }}"
      PDNS_API_KEY: "{{ powerdns_api_key | default('') }}"
    labels:
      # Shared rate-limiting middleware — referenced by downstream services as ratelimit@docker
      - traefik.http.middlewares.ratelimit.ratelimit.average={{ traefik_ratelimit_average }}
      - traefik.http.middlewares.ratelimit.ratelimit.burst={{ traefik_ratelimit_burst }}
    healthcheck:
      test: ["CMD", "traefik", "healthcheck", "--ping"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 15s
    logging:
      driver: "json-file"
      options:
        max-size: "500m"
        max-file: "2"

networks:
  traefik_public:
    external: true
    name: {{ traefik_public_network }}
  powerdns_internal:
    external: true

