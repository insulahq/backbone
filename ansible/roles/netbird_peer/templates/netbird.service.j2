[Unit]
Description=NetBird Peer Client
Documentation=https://netbird.io/docs
After=network.target

[Service]
Type=simple
ExecStart={{ netbird_install_dir }}/netbird service run \
  --log-level {{ netbird_log_level }} \
  --daemon-addr unix:///var/run/netbird.sock
ExecStop={{ netbird_install_dir }}/netbird service stop
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=netbird

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ netbird_config_dir }}
ReadWritePaths=/var/run

[Install]
WantedBy=multi-user.target
