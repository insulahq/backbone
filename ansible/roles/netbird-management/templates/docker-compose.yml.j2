# NetBird Self-Hosted Management Stack
# Managed by Ansible. Do not edit manually.
# Docs: https://docs.netbird.io/selfhosted/selfhosted-quickstart

version: "3"

services:
  # Reverse proxy — handles TLS termination + routing to management + signal
  caddy:
    image: caddy:2-alpine
    restart: unless-stopped
    networks: [netbird]
    ports:
      - "80:80"
      - "443:443"
      - "443:443/udp"  # HTTP/3
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy_data:/data
      - caddy_config:/config
    depends_on:
      - management
      - signal

  # NetBird management server (REST API + admin dashboard)
  management:
    image: netbirdio/management:{{ netbird_version }}
    restart: unless-stopped
    networks: [netbird]
    volumes:
      - ./data:/var/lib/netbird
    command: [
      "--port", "80",
      "--log-file", "console",
      "--log-level", "info",
      "--disable-anonymous-metrics",
      "--single-account-mode-domain", "{{ platform_domain }}",
      "--dns-domain", "netbird.{{ platform_domain }}"
    ]
    environment:
      NETBIRD_STORE_ENGINE: sqlite  # Start with SQLite; migrate to PostgreSQL at scale

  # NetBird signal server (WebRTC signalling for peer-to-peer connections)
  signal:
    image: netbirdio/signal:{{ netbird_version }}
    restart: unless-stopped
    networks: [netbird]
    command: ["--port", "80", "--log-file", "console", "--log-level", "info"]

  # STUN/TURN relay server (for peers behind NAT)
  coturn:
    image: coturn/coturn:latest
    restart: unless-stopped
    network_mode: host   # Must use host network for STUN/TURN to work correctly
    volumes:
      - ./coturn.conf:/etc/coturn/turnserver.conf:ro

networks:
  netbird:
    driver: bridge

volumes:
  caddy_data:
  caddy_config:
