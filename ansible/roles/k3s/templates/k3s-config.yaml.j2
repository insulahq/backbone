# k3s Configuration for {{ inventory_hostname }}
# {{ k3s_server_enabled | ternary('Server', 'Agent') }} mode

{% if k3s_server_enabled %}
# Server (Control Plane) Configuration
cluster-init: {{ k3s_ha_mode | lower }}
{% if k3s_datastore_endpoint %}
datastore-endpoint: "{{ k3s_datastore_endpoint }}"
{% endif %}
{% if k3s_token is defined and k3s_token | length > 0 %}
token: "{{ k3s_token }}"
{% endif %}

# TLS configuration
tls-san:
{% for san in k3s_tls_san %}
  - "{{ san }}"
{% endfor %}

# Disable built-in components
disable:
{% for component in k3s_disable_components %}
  - {{ component }}
{% endfor %}

# Cluster networking
cluster-cidr: "{{ k3s_cluster_cidr }}"
service-cidr: "{{ k3s_service_cidr }}"
cluster-dns: "{{ k3s_cluster_dns }}"
cluster-domain: "{{ k3s_cluster_domain }}"
flannel-backend: "{{ k3s_flannel_backend }}"

# Node configuration
node-name: "{{ k3s_node_name }}"
node-ip: "{{ k3s_node_ip }}"

# Kubelet configuration
kubelet-arg:
{% for arg in k3s_kubelet_args %}
  - "{{ arg }}"
{% endfor %}

# Security
secrets-encryption: {{ k3s_secrets_encryption | lower }}
protect-kernel-defaults: {{ k3s_protect_kernel_defaults | lower }}

# Kubeconfig
write-kubeconfig-mode: "{{ k3s_write_kubeconfig_mode }}"

# Disable network policy controller (use Cilium or Calico instead)
{% if k3s_disable_network_policy %}
disable-network-policy: true
{% endif %}

{% else %}
# Agent (Worker) Configuration
  server: "https://{{ hostvars[groups['k8s_servers'][0]]['ansible_host'] }}:6443"
{% if k3s_token is defined and k3s_token | length > 0 %}
token: "{{ k3s_token }}"
{% endif %}

# Node configuration
node-name: "{{ k3s_node_name }}"
node-ip: "{{ k3s_node_ip }}"

# Kubelet configuration
kubelet-arg:
{% for arg in k3s_kubelet_args %}
  - "{{ arg }}"
{% endfor %}

{% endif %}
