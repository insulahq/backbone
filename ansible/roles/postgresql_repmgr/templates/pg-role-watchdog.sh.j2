#!/bin/bash
# ==========================================================================
# PostgreSQL Role Watchdog — Self-Healing pgproxy + DNS + Consumer Manager
# ==========================================================================
# Runs every 30s via systemd timer on the HOST (not inside a container).
# Detects PG role changes and fixes pgproxy target, DNS, and consumer
# containers immediately. Replaces the unreliable signal-file mechanism.
#
# This script is IDEMPOTENT — if everything is already correct, it does nothing.
# ==========================================================================

set -euo pipefail

# Concurrency guard — only one invocation at a time.
# The timer fires every ~30s; a single run can exceed that when PowerDNS or
# services are slow to restart. Two concurrent runs race on pgproxy-target
# and on service restart cycles.
exec 9>/var/run/pg-role-watchdog.lock
flock -n 9 || exit 0

# Self-heal: ensure our timer is enabled and running
if ! systemctl is-active pg-role-watchdog.timer &>/dev/null; then
  systemctl start pg-role-watchdog.timer 2>/dev/null || true
fi

PGPROXY_TARGET_FILE="/opt/postgresql/pgproxy-target"
PEER_NAME="{{ groups['dns_servers'] | difference([inventory_hostname]) | first }}"
LOCAL_TARGET="postgresql"   # Docker DNS name for local PG (primary)
REMOTE_TARGET="$PEER_NAME"  # Hostname mapped via extra_hosts to peer WireGuard IP

# Check if PG container is running and healthy
PG_HEALTH=$(docker inspect postgresql --format "{% raw %}{{.State.Health.Status}}{% endraw %}" 2>/dev/null || echo "missing")
if [ "$PG_HEALTH" != "healthy" ]; then
  exit 0  # PG not ready, skip this cycle
fi

# Get current PG role
PG_ROLE=$(docker exec postgresql psql -U postgres -tAc "SELECT pg_is_in_recovery();" 2>/dev/null || echo "error")
if [ "$PG_ROLE" = "error" ]; then
  exit 0  # Can't query PG, skip this cycle
fi

# Determine correct target
if [ "$PG_ROLE" = "f" ]; then
  CORRECT_TARGET="$LOCAL_TARGET"
  DNS_MODE="primary-only"
else
  CORRECT_TARGET="$REMOTE_TARGET"
  DNS_MODE="drain-self"
fi

# Read current target
CURRENT_TARGET=$(cat "$PGPROXY_TARGET_FILE" 2>/dev/null || echo "")

# Check if DNS also points to the right node
if [ "$PG_ROLE" = "f" ]; then
  # Primary node — DNS should contain our public IP
  EXPECTED_IP="{{ ansible_host }}"
  CURRENT_DNS=$(dig +short {{ platform_domain }} A @{{ ansible_host }} +time=3 +tries=1 2>/dev/null | head -1 || true)
  if [ -z "$CURRENT_DNS" ]; then
    DNS_OK=true  # DNS unreachable (PowerDNS restarting) — don't trigger false failover
  elif [ "$CURRENT_DNS" = "$EXPECTED_IP" ]; then
    DNS_OK=true
  else
    DNS_OK=false
  fi
else
  DNS_OK=true  # Standby doesn't own DNS
fi

# Push PG role to Gatus — green when node is in its expected role.
# Preferred primary ({{ postgresql_primary_node | default('ns1') }}) pushes to "Role: Primary" (green = is primary).
# Other node pushes to "Role: Standby" (green = is standby).
GATUS_TOKEN=$(cat /etc/gatus-token 2>/dev/null || true)
if [ -n "$GATUS_TOKEN" ]; then
{% if inventory_hostname == (postgresql_primary_node | default('ns1')) %}
  # This is the preferred primary — green when actually primary
  ROLE_OK=$( [ "$PG_ROLE" = "f" ] && echo "true" || echo "false" )
  ROLE_ENDPOINT="role-primary"
{% else %}
  # This is the preferred standby — green when actually standby
  ROLE_OK=$( [ "$PG_ROLE" = "t" ] && echo "true" || echo "false" )
  ROLE_ENDPOINT="role-standby"
{% endif %}
  curl -fsS --max-time 3 -X POST \
    "http://127.0.0.1:8080/api/v1/endpoints/{{ inventory_hostname }}_${ROLE_ENDPOINT}/external?success=${ROLE_OK}" \
    -H "Authorization: Bearer ${GATUS_TOKEN}" \
    >/dev/null 2>&1 || true
fi

# Write-health probe — ensures every node's PG-Writable endpoint has known state.
# Primary: test actual INSERT; success=true iff writable.
# Standby: post success=true because the node is correctly in its expected role
# (read-only-by-design). Without this, the standby's PG-Writable endpoint goes
# DISCONNECTED in Gatus because nothing ever pushes to it.
if [ "$PG_ROLE" = "f" ]; then
  docker exec postgresql psql -U postgres -qc "CREATE TABLE IF NOT EXISTS _watchdog_heartbeat(id int PRIMARY KEY DEFAULT 1 CHECK(id=1), ts timestamptz NOT NULL)" 2>/dev/null || true
  if docker exec postgresql psql -U postgres -qc "INSERT INTO _watchdog_heartbeat VALUES(1,now()) ON CONFLICT(id) DO UPDATE SET ts=now()" 2>/dev/null; then
    GATUS_SUCCESS=true
  else
    GATUS_SUCCESS=false
    echo "$(date): WARNING — Primary cannot write to PostgreSQL (disk full / read-only?)"
  fi
else
  # Standby in its expected state — node-is-healthy signal.
  GATUS_SUCCESS=true
fi
if [ -n "$GATUS_TOKEN" ]; then
  curl -fsS --max-time 3 -X POST \
    "http://127.0.0.1:8080/api/v1/endpoints/{{ inventory_hostname }}_pg-writable/external?success=${GATUS_SUCCESS}" \
    -H "Authorization: Bearer ${GATUS_TOKEN}" \
    >/dev/null 2>&1 || true
fi

# Standby replication watch (gotcha 151) — a WAL gap that develops while the
# standby is LIVE (walreceiver dead, primary already recycled the segment)
# is NOT caught by the entrypoint's startup-replay detector: PG stays up,
# serves reads, retries forever, and silently falls behind. Observed
# 2026-07-22 after back-to-back node reboots. Alert so the operator can
# re-clone (docker stop postgresql; wipe postgresql_postgresql_data; start —
# the entrypoint's fresh-standby path clones from the primary).
if [ "$PG_ROLE" = "t" ]; then
  _WAL_STREAMING=$(docker exec postgresql psql -U postgres -tAc "SELECT count(*) FROM pg_stat_wal_receiver WHERE status='streaming';" 2>/dev/null | tr -d ' ' || echo "0")
  if [ "${_WAL_STREAMING:-0}" = "0" ]; then
    STREAM_FAILS=$(cat /var/run/pg-stream-fails 2>/dev/null || echo 0)
    STREAM_FAILS=$((STREAM_FAILS + 1))
    echo "$STREAM_FAILS" > /var/run/pg-stream-fails
    # ~2 min of confirmed non-streaming before alerting; re-alert ~20-minutely
    if [ "$STREAM_FAILS" -eq 4 ] || [ $((STREAM_FAILS % 40)) -eq 0 ]; then
      echo "$(date): WARNING — standby has no streaming WAL receiver ($STREAM_FAILS consecutive checks)"
      source /usr/local/lib/platform-alert.sh 2>/dev/null || platform_alert() { echo "[alert:$1] [$2] $3"; }
      platform_alert "warning" "PG-Standby-Streaming" "Standby {{ inventory_hostname }} has NO streaming WAL receiver (${STREAM_FAILS} checks ≈ $((STREAM_FAILS / 2)) min). Likely WAL gap — see gotcha 151 for the re-clone procedure."
    fi
  else
    rm -f /var/run/pg-stream-fails
  fi
fi

# ==========================================================================
# NetBird fencing — netbird-server + netbird-proxy run ONLY on the PG primary
# ==========================================================================
# Signal state is per-instance and in-memory (gotchas 136/148/149). A running
# netbird-server on the standby lets stale clients silently attach to its
# empty signal registry → split-signal mesh isolation. Fencing makes that
# state unrepresentable: with the container stopped, the standby's Traefik
# has no netbird routes, so a stale client gets an immediate failure,
# redials, re-resolves the 30s-TTL DNS record, and lands on the primary.
#
# Runs EVERY cycle, not just on transitions: deploys (`compose up -d`),
# manual `docker start`, and reboots all drift. Note `restart:
# unless-stopped` keeps a fenced container stopped across reboots, so
# promotion MUST re-start it here — nothing else will.
enforce_netbird_fence() {
  local nb_state proxy_state fence_state
  # Inspect the containers independently — the roles are separately taggable,
  # so netbird-proxy can exist on a node without netbird-server (or vice
  # versa) after a partial --tags/--limit run. Neither may run on the standby.
  nb_state=$(docker inspect netbird-server --format "{% raw %}{{.State.Status}}{% endraw %}" 2>/dev/null || echo "missing")
  proxy_state=$(docker inspect netbird-proxy --format "{% raw %}{{.State.Status}}{% endraw %}" 2>/dev/null || echo "missing")
  # netbird-fence sentinel (gotcha 150) — runs INVERSELY to netbird-server:
  # on the standby its TCP-passthrough-to-dead-port Traefik router closes
  # vpn-domain connections mid-TLS-handshake (a transport error gRPC clients
  # retry through) instead of letting the dashboard answer a valid-TLS 404
  # that pins management channels permanently.
  fence_state=$(docker inspect netbird-fence --format "{% raw %}{{.State.Status}}{% endraw %}" 2>/dev/null || echo "missing")
  if [ "$nb_state" = "missing" ] && [ "$proxy_state" = "missing" ] && [ "$fence_state" = "missing" ]; then
    return 0  # NetBird not deployed on this node
  fi

  if [ "$PG_ROLE" = "t" ]; then
    # ORDER (gotcha 150): the sentinel's TCP passthrough only wins the vpn
    # SNI once NO HTTP router claims it (TLS termination beats passthrough
    # while any Host-matching HTTP router lives — observed). Sequence so no
    # 404 surface is ever exposed: sentinel up (inert while contested) ->
    # dashboard down (server still serves mgmt correctly) -> proxy down ->
    # server down LAST (its routers vanish -> sentinel takes the SNI).
    if [ "$fence_state" != "missing" ] && [ "$fence_state" != "running" ]; then
      echo "$(date): NetBird fence — standby role, starting fence sentinel"
      docker start netbird-fence 2>&1 || echo "$(date): WARNING — netbird-fence start failed"
    fi
    dash_state=$(docker inspect netbird-dashboard --format "{% raw %}{{.State.Status}}{% endraw %}" 2>/dev/null || echo "missing")
    if [ "$dash_state" = "running" ] || [ "$dash_state" = "restarting" ]; then
      echo "$(date): NetBird fence — standby role, stopping netbird-dashboard"
      docker stop --time 5 netbird-dashboard 2>&1 || echo "$(date): WARNING — netbird-dashboard stop failed"
    fi
    if [ "$proxy_state" = "running" ] || [ "$proxy_state" = "restarting" ]; then
      echo "$(date): NetBird fence — standby role, stopping netbird-proxy"
      docker stop --time 5 netbird-proxy 2>&1 || echo "$(date): WARNING — netbird-proxy stop failed"
    fi
    if [ "$nb_state" = "running" ] || [ "$nb_state" = "restarting" ]; then
      echo "$(date): NetBird fence — standby role, stopping netbird-server"
      docker stop --time 5 netbird-server 2>&1 || echo "$(date): WARNING — netbird-server stop failed"
    fi
  elif [ "$PG_ROLE" = "f" ]; then
    # Only start once pgproxy already routes to the local primary. Starting
    # earlier would fill netbird's activity-store pool (DSN via pgproxy) with
    # connections to the read-only ex-primary, which pgx caches for up to
    # 60 min (gotcha 148).
    if [ "$(cat "$PGPROXY_TARGET_FILE" 2>/dev/null || true)" != "$CORRECT_TARGET" ]; then
      return 0  # Branch A retargets pgproxy first; the end-of-script call starts us
    fi
    if [ "$nb_state" != "missing" ] && [ "$nb_state" != "running" ]; then
      echo "$(date): NetBird fence — primary role, starting netbird-server"
      docker start netbird-server 2>&1 || echo "$(date): WARNING — netbird-server start failed"
      nb_state=$(docker inspect netbird-server --format "{% raw %}{{.State.Status}}{% endraw %}" 2>/dev/null || echo "missing")
    fi
    # The proxy talks to the LOCAL netbird-server — only start it when that
    # dependency is actually up, otherwise it just crash-loops.
    if [ "$proxy_state" != "missing" ] && [ "$proxy_state" != "running" ] && [ "$nb_state" = "running" ]; then
      echo "$(date): NetBird fence — primary role, starting netbird-proxy"
      docker start netbird-proxy 2>&1 || echo "$(date): WARNING — netbird-proxy start failed"
    fi
    dash_state=$(docker inspect netbird-dashboard --format "{% raw %}{{.State.Status}}{% endraw %}" 2>/dev/null || echo "missing")
    if [ "$dash_state" != "missing" ] && [ "$dash_state" != "running" ] && [ "$nb_state" = "running" ]; then
      echo "$(date): NetBird fence — primary role, starting netbird-dashboard"
      docker start netbird-dashboard 2>&1 || echo "$(date): WARNING — netbird-dashboard start failed"
    fi
    # Sentinel down LAST, once netbird-server is up. While both run, the
    # server's HTTP routers win the SNI (TLS termination beats passthrough),
    # so mgmt is served even before the sentinel stops — no gap either way.
    if [ "$fence_state" = "running" ] && [ "$nb_state" = "running" ]; then
      echo "$(date): NetBird fence — primary role, stopping fence sentinel"
      docker stop --time 2 netbird-fence 2>&1 || echo "$(date): WARNING — netbird-fence stop failed"
    fi
  fi
  return 0
}

# Steady-state fence enforcement (before the early exit below). During a role
# transition this only applies the stop direction — the start direction waits
# for pgproxy to be retargeted and runs via the end-of-script call.
enforce_netbird_fence

# Decompose the cascade: pgproxy-target change vs. DNS-only drift.
# Previously, any DNS mismatch re-triggered the full cascade (service restarts +
# netbird restart) every cycle while DNS stayed bad, causing continuous flapping.
PGPROXY_NEEDS_UPDATE=false
[ "$CORRECT_TARGET" != "$CURRENT_TARGET" ] && PGPROXY_NEEDS_UPDATE=true

DNS_NEEDS_UPDATE=false
[ "$DNS_OK" != "true" ] && DNS_NEEDS_UPDATE=true

if ! $PGPROXY_NEEDS_UPDATE && ! $DNS_NEEDS_UPDATE; then
  exit 0  # Everything already correct
fi

# === Branch A: pgproxy target changed → role transition, full cascade ===
if $PGPROXY_NEEDS_UPDATE; then
  echo "$(date): PG role change detected (recovery=$PG_ROLE). Fixing pgproxy: $CURRENT_TARGET → $CORRECT_TARGET"

  # 1. Update pgproxy target
  echo "$CORRECT_TARGET" > "$PGPROXY_TARGET_FILE"

  # 2. Wait for pgproxy to pick up new target (self-updating every 5s)
  sleep 7

  # 3. Restart PG-dependent services (they need fresh connections via new pgproxy target).
  #    netbird-server is deliberately NOT in this list — restarting it wipes its
  #    in-memory signal state and strands external peers (gotcha 148). It is
  #    managed by enforce_netbird_fence(): stopped on the standby, started
  #    fresh on the new primary AFTER pgproxy is retargeted, so its pools can
  #    never poison and its signal state is only ever wiped when clients must
  #    reconnect anyway.
  if ! docker restart powerdns-auth powerdns-nginx gatus zitadel --timeout 5 2>&1; then
    echo "$(date): WARNING — one or more service restarts failed after PG role change"
  fi

  # 4. Restart NetBird peer client — forces reconnection to the current primary's signal
  #    server. Without this, the peer holds a stale gRPC connection (gotcha 136).
  #    ONLY runs when the role actually transitioned — not on every DNS-retry cycle.
  if systemctl is-active netbird &>/dev/null; then
    echo "$(date): Restarting NetBird peer client (force signal server reconnection)"
    systemctl restart netbird 2>&1 || echo "$(date): WARNING — NetBird peer restart failed"
  fi

  # 5. Wait for PowerDNS to be healthy (needed for DNS switch API call)
  for _i in $(seq 1 12); do
    PDNS_HEALTH=$(docker inspect powerdns-auth --format "{% raw %}{{.State.Health.Status}}{% endraw %}" 2>/dev/null || echo "")
    [ "$PDNS_HEALTH" = "healthy" ] && break
    sleep 5
  done

  # 6. netbird-server itself is handled AFTER Branch B by the end-of-script
  #    enforce_netbird_fence() call: started fresh on the new primary (now
  #    that pgproxy routes locally), stopped on the demoted node. The peer
  #    wake-up fires at the end too — only on promotion — so it observes the
  #    post-fence mesh.
fi

# === Branch B: DNS drift (may run alone OR as a follow-up to branch A) ===
if $DNS_NEEDS_UPDATE; then
  for _i in 1 2 3; do
    /usr/local/bin/platform-dns-switch "$DNS_MODE" 2>&1 && break
    sleep 5
  done
fi

# Post-cascade fence pass — on promotion this is where netbird-server starts
# (pgproxy now routes to the local primary, so its pools connect cleanly).
enforce_netbird_fence

# External customer peers can hold stale signal sessions from the old
# primary. Fire the background wake-up (60s grace, then pings each peer's
# NetBird IP — best-effort ICE re-negotiation from our side). Only on
# promotion: the demoted node's netbird-server is fenced, and firing from
# both nodes doubles every Gatus alert. Unrecovered peers self-heal via the
# client-side netbird-selfheal.timer where installed (gotcha 148).
if $PGPROXY_NEEDS_UPDATE && [ "$PG_ROLE" = "f" ]; then
  ( /usr/local/bin/netbird-peer-wakeup.sh >/dev/null 2>&1 &) || true
fi

if $PGPROXY_NEEDS_UPDATE; then
  echo "$(date): Fixed. pgproxy=$CORRECT_TARGET, DNS=$DNS_MODE"
else
  echo "$(date): Fixed DNS only. DNS=$DNS_MODE (pgproxy already correct)"
fi
