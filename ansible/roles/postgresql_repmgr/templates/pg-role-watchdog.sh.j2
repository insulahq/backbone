#!/bin/bash
# ==========================================================================
# PostgreSQL Role Watchdog — Self-Healing pgproxy + DNS + Consumer Manager
# ==========================================================================
# Runs every 30s via systemd timer on the HOST (not inside a container).
# Detects PG role changes and fixes pgproxy target, DNS, and consumer
# containers immediately. Replaces the unreliable signal-file mechanism.
#
# This script is IDEMPOTENT — if everything is already correct, it does nothing.
# ==========================================================================

set -euo pipefail

# Concurrency guard — only one invocation at a time.
# The timer fires every ~30s; a single run can exceed that when PowerDNS or
# services are slow to restart. Two concurrent runs race on pgproxy-target
# and on service restart cycles.
exec 9>/var/run/pg-role-watchdog.lock
flock -n 9 || exit 0

# Self-heal: ensure our timer is enabled and running
if ! systemctl is-active pg-role-watchdog.timer &>/dev/null; then
  systemctl start pg-role-watchdog.timer 2>/dev/null || true
fi

PGPROXY_TARGET_FILE="/opt/postgresql/pgproxy-target"
PEER_NAME="{{ groups['dns_servers'] | difference([inventory_hostname]) | first }}"
LOCAL_TARGET="postgresql"   # Docker DNS name for local PG (primary)
REMOTE_TARGET="$PEER_NAME"  # Hostname mapped via extra_hosts to peer WireGuard IP

# Check if PG container is running and healthy
PG_HEALTH=$(docker inspect postgresql --format "{% raw %}{{.State.Health.Status}}{% endraw %}" 2>/dev/null || echo "missing")
if [ "$PG_HEALTH" != "healthy" ]; then
  exit 0  # PG not ready, skip this cycle
fi

# Get current PG role
PG_ROLE=$(docker exec postgresql psql -U postgres -tAc "SELECT pg_is_in_recovery();" 2>/dev/null || echo "error")
if [ "$PG_ROLE" = "error" ]; then
  exit 0  # Can't query PG, skip this cycle
fi

# Determine correct target
if [ "$PG_ROLE" = "f" ]; then
  CORRECT_TARGET="$LOCAL_TARGET"
  DNS_MODE="primary-only"
else
  CORRECT_TARGET="$REMOTE_TARGET"
  DNS_MODE="drain-self"
fi

# Read current target
CURRENT_TARGET=$(cat "$PGPROXY_TARGET_FILE" 2>/dev/null || echo "")

# Check if DNS also points to the right node
if [ "$PG_ROLE" = "f" ]; then
  # Primary node — DNS should contain our public IP
  EXPECTED_IP="{{ ansible_host }}"
  CURRENT_DNS=$(dig +short {{ platform_domain }} A @{{ ansible_host }} +time=3 +tries=1 2>/dev/null | head -1 || true)
  if [ -z "$CURRENT_DNS" ]; then
    DNS_OK=true  # DNS unreachable (PowerDNS restarting) — don't trigger false failover
  elif [ "$CURRENT_DNS" = "$EXPECTED_IP" ]; then
    DNS_OK=true
  else
    DNS_OK=false
  fi
else
  DNS_OK=true  # Standby doesn't own DNS
fi

# Push PG role to Gatus — green when node is in its expected role.
# Preferred primary ({{ postgresql_primary_node | default('ns1') }}) pushes to "Role: Primary" (green = is primary).
# Other node pushes to "Role: Standby" (green = is standby).
GATUS_TOKEN=$(cat /etc/gatus-token 2>/dev/null || true)
if [ -n "$GATUS_TOKEN" ]; then
{% if inventory_hostname == (postgresql_primary_node | default('ns1')) %}
  # This is the preferred primary — green when actually primary
  ROLE_OK=$( [ "$PG_ROLE" = "f" ] && echo "true" || echo "false" )
  ROLE_ENDPOINT="role-primary"
{% else %}
  # This is the preferred standby — green when actually standby
  ROLE_OK=$( [ "$PG_ROLE" = "t" ] && echo "true" || echo "false" )
  ROLE_ENDPOINT="role-standby"
{% endif %}
  curl -fsS --max-time 3 -X POST \
    "http://127.0.0.1:8080/api/v1/endpoints/{{ inventory_hostname }}_${ROLE_ENDPOINT}/external?success=${ROLE_OK}" \
    -H "Authorization: Bearer ${GATUS_TOKEN}" \
    >/dev/null 2>&1 || true
fi

# Write-health probe — ensures every node's PG-Writable endpoint has known state.
# Primary: test actual INSERT; success=true iff writable.
# Standby: post success=true because the node is correctly in its expected role
# (read-only-by-design). Without this, the standby's PG-Writable endpoint goes
# DISCONNECTED in Gatus because nothing ever pushes to it.
if [ "$PG_ROLE" = "f" ]; then
  docker exec postgresql psql -U postgres -qc "CREATE TABLE IF NOT EXISTS _watchdog_heartbeat(id int PRIMARY KEY DEFAULT 1 CHECK(id=1), ts timestamptz NOT NULL)" 2>/dev/null || true
  if docker exec postgresql psql -U postgres -qc "INSERT INTO _watchdog_heartbeat VALUES(1,now()) ON CONFLICT(id) DO UPDATE SET ts=now()" 2>/dev/null; then
    GATUS_SUCCESS=true
  else
    GATUS_SUCCESS=false
    echo "$(date): WARNING — Primary cannot write to PostgreSQL (disk full / read-only?)"
  fi
else
  # Standby in its expected state — node-is-healthy signal.
  GATUS_SUCCESS=true
fi
if [ -n "$GATUS_TOKEN" ]; then
  curl -fsS --max-time 3 -X POST \
    "http://127.0.0.1:8080/api/v1/endpoints/{{ inventory_hostname }}_pg-writable/external?success=${GATUS_SUCCESS}" \
    -H "Authorization: Bearer ${GATUS_TOKEN}" \
    >/dev/null 2>&1 || true
fi

# Decompose the cascade: pgproxy-target change vs. DNS-only drift.
# Previously, any DNS mismatch re-triggered the full cascade (service restarts +
# netbird restart) every cycle while DNS stayed bad, causing continuous flapping.
PGPROXY_NEEDS_UPDATE=false
[ "$CORRECT_TARGET" != "$CURRENT_TARGET" ] && PGPROXY_NEEDS_UPDATE=true

DNS_NEEDS_UPDATE=false
[ "$DNS_OK" != "true" ] && DNS_NEEDS_UPDATE=true

if ! $PGPROXY_NEEDS_UPDATE && ! $DNS_NEEDS_UPDATE; then
  exit 0  # Everything already correct
fi

# === Branch A: pgproxy target changed → role transition, full cascade ===
if $PGPROXY_NEEDS_UPDATE; then
  echo "$(date): PG role change detected (recovery=$PG_ROLE). Fixing pgproxy: $CURRENT_TARGET → $CORRECT_TARGET"

  # 1. Update pgproxy target
  echo "$CORRECT_TARGET" > "$PGPROXY_TARGET_FILE"

  # 2. Wait for pgproxy to pick up new target (self-updating every 5s)
  sleep 7

  # 3. Restart PG-dependent services (they need fresh connections via new pgproxy target)
  if ! docker restart powerdns-auth powerdns-nginx gatus netbird-server zitadel --timeout 5 2>&1; then
    echo "$(date): WARNING — one or more service restarts failed after PG role change"
  fi

  # 4. Restart NetBird peer client — forces reconnection to the current primary's signal
  #    server. Without this, the peer holds a stale gRPC connection (gotcha 136).
  #    ONLY runs when the role actually transitioned — not on every DNS-retry cycle.
  if systemctl is-active netbird &>/dev/null; then
    echo "$(date): Restarting NetBird peer client (force signal server reconnection)"
    systemctl restart netbird 2>&1 || echo "$(date): WARNING — NetBird peer restart failed"
  fi

  # 5. Wait for PowerDNS to be healthy (needed for DNS switch API call)
  for _i in $(seq 1 12); do
    PDNS_HEALTH=$(docker inspect powerdns-auth --format "{% raw %}{{.State.Health.Status}}{% endraw %}" 2>/dev/null || echo "")
    [ "$PDNS_HEALTH" = "healthy" ] && break
    sleep 5
  done

  # 6. NetBird signal-state is in-memory and lost on every netbird-server
  #    restart. Our local peer client recovers via the systemctl restart
  #    above, but external customer peers can be stuck on stale signal
  #    sessions. Fire a background script that pings each peer's NetBird
  #    IP — best-effort ICE re-negotiation. Stale peers get reported via
  #    Gatus alert. See AGENTS.md gotcha (NetBird peer wake-up).
  ( /usr/local/bin/netbird-peer-wakeup.sh >/dev/null 2>&1 &) || true
fi

# === Branch B: DNS drift (may run alone OR as a follow-up to branch A) ===
if $DNS_NEEDS_UPDATE; then
  for _i in 1 2 3; do
    /usr/local/bin/platform-dns-switch "$DNS_MODE" 2>&1 && break
    sleep 5
  done
fi

if $PGPROXY_NEEDS_UPDATE; then
  echo "$(date): Fixed. pgproxy=$CORRECT_TARGET, DNS=$DNS_MODE"
else
  echo "$(date): Fixed DNS only. DNS=$DNS_MODE (pgproxy already correct)"
fi
