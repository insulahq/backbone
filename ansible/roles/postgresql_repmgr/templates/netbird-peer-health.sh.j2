#!/bin/bash
# NetBird connectivity of THIS server — periodic (5 min timer).
#
# Reports whether the node's own NetBird client is attached to management and
# signal, as `netbird status` shows it. Other peers are deliberately not
# checked: end-user devices (laptops, phones, workstations) go offline all the
# time, and a reachability sweep cannot tell a switched-off laptop from a
# stranded peer — the old per-peer check stayed red for weeks over one closed
# laptop. Stranded external peers are handled client-side by the self-heal
# guard (netbird-selfheal.timer) and server-side by the watchdog's post-
# transition connection sweep (gotcha 150).

set -euo pipefail
source /usr/local/lib/platform-alert.sh 2>/dev/null || platform_alert() { echo "[alert:$1] [$2] $3"; }

ALERT_NAME="NetBird-Connected"

STATUS_OUT=$(timeout 20 netbird status 2>&1 || true)
MGMT=$(printf '%s\n' "$STATUS_OUT" | sed -n 's/^Management: //p' | head -1)
SIGNAL=$(printf '%s\n' "$STATUS_OUT" | sed -n 's/^Signal: //p' | head -1)
RELAYS=$(printf '%s\n' "$STATUS_OUT" | sed -n 's/^Relays: //p' | head -1)

SUMMARY="management: ${MGMT:-unknown}, signal: ${SIGNAL:-unknown}, relays: ${RELAYS:-unknown}"

if [ "$MGMT" = "Connected" ] && [ "$SIGNAL" = "Connected" ]; then
  platform_alert "info" "$ALERT_NAME" "NetBird on {{ inventory_hostname }} connected ($SUMMARY)"
else
  # No Management line at all means the daemon itself did not answer.
  [ -z "$MGMT" ] && SUMMARY="netbird status: $(printf '%s' "$STATUS_OUT" | head -1)"
  platform_alert "warning" "$ALERT_NAME" "NetBird on {{ inventory_hostname }} is not connected ($SUMMARY). The self-heal guard restarts the engine after ~6 min of disconnects; see 'journalctl -u netbird-selfheal'."
fi
