#!/bin/bash
# NetBird peer wake-up — best-effort tunnel re-negotiation post-failover.
# Called by pg-role-watchdog AFTER it restarts netbird-server, to nudge
# external peers' ICE state from our side. NetBird signal-server state is
# in-memory and lost on every netbird-server restart (gotcha #136 / #148).
# Best-effort — peers behind symmetric NAT or with truly stale signal
# sessions still need a manual `netbird down/up` on their machine.

set -euo pipefail
source /usr/local/lib/platform-alert.sh 2>/dev/null || platform_alert() { echo "[alert:$1] [$2] $3"; }

ALERT_NAME="NetBird-Mesh-Peers-Healthy"
WAIT_SECS={{ netbird_peer_wakeup_wait_secs | default(60) }}

sleep "$WAIT_SECS"

PEER_IPS=$(netbird status --json 2>/dev/null \
  | python3 -c "import json,sys; d=json.load(sys.stdin); print('\n'.join(p['netbirdIp'] for p in d.get('peers', {}).get('details', []) if p.get('netbirdIp')))" \
  2>/dev/null || true)

if [ -z "$PEER_IPS" ]; then
  echo "$(date): netbird-peer-wakeup: no peers visible, skipping"
  exit 0
fi

STALE_COUNT=0
STALE_LIST=""
for ip in $PEER_IPS; do
  if ! ping -c 1 -W 3 "$ip" >/dev/null 2>&1; then
    STALE_COUNT=$((STALE_COUNT + 1))
    STALE_LIST="$STALE_LIST $ip"
  fi
done

sleep 5
{% raw %}AFTER=$(netbird status 2>/dev/null | grep -E "^Peers count:" | awk '{print $3}' | head -1 || echo "?"){% endraw %}

echo "$(date): netbird-peer-wakeup: post-count=$AFTER stale=$STALE_COUNT (${STALE_LIST# })"

if [ "$STALE_COUNT" -gt 0 ]; then
  platform_alert "warning" "$ALERT_NAME" "$STALE_COUNT NetBird peers stale post-failover:${STALE_LIST} — owners must run 'netbird down && netbird up'"
else
  platform_alert "info" "$ALERT_NAME" "All NetBird peers reachable post-failover (count: $AFTER)"
fi
