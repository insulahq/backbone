# Watches for the restart-consumers signal file from the PG entrypoint-wrapper.
# When PG writes container names to this file (after failover/failback),
# the companion .service restarts those containers and cleans up.
[Unit]
Description=Watch for PostgreSQL consumer restart signal
After=docker.service

[Path]
PathModified=/opt/postgresql/signals/restart-consumers
MakeDirectory=yes

[Install]
WantedBy=multi-user.target
