#!/bin/bash
# ==========================================================================
# PostgreSQL HA Entrypoint Wrapper — Rock-Solid Failover & Failback
# ==========================================================================
#
# Replaces the sourcemation/postgres-repmgr default entrypoint with
# split-brain-safe startup logic, automatic failback via pg_rewind,
# and a runtime watchdog that detects and resolves dual-primary states.
#
# Architecture:
#   2-node PostgreSQL cluster (ns1 + ns2) connected via WireGuard tunnel.
#   Docker extra_hosts maps each hostname: self → 127.0.0.1, peer → WireGuard IP.
#   repmgr conninfo uses the hostname, so:
#     - Self-registration connects locally (127.0.0.1)
#     - Peer monitoring resolves to the real WireGuard IP
#
# Failover flow:
#   1. Primary goes down
#   2. repmgrd on standby detects failure (6 × 10s = 60s)
#   3. promote-check validates external connectivity (prevents false promotion
#      during network partitions)
#   4. Standby promotes → new timeline
#   5. Old primary comes back
#   6. determine_role() queries peer → sees peer is primary → starts as standby
#   7. pg_rewind syncs diverged data (or full re-clone if WAL diverged too far)
#   8. Registers as standby, repmgrd resumes monitoring
#
# Split-brain prevention layers:
#   Layer 1 — Startup:   determine_role() always checks peer before choosing role
#   Layer 2 — Promotion: promote-check.sh validates external connectivity
#   Layer 3 — Runtime:   split_brain_watchdog detects dual-primary, lower timeline
#                         self-demotes (deterministic tiebreaker: REPMGR_INITIAL_ROLE)
#   Layer 4 — Demotion:  .demoted marker survives container restarts
#
# ==========================================================================

set -euo pipefail

export REPMGR_CONFIG_FILE="${REPMGR_CONFIG_FILE:-/etc/repmgr/repmgr.conf}"
export PGPASSWORD="${REPMGR_PASSWORD}"

PROMOTE_CHECK="/tmp/promote-check.sh"
DEMOTED_MARKER="${PGDATA}/.demoted"

# PIDs for signal handling
PG_PID=""
REPMGRD_PID=""
WATCHDOG_PID=""

# ==========================================================================
# Alerting — sends status to Gatus + fallback raw webhook
# ==========================================================================
# Inline implementation because this runs inside a Docker container
# (cannot source the host's platform-alert.sh library).
# Uses env vars from docker-compose: ALERT_WEBHOOK_URL
# Gatus alerting handled by host-side pg-role-watchdog (not inside container).
send_alert() {
  local level="$1"   # info | warning | critical
  local message="$2"
  local timestamp
  timestamp="$(date -Iseconds 2>/dev/null || date)"

  echo "[${timestamp}] ALERT ${level}: [repmgr] ${message}"

  # Safely encode message for JSON using python3 (available in postgres image)
  local safe_msg
  safe_msg=$(printf '%s' "$message" | python3 -c "import sys,json; print(json.dumps(sys.stdin.read()))" 2>/dev/null || printf '"%s"' "$message")

  # Map level to Gatus success/failure
  local gatus_success="true"
  # Use if/then — set -e exits on failed [ ] || [ ] && pattern (gotcha 67)
  if [ "$level" = "warning" ] || [ "$level" = "critical" ]; then
    gatus_success="false"
  fi

  # Push to Gatus external endpoint (primary path)
  if [ -n "${GATUS_TOKEN:-}" ] && [ -n "${GATUS_URL:-}" ]; then
    local gatus_key="${NODE_NAME}_Repmgr%20Healthy"
    if command -v curl &>/dev/null; then
      curl -fsS --retry 2 --max-time 5 -X POST \
        "${GATUS_URL}/api/v1/endpoints/${gatus_key}/external?success=${gatus_success}" \
        -H "Authorization: Bearer ${GATUS_TOKEN}" \
        > /dev/null 2>&1 || true
    fi
  fi

  # Fallback: raw webhook (JSON body — values passed via env to avoid shell injection)
  if [ -n "${ALERT_WEBHOOK_URL:-}" ]; then
    if command -v curl &>/dev/null; then
      local json_body
      json_body=$(_WH="${NODE_NAME}" _WL="${level}" _WT="${timestamp}" \
        python3 -c "import sys,json,os; print(json.dumps({'host':os.environ['_WH'],'service':'Repmgr Healthy','level':os.environ['_WL'],'message':sys.stdin.read().strip(),'timestamp':os.environ['_WT']}))" \
        <<< "$message" 2>/dev/null || true)
      if [ -n "${json_body:-}" ]; then
        curl -fsS --retry 2 --max-time 10 -X POST \
          -H "Content-Type: application/json" \
          -d "$json_body" \
          "$ALERT_WEBHOOK_URL" > /dev/null 2>&1 || true
      fi
    fi
  fi
}

# ==========================================================================
# DNS switching — update PowerDNS A/AAAA records after failover
# ==========================================================================
# Delegates to /usr/local/bin/platform-dns-switch on the host (via nsenter).
# The script is deployed by the common Ansible role and reads its config from
# /etc/platform-dns-switch.env. Modes: primary-only (traffic to self), drain-self (traffic to peer).
  # DNS switching is handled by the pg-role-watchdog on the host.
  # No switch_dns() function needed in the entrypoint-wrapper.

  # NOTE: Consumer restarts (pgproxy, gatus, netbird, powerdns) are handled by
  # the pg-role-watchdog.timer on the host (runs every 10s, detects role changes,
  # fixes pgproxy + DNS + restarts consumers automatically). The entrypoint-wrapper
  # only manages PG startup/failover — it does NOT orchestrate other containers.

# ==========================================================================
# Signal handler — clean shutdown on SIGTERM/SIGINT (Docker stop)
# ==========================================================================
shutdown_handler() {
  echo "==> Received shutdown signal, stopping gracefully..."
  [ -n "$WATCHDOG_PID" ] && kill "$WATCHDOG_PID" 2>/dev/null || true
  [ -n "$REPMGRD_PID" ] && kill "$REPMGRD_PID" 2>/dev/null || true
  pg_ctl -D "$PGDATA" -m fast -w stop 2>/dev/null || true
  exit 0
}
trap shutdown_handler SIGTERM SIGINT

# ==========================================================================
# Phase 1: Stale file cleanup
# ==========================================================================
cleanup_stale_files() {
  # Leftover postmaster.pid (in volume) and socket lock files (in tmpfs)
  # after an unclean container stop prevent PostgreSQL from starting.
  if [ -f "${PGDATA}/postmaster.pid" ]; then
    echo "==> Removing stale postmaster.pid"
    rm -f "${PGDATA}/postmaster.pid"
  fi
  for f in /var/run/postgresql/.s.PGSQL.5432.lock \
           /var/run/postgresql/.s.PGSQL.5432 \
           /tmp/repmgrd.pid; do
    if [ -e "$f" ]; then
      echo "==> Removing stale $f"
      rm -f "$f"
    fi
  done
}

# ==========================================================================
# Phase 1b: Create .pgpass for password-free PG connections
# ==========================================================================
# Keeps passwords out of process arguments and postgresql.auto.conf.
create_pgpass() {
  local pgpass="/var/lib/postgresql/.pgpass"
  cat > "$pgpass" <<PGPASS
# hostname:port:database:username:password
*:5432:*:${REPMGR_USER}:${REPMGR_PASSWORD}
*:5432:*:${POSTGRES_USER}:${POSTGRES_PASSWORD}
PGPASS
  chmod 600 "$pgpass"
  export PGPASSFILE="$pgpass"
}

# ==========================================================================
# Phase 2: Create promotion validation script
# ==========================================================================
# Prevents false promotions during network partitions: if the standby loses
# its WireGuard tunnel to the primary but the primary is still running,
# promoting would create a split-brain. This script checks if the standby
# has external connectivity — if it can reach the internet but not the
# primary, the primary is truly down and promotion is safe.
create_promote_check() {
  cat > "$PROMOTE_CHECK" <<'SCRIPT'
#!/bin/bash
# Validate external connectivity before allowing repmgrd to promote.
# Called by repmgr failover_validation_command.
# IMPORTANT: This script must be lightweight and exit cleanly (0=allow, 1=deny).
# All pgproxy/DNS/consumer restart logic is in post-promote.sh (called after promotion).
CHECKS=0
for target in 8.8.8.8 1.1.1.1 2001:4860:4860::8888 2606:4700:4700::1111; do
  if timeout 3 bash -c "echo >/dev/tcp/$target/53" 2>/dev/null; then
    CHECKS=$((CHECKS + 1))
  fi
done
if [ "$CHECKS" -eq 0 ]; then
  echo "PROMOTE CHECK FAILED: No external connectivity — refusing promotion" >&2
  exit 1
fi
echo "PROMOTE CHECK PASSED: External connectivity confirmed, primary is truly unreachable" >&2
exit 0
SCRIPT
  chmod +x "$PROMOTE_CHECK"
}

# ==========================================================================
# Phase 2b: Generate post-promote script (runs AFTER successful promotion)
# ==========================================================================
create_post_promote() {
  # Post-promote: update pgproxy target immediately after promotion.
  # The pg-role-watchdog on the host handles DNS switch + consumer restarts
  # within 10s of detecting the role change.
  cat > /tmp/post-promote.sh <<'SCRIPT'
#!/bin/bash
echo "POST-PROMOTE: $(date) — Updating pgproxy target to local"
echo "postgresql" > /opt/postgresql/pgproxy-target
echo "POST-PROMOTE: Done. Watchdog will handle DNS + consumer restarts."
SCRIPT
  chmod +x /tmp/post-promote.sh

  # promote_command wrapper: promote then update pgproxy target
  cat > /tmp/promote-and-update.sh <<PROMOTE_SCRIPT
#!/bin/bash
exec >> /proc/1/fd/1 2>&1
echo "\$(date): Promoting..."
$(which repmgr) standby promote -f ${REPMGR_CONFIG_FILE} --log-to-file
RESULT=\$?
if [ \$RESULT -eq 0 ]; then
  /tmp/post-promote.sh
fi
exit \$RESULT
PROMOTE_SCRIPT
  chmod +x /tmp/promote-and-update.sh
}

# ==========================================================================
# Phase 3: Generate repmgr.conf
# ==========================================================================
generate_repmgr_config() {
  mkdir -p "$(dirname "$REPMGR_CONFIG_FILE")"
  cat > "${REPMGR_CONFIG_FILE}" <<EOF
# repmgr configuration — generated by entrypoint-wrapper.sh
node_id=${NODE_ID}
node_name=${NODE_NAME}

# conninfo uses NODE_NAME (hostname). Docker extra_hosts maps:
#   self → 127.0.0.1 (local connect for self-registration)
#   peer → WireGuard IP (cross-node failover detection)
conninfo='host=${NODE_NAME} dbname=${REPMGR_DB} user=${REPMGR_USER} connect_timeout=5'
data_directory='${PGDATA}'

# Automatic failover with promotion validation
failover=automatic
promote_command='/tmp/promote-and-update.sh'
follow_command='$(which repmgr) standby follow -f ${REPMGR_CONFIG_FILE} --log-to-file --upstream-node-id %n'

# Detection window: 6 × 10s = 60s before declaring primary dead
reconnect_attempts=6
reconnect_interval=10

# Validate external connectivity before promoting (split-brain prevention)
failover_validation_command='${PROMOTE_CHECK}'

# Extra safety window after all reconnect attempts fail
promote_delay=10

log_level=INFO
EOF
}

# ==========================================================================
# Phase 4: Determine actual role (CRITICAL — prevents split-brain)
# ==========================================================================
# On first boot (empty PGDATA), uses REPMGR_INITIAL_ROLE.
# On subsequent boots, detects actual cluster state:
#   1. Check .demoted marker (from previous split-brain recovery)
#   2. Query peer: if peer is primary → we're standby
#   3. If peer unreachable: use timeline comparison
#      - Higher timeline = was promoted = should be primary
#      - Lower/equal timeline + initial_role=primary = wait for peer (90s)
#        to avoid split-brain during simultaneous restart after failover
determine_role() {
  # --- Check 1: Demotion marker from split-brain recovery ---
  if [ -f "$DEMOTED_MARKER" ]; then
    echo "==> Found demotion marker from split-brain recovery — forcing STANDBY" >&2
    rm -f "$DEMOTED_MARKER"
    echo "standby"
    return
  fi

  # --- Check 2: First boot (empty data directory) ---
  if [ ! -s "$PGDATA/PG_VERSION" ]; then
    echo "==> Fresh data directory — using initial role: $REPMGR_INITIAL_ROLE" >&2
    echo "$REPMGR_INITIAL_ROLE"
    return
  fi

  # --- Check 3: Existing data — detect actual cluster state ---
  local local_timeline
  local_timeline=$(pg_controldata "$PGDATA" 2>/dev/null \
    | grep "Latest checkpoint's TimeLineID" | awk '{print $NF}')
  if [ -z "$local_timeline" ]; then
    echo "==> WARNING: Cannot read pg_controldata — data may be corrupt" >&2
    echo "==> Falling back to initial role: $REPMGR_INITIAL_ROLE" >&2
    echo "$REPMGR_INITIAL_ROLE"
    return
  fi

  local db_state
  db_state=$(pg_controldata "$PGDATA" 2>/dev/null \
    | grep "Database cluster state" | sed 's/.*: *//')

  # Was this node a standby? (check cluster state from pg_controldata)
  local was_standby=false
  case "$db_state" in
    *"in archive recovery"*|*"shut down in recovery"*)
      was_standby=true ;;
  esac

  echo "==> Local state: timeline=$local_timeline, db_state='$db_state', was_standby=$was_standby" >&2

  # --- Check 4: Query peer ---
  echo "==> Checking peer ($PEER_NAME)..." >&2
  local peer_reachable=false
  local peer_is_primary=false

  for attempt in 1 2 3; do
    if pg_isready -h "$PEER_NAME" -p 5432 -t 5 >/dev/null 2>&1; then
      peer_reachable=true
      break
    fi
    if [ "$attempt" -lt 3 ]; then
      echo "==> Peer not ready (attempt $attempt/3)..." >&2; sleep 5
    fi
  done

  if $peer_reachable; then
    local peer_recovery
    peer_recovery=$(psql -h "$PEER_NAME" -U "$REPMGR_USER" -d "$REPMGR_DB" \
      -tAc "SELECT pg_is_in_recovery()" 2>/dev/null || echo "error")

    if [ "$peer_recovery" = "f" ]; then
      peer_is_primary=true
      echo "==> Peer ($PEER_NAME) is running as PRIMARY" >&2
    elif [ "$peer_recovery" = "t" ]; then
      echo "==> Peer ($PEER_NAME) is running as STANDBY" >&2
    else
      echo "==> Cannot determine peer role (result: $peer_recovery)" >&2
    fi
  else
    echo "==> Peer ($PEER_NAME) is UNREACHABLE" >&2
  fi

  # --- Decision matrix ---

  if $peer_reachable && $peer_is_primary; then
    # Peer is primary → we must be standby (regardless of what we were)
    echo "==> Decision: STANDBY (peer is primary)" >&2
    echo "standby"
    return
  fi

  if $peer_reachable && ! $peer_is_primary; then
    # Peer is standby or unknown → we should be primary
    echo "==> Decision: PRIMARY (peer is standby or undetermined)" >&2
    echo "primary"
    return
  fi

  # --- Peer unreachable: use timeline + state to decide ---

  if $was_standby; then
    # We were a standby — stay standby, let repmgrd promote if needed
    echo "==> Decision: STANDBY (was standby, peer unreachable — repmgrd will promote if needed)" >&2
    echo "standby"
    return
  fi

  # We were NOT a standby (no standby.signal, primary-like state)
  if [ "$local_timeline" -gt 1 ] 2>/dev/null; then
    # Timeline > 1 = we were promoted at some point → we're the valid primary
    echo "==> Decision: PRIMARY (was promoted, timeline=$local_timeline > 1)" >&2
    echo "primary"
    return
  fi

  # Timeline = 1, was primary, peer unreachable
  # This is the dangerous case: could be the original primary that was
  # superseded by a promotion on the peer. If both nodes restart
  # simultaneously after a failover, the peer (promoted, TL>1) should
  # win. We wait to give the peer time to start and identify itself.
  echo "==> Timeline=1, initial primary, peer unreachable — waiting for peer before deciding..." >&2
  for i in $(seq 1 18); do  # 18 × 5s = 90s
    if pg_isready -h "$PEER_NAME" -p 5432 -t 5 >/dev/null 2>&1; then
      local pr
      pr=$(psql -h "$PEER_NAME" -U "$REPMGR_USER" -d "$REPMGR_DB" \
        -tAc "SELECT pg_is_in_recovery()" 2>/dev/null || echo "error")
      if [ "$pr" = "f" ]; then
        echo "==> Peer came up as PRIMARY — Decision: STANDBY" >&2
        echo "standby"
        return
      else
        echo "==> Peer came up as STANDBY — Decision: PRIMARY" >&2
        echo "primary"
        return
      fi
    fi
    echo "==> Waiting for peer ($i/18)..." >&2
    sleep 5
  done

  # Peer never appeared after 90s — start as primary (best effort)
  echo "==> Peer did not appear after 90s — Decision: PRIMARY (initial role, no peer)" >&2
  echo "primary"
}

# ==========================================================================
# Phase 5a: Initialize fresh primary
# ==========================================================================
init_primary() {
  echo "==> Initializing new primary node..."
  initdb -U "$POSTGRES_USER" -D "$PGDATA"

  # Network, WAL, replication, and performance settings
  cat >> "$PGDATA/postgresql.conf" <<CONF
# Listen on all interfaces inside the container — required for Docker port
# forwarding and cross-node replication. Without this, PG defaults to
# 'localhost' and rejects all network connections (gotcha 80).
listen_addresses = '*'

shared_preload_libraries = 'repmgr'

# WAL and replication
wal_level = replica
wal_log_hints = on
max_wal_senders = 10
max_replication_slots = 10
hot_standby = on
archive_mode = on
archive_command = '/bin/true'

# WAL size and checkpoint tuning
max_wal_size = '{{ postgresql_max_wal_size }}'
min_wal_size = '{{ postgresql_min_wal_size }}'
# CRITICAL: Cap WAL retained by replication slots. Without this, an offline
# standby causes unbounded WAL growth on primary until disk fills.
# Standby must re-clone if it falls behind this limit.
max_slot_wal_keep_size = '{{ postgresql_max_slot_wal_keep_size }}'

# Memory tuning
shared_buffers = '{{ postgresql_shared_buffers }}'
work_mem = '{{ postgresql_work_mem }}'
maintenance_work_mem = '{{ postgresql_maintenance_work_mem }}'

# Autovacuum tuning (more aggressive for event-sourced workloads like Zitadel)
autovacuum_vacuum_scale_factor = {{ postgresql_autovacuum_vacuum_scale_factor }}
autovacuum_analyze_scale_factor = {{ postgresql_autovacuum_analyze_scale_factor }}
autovacuum_max_workers = {{ postgresql_autovacuum_max_workers }}
autovacuum_naptime = '{{ postgresql_autovacuum_naptime }}'
CONF

  # pg_hba.conf — replication + app access
  cat >> "$PGDATA/pg_hba.conf" <<HBA
host replication ${REPMGR_USER} all scram-sha-256
host ${REPMGR_DB} ${REPMGR_USER} all scram-sha-256
host all all 172.16.0.0/12 scram-sha-256
host all all 10.0.0.0/8 scram-sha-256
host all all 100.64.0.0/10 scram-sha-256
host all all fd00::/8 scram-sha-256
HBA

  pg_ctl -D "$PGDATA" -w start
  # Set superuser password — required for scram-sha-256 auth from Docker
  # bridge networks. Without this, any network connection as 'postgres' fails
  # because pg_hba.conf requires scram-sha-256 but no password hash exists (gotcha 81).
  psql -U postgres -c "ALTER USER postgres WITH PASSWORD '${POSTGRES_PASSWORD}'"
  createuser --superuser --login "$REPMGR_USER"
  psql -U postgres -c "ALTER USER ${REPMGR_USER} WITH PASSWORD '${REPMGR_PASSWORD}'"
  createdb --owner="$REPMGR_USER" "$REPMGR_DB"
  pg_ctl -D "$PGDATA" -m fast -w stop
  echo "==> Primary initialized"
}

# ==========================================================================
# Phase 5b: Start as primary
# ==========================================================================
start_as_primary() {
  if [ ! -s "$PGDATA/PG_VERSION" ]; then
    init_primary
  fi

  # Ensure no standby.signal (we're primary)
  rm -f "$PGDATA/standby.signal"

  echo "==> Starting PostgreSQL as PRIMARY..."
  postgres -D "$PGDATA" &
  PG_PID=$!
  until pg_isready -q; do sleep 1; done

  send_alert "info" "PostgreSQL started as PRIMARY on ${NODE_NAME}"

  # Update pgproxy target — the pg-role-watchdog on the host will detect the
  # role change within 10s and handle DNS switch + consumer restarts.
  echo "postgresql" > /opt/postgresql/pgproxy-target

  echo "==> Registering as primary (--force for idempotency)..."
  repmgr -f "$REPMGR_CONFIG_FILE" primary register --force 2>&1 || {
    echo "==> Primary registration returned non-zero (may already be registered)"
  }

  # Start split-brain watchdog in background
  split_brain_watchdog &
  WATCHDOG_PID=$!

  echo "==> Starting repmgrd (foreground)..."
  repmgrd -f "$REPMGR_CONFIG_FILE" --daemonize=false &
  REPMGRD_PID=$!

  # Block until repmgrd exits (or signal handler fires)
  wait "$REPMGRD_PID" 2>/dev/null || true
}

# ==========================================================================
# Phase 5c: Start as standby (includes failback / rejoin logic)
# ==========================================================================
start_as_standby() {
  # Wait for the primary to be available (max 5 minutes)
  local max_wait=300
  local waited=0
  echo "==> Waiting for primary ($PEER_NAME) — timeout ${max_wait}s..."
  until pg_isready -h "$PEER_NAME" -p 5432 -t 5 2>/dev/null; do
    waited=$((waited + 5))
    if [ "$waited" -ge "$max_wait" ]; then
      echo "==> Primary ($PEER_NAME) did not become ready after ${max_wait}s" >&2
      echo "==> SELF-PROMOTING: standby taking over as primary (peer permanently gone)" >&2
      send_alert "warning" "Standby ${NODE_NAME} self-promoting after ${max_wait}s — primary ${PEER_NAME} unreachable"
      # Remove standby.signal so PG starts as primary
      rm -f "$PGDATA/standby.signal"
      start_as_primary
      return
    fi
    echo "==> Primary ($PEER_NAME) unavailable — retrying in 5s... (${waited}/${max_wait}s)"
    sleep 5
  done
  echo "==> Primary ($PEER_NAME) is ready"

  if [ ! -s "$PGDATA/PG_VERSION" ]; then
    # --- Fresh standby: clone from primary ---
    echo "==> Cloning from primary ($PEER_NAME)..."
    repmgr -h "$PEER_NAME" -U "$REPMGR_USER" -d "$REPMGR_DB" \
           -f "$REPMGR_CONFIG_FILE" standby clone
    echo "==> Clone complete"

  elif [ ! -f "$PGDATA/standby.signal" ]; then
    # --- FAILBACK: This node was primary but peer has been promoted ---
    # Data has diverged — use pg_rewind to sync, or full re-clone as fallback
    echo "==> FAILBACK DETECTED: This node was primary, peer has been promoted"
    send_alert "warning" "FAILBACK: ${NODE_NAME} was primary, rejoining as standby of ${PEER_NAME}"
    echo "==> Running pg_rewind to sync with new primary ($PEER_NAME)..."

    # pg_rewind needs the target stopped
    pg_ctl -D "$PGDATA" -m fast stop 2>/dev/null || true

    if pg_rewind --target-pgdata="$PGDATA" \
         --source-server="host=$PEER_NAME user=$REPMGR_USER dbname=$REPMGR_DB" \
         2>&1; then
      echo "==> pg_rewind succeeded"
    else
      echo "==> pg_rewind failed — falling back to full re-clone..."
      rm -rf "${PGDATA:?}"/*
      repmgr -h "$PEER_NAME" -U "$REPMGR_USER" -d "$REPMGR_DB" \
             -f "$REPMGR_CONFIG_FILE" standby clone
    fi

    # Configure as standby
    touch "$PGDATA/standby.signal"
    sed -i "/^primary_conninfo/d" "$PGDATA/postgresql.auto.conf" 2>/dev/null || true
    echo "primary_conninfo = 'host=$PEER_NAME user=$REPMGR_USER application_name=$NODE_NAME'" \
      >> "$PGDATA/postgresql.auto.conf"
    echo "==> Failback preparation complete"

  else
    # --- Already a standby: update primary_conninfo ---
    # The primary hostname might have changed after a double-failover
    sed -i "/^primary_conninfo/d" "$PGDATA/postgresql.auto.conf" 2>/dev/null || true
    echo "primary_conninfo = 'host=$PEER_NAME user=$REPMGR_USER application_name=$NODE_NAME'" \
      >> "$PGDATA/postgresql.auto.conf"
  fi

  RECLONED=false

  echo "==> Starting PostgreSQL as STANDBY..."
  postgres -D "$PGDATA" &
  PG_PID=$!

  # Wait for PG to accept connections with startup timeout.
  # If PG gets stuck in startup replay (WAL gap — segments removed on primary),
  # it never reaches "accepting connections". Detect and re-clone.
  STARTUP_WAIT=0
  STARTUP_MAX=90
  while ! pg_isready -q 2>/dev/null; do
    sleep 1
    STARTUP_WAIT=$((STARTUP_WAIT + 1))
    if [ "$STARTUP_WAIT" -ge "$STARTUP_MAX" ]; then
      # Check if PG is stuck replaying removed WAL (look in PG logs or container stderr)
      if grep -q "has already been removed" "$PGDATA"/log/postgresql*.log 2>/dev/null || \
         grep -q "has already been removed" /proc/$PG_PID/fd/2 2>/dev/null; then
        echo "==> STARTUP TIMEOUT: WAL segment removed on primary — performing full re-clone..."
        send_alert "warning" "WAL gap on ${NODE_NAME}: standby stuck in startup, performing full re-clone"
        kill "$PG_PID" 2>/dev/null || true
        wait "$PG_PID" 2>/dev/null || true
        pg_ctl -D "$PGDATA" -m immediate stop 2>/dev/null || true
        rm -rf "${PGDATA:?}"/*
        repmgr -h "$PEER_NAME" -U "$REPMGR_USER" -d "$REPMGR_DB" \
               -f "$REPMGR_CONFIG_FILE" standby clone
        sed -i "/^primary_conninfo/d" "$PGDATA/postgresql.auto.conf" 2>/dev/null || true
        echo "primary_conninfo = 'host=$PEER_NAME user=$REPMGR_USER application_name=$NODE_NAME'" \
          >> "$PGDATA/postgresql.auto.conf"
        echo "==> Re-clone complete, restarting..."
        RECLONED=true
        postgres -D "$PGDATA" &
        PG_PID=$!
        until pg_isready -q; do sleep 1; done
        break
      else
        echo "==> STARTUP TIMEOUT: PG not ready after ${STARTUP_MAX}s (no WAL gap detected — continuing to wait)"
        # Don't re-clone if it's just slow startup, keep waiting
      fi
    fi
  done

  # Verify WAL streaming is working (skip if we just re-cloned — fresh clone is clean).
  # If WAL segments were removed on the primary (max_slot_wal_keep_size exceeded),
  # the standby will fail to stream indefinitely.
  # Poll with timeout — transient states (startup, catchup) are healthy and expected.
  if [ "$RECLONED" = true ]; then
    echo "==> Skipping WAL verification (fresh re-clone)"
  else
  echo "==> Verifying WAL streaming health (polling up to 60s)..."
  WAL_STATUS=""
  WAL_OK=false
  for _i in $(seq 1 12); do
    WAL_STATUS=$(psql -U postgres -tAc "SELECT status FROM pg_stat_wal_receiver" 2>/dev/null || echo "")
    if [ "$WAL_STATUS" = "streaming" ]; then
      WAL_OK=true
      break
    fi
    # startup/catchup are healthy transient states — keep waiting
    if [ "$WAL_STATUS" = "startup" ] || [ "$WAL_STATUS" = "catchup" ] || [ -z "$WAL_STATUS" ]; then
      echo "==> WAL receiver in transient state ('${WAL_STATUS}'), waiting... ($_i/12)"
      sleep 5
      continue
    fi
    # Any other status (stopped, unexpected) — check for WAL gap
    break
  done

  if [ "$WAL_OK" = true ]; then
    echo "==> WAL streaming confirmed"
  else
    # Confirm WAL gap by checking WAL receiver status
    WAL_GAP_DETECTED=false
    # Check WAL receiver status via SQL (docker CLI not available in this container)
    if psql -U postgres -tAc "SELECT 1" >/dev/null 2>&1; then
      # If WAL receiver exists but status is not streaming/startup/catchup after 60s polling,
      # and we got here (broke out of the poll loop), it's a confirmed gap.
      # Also check if the receiver has stopped entirely (no rows in pg_stat_wal_receiver)
      WAL_RECV_COUNT=$(psql -U postgres -tAc "SELECT COUNT(*) FROM pg_stat_wal_receiver" 2>/dev/null || echo "0")
      if [ "${WAL_RECV_COUNT:-0}" -eq 0 ] && [ -n "$WAL_STATUS" ]; then
        # WAL receiver gave up — confirmed gap
        WAL_GAP_DETECTED=true
      elif [ "$WAL_STATUS" != "streaming" ] && [ "$WAL_STATUS" != "startup" ] && [ "$WAL_STATUS" != "catchup" ] && [ -n "$WAL_STATUS" ]; then
        WAL_GAP_DETECTED=true
      fi
    fi

    if [ "$WAL_GAP_DETECTED" = true ]; then
      echo "==> WAL gap confirmed — stopping PG and performing full re-clone..."
      send_alert "warning" "WAL gap on ${NODE_NAME}: segments removed on primary, performing full re-clone"
      pg_ctl -D "$PGDATA" -m fast -w stop 2>/dev/null || true
      kill "$PG_PID" 2>/dev/null || true
      wait "$PG_PID" 2>/dev/null || true
      rm -rf "${PGDATA:?}"/*
      repmgr -h "$PEER_NAME" -U "$REPMGR_USER" -d "$REPMGR_DB" \
             -f "$REPMGR_CONFIG_FILE" standby clone
      # Restore primary_conninfo (may be stale after re-clone)
      sed -i "/^primary_conninfo/d" "$PGDATA/postgresql.auto.conf" 2>/dev/null || true
      echo "primary_conninfo = 'host=$PEER_NAME user=$REPMGR_USER application_name=$NODE_NAME'" \
        >> "$PGDATA/postgresql.auto.conf"
      echo "==> Re-clone complete, restarting..."
      postgres -D "$PGDATA" &
      PG_PID=$!
      until pg_isready -q; do sleep 1; done
    else
      echo "==> WAL receiver not streaming (status: '${WAL_STATUS}') but no gap detected — continuing"
    fi
  fi
  fi  # end RECLONED guard

  send_alert "info" "PostgreSQL started as STANDBY on ${NODE_NAME} (primary: ${PEER_NAME})"

  # Update pgproxy target — watchdog handles DNS + consumer restarts
  echo "${PEER_NAME}" > /opt/postgresql/pgproxy-target

  echo "==> Registering as standby (--force for idempotency)..."
  repmgr -f "$REPMGR_CONFIG_FILE" standby register --force 2>&1 || {
    echo "==> Standby registration returned non-zero (may already be registered)"
  }

  echo "==> Starting repmgrd (foreground)..."
  repmgrd -f "$REPMGR_CONFIG_FILE" --daemonize=false &
  REPMGRD_PID=$!

  wait "$REPMGRD_PID" 2>/dev/null || true
}

# ==========================================================================
# Split-brain watchdog (runs in background on primary)
# ==========================================================================
# Every 15 seconds, checks if the peer is ALSO running as primary.
# If dual-primary is detected:
#   - Compare timelines: higher timeline = was promoted more recently = real primary
#   - If same timeline: REPMGR_INITIAL_ROLE is the deterministic tiebreaker
#   - The loser self-demotes: writes .demoted marker and exits
#   - Docker restart policy restarts the container
#   - On restart, determine_role() sees .demoted → starts as standby
split_brain_watchdog() {
  sleep 30  # Initial settling period

  while true; do
    sleep 15

    # Only act if we're currently primary (not in recovery)
    local local_recovery
    local_recovery=$(psql -U "$REPMGR_USER" -d "$REPMGR_DB" \
      -tAc "SELECT pg_is_in_recovery()" 2>/dev/null || echo "error")
    [ "$local_recovery" != "f" ] && continue

    # Check if peer is reachable and also primary
    if ! pg_isready -h "$PEER_NAME" -p 5432 -t 3 2>/dev/null; then
      continue  # Peer unreachable — nothing to check
    fi

    local peer_recovery
    peer_recovery=$(psql -h "$PEER_NAME" -U "$REPMGR_USER" -d "$REPMGR_DB" \
      -tAc "SELECT pg_is_in_recovery()" 2>/dev/null || echo "error")

    if [ "$peer_recovery" != "f" ]; then
      continue  # Peer is standby or unknown — no split-brain
    fi

    # !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
    # SPLIT-BRAIN DETECTED: Both nodes are running as primary!
    # !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
    echo "!!! SPLIT-BRAIN DETECTED: Both ${NODE_NAME} and ${PEER_NAME} are PRIMARY !!!" >&2
    send_alert "critical" "SPLIT-BRAIN DETECTED: Both ${NODE_NAME} and ${PEER_NAME} are running as PRIMARY"

    local local_tl peer_tl
    local_tl=$(psql -U "$REPMGR_USER" -d "$REPMGR_DB" \
      -tAc "SELECT timeline_id FROM pg_control_checkpoint()" 2>/dev/null || echo "0")
    peer_tl=$(psql -h "$PEER_NAME" -U "$REPMGR_USER" -d "$REPMGR_DB" \
      -tAc "SELECT timeline_id FROM pg_control_checkpoint()" 2>/dev/null || echo "0")

    echo "!!! Local timeline: $local_tl | Peer timeline: $peer_tl !!!" >&2

    local should_demote=false

    if [ "$peer_tl" -gt "$local_tl" ] 2>/dev/null; then
      echo "!!! Peer has higher timeline — WE MUST DEMOTE !!!" >&2
      should_demote=true
    elif [ "$local_tl" -gt "$peer_tl" ] 2>/dev/null; then
      echo "!!! We have higher timeline — peer should demote (doing nothing) !!!" >&2
    else
      # Same timeline — use REPMGR_INITIAL_ROLE as deterministic tiebreaker
      # Only the node whose initial role was NOT primary will demote
      if [ "$REPMGR_INITIAL_ROLE" != "primary" ]; then
        echo "!!! Same timeline — we are NOT initial primary — WE MUST DEMOTE !!!" >&2
        should_demote=true
      else
        echo "!!! Same timeline — we ARE initial primary — peer should demote !!!" >&2
      fi
    fi

    if $should_demote; then
      self_demote
      return  # self_demote exits, but just in case
    fi
  done
}

# ==========================================================================
# Self-demotion (split-brain auto-recovery)
# ==========================================================================
# Writes a marker file, stops PostgreSQL, and exits the container.
# Docker's restart policy restarts us. On restart, determine_role()
# sees the .demoted marker → starts as standby with pg_rewind.
self_demote() {
  echo "==> SELF-DEMOTING: Writing demotion marker and shutting down..." >&2
  send_alert "critical" "SELF-DEMOTION: ${NODE_NAME} demoting from primary to standby (split-brain recovery)"
  touch "$DEMOTED_MARKER"

  # Stop PostgreSQL to prevent further writes
  pg_ctl -D "$PGDATA" -m fast -w stop 2>/dev/null || true

  # Kill repmgrd
  [ -n "$REPMGRD_PID" ] && kill "$REPMGRD_PID" 2>/dev/null || true

  # Update pgproxy target — watchdog handles DNS + consumer restarts
  echo "${PEER_NAME}" > /opt/postgresql/pgproxy-target

  echo "==> Container will restart and rejoin as standby" >&2
  exit 1
}

# ==========================================================================
# Main
# ==========================================================================
echo "============================================================"
echo "  PostgreSQL HA Entrypoint — ${NODE_NAME} (node ${NODE_ID})"
echo "  Initial role: ${REPMGR_INITIAL_ROLE} | Peer: ${PEER_NAME}"
echo "============================================================"

cleanup_stale_files
create_pgpass
create_promote_check
create_post_promote
generate_repmgr_config

ACTUAL_ROLE=$(determine_role)

echo "============================================================"
echo "  RESOLVED ROLE: ${ACTUAL_ROLE}"
echo "  (initial: ${REPMGR_INITIAL_ROLE}, peer: ${PEER_NAME})"
echo "============================================================"

case "$ACTUAL_ROLE" in
  primary) start_as_primary ;;
  standby) start_as_standby ;;
  *)
    echo "FATAL: Could not determine role — exiting" >&2
    exit 1
    ;;
esac
