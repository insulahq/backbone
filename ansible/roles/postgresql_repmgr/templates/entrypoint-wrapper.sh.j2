#!/bin/bash
# Wrapper around sourcemation/postgres-repmgr entrypoint.sh
# Patches repmgr registration to be idempotent (handles 'already registered' gracefully)
# and runs repmgrd directly when postgres is already initialized.
#
# Failover detection design:
#   conninfo uses NODE_NAME (short hostname: ns1 / ns2). Docker extra_hosts maps
#   each node's own hostname to 127.0.0.1 (self) and the peer's hostname to its
#   real NetBird IP. So:
#     - Self-registration succeeds (local connect via 127.0.0.1)
#     - repmgrd on the PEER resolves the hostname to the real NetBird IP (via its
#       own extra_hosts), enabling actual cross-wire primary health monitoring
#   reconnect_attempts=6 / reconnect_interval=10 gives the primary 60 s to recover
#   before NS2 promotes itself. promote_delay=10 adds an extra safety window.

set -e

export REPMGR_CONFIG_FILE=${REPMGR_CONFIG_FILE:-/etc/repmgr/repmgr.conf}
export PGPASSWORD="${REPMGR_PASSWORD}"

# --- Stale file cleanup ---
# Leftover postmaster.pid (in volume) and socket lock files (in tmpfs) after an
# unclean container stop prevent PostgreSQL from starting. Remove them on every boot.
if [ -f "${PGDATA}/postmaster.pid" ]; then
  echo "--- Removing stale postmaster.pid ---" >&2
  rm -f "${PGDATA}/postmaster.pid"
fi
for f in /var/run/postgresql/.s.PGSQL.5432.lock \
          /var/run/postgresql/.s.PGSQL.5432 \
          /tmp/repmgrd.pid; do
  [ -e "$f" ] && { echo "--- Removing stale $f ---" >&2; rm -f "$f"; }
done

generate_repmgr_config() {
  mkdir -p "$(dirname "$REPMGR_CONFIG_FILE")"
  cat > "${REPMGR_CONFIG_FILE}" <<EOF
# Repmgr configuration
node_id=${NODE_ID}
node_name=${NODE_NAME}
# conninfo uses NODE_NAME (hostname).
# Docker extra_hosts maps each node's own hostname to 127.0.0.1 (self) and the
# peer's hostname to its real NetBird IP. This means:
#   - Self-registration works (local connect via 127.0.0.1)
#   - repmgrd on the PEER resolves this hostname to the real NetBird IP via its
#     own extra_hosts, enabling actual cross-wire failover detection
conninfo='host=${NODE_NAME} dbname=${REPMGR_DB} user=${REPMGR_USER} connect_timeout=5'
data_directory='${PGDATA}'
failover=automatic
promote_command='$(which repmgr) standby promote -f ${REPMGR_CONFIG_FILE} --log-to-file'
follow_command='$(which repmgr) standby follow -f ${REPMGR_CONFIG_FILE} --log-to-file --upstream-node-id %n'
# Give the primary 60 s (6 × 10 s) to recover before promoting the standby.
# This avoids spurious promotions on transient network glitches.
reconnect_attempts=6
reconnect_interval=10
# Extra safety window after all reconnect attempts fail, before actually promoting.
promote_delay=10
log_level=INFO
EOF
}

if [ "$REPMGR_ROLE" = 'primary' ]; then

  # First run: initialize the cluster
  if [ ! -s "$PGDATA/PG_VERSION" ]; then
    echo "--- Initializing primary node ---"

    initdb -U "$POSTGRES_USER" -D "$PGDATA"

    echo "shared_preload_libraries = 'repmgr'" >> "$PGDATA/postgresql.conf"
    echo "wal_level = replica" >> "$PGDATA/postgresql.conf"
    echo "max_wal_senders = 10" >> "$PGDATA/postgresql.conf"
    echo "max_replication_slots = 10" >> "$PGDATA/postgresql.conf"
    echo "hot_standby = on" >> "$PGDATA/postgresql.conf"
    echo "archive_mode = on" >> "$PGDATA/postgresql.conf"
    echo "archive_command = '/bin/true'" >> "$PGDATA/postgresql.conf"

    echo "host replication ${REPMGR_USER} all trust" >> "$PGDATA/pg_hba.conf"
    echo "host ${REPMGR_DB} ${REPMGR_USER} all trust" >> "$PGDATA/pg_hba.conf"
    # Allow app connections from Docker bridge networks and NetBird mesh
    echo "host all all 172.0.0.0/8 scram-sha-256" >> "$PGDATA/pg_hba.conf"
    echo "host all all 100.75.0.0/16 scram-sha-256" >> "$PGDATA/pg_hba.conf"

    pg_ctl -D "$PGDATA" -o "-c listen_addresses='*'" -w start
    createuser --superuser "$REPMGR_USER"
    createdb --owner="$REPMGR_USER" "$REPMGR_DB"
    pg_ctl -D "$PGDATA" -m fast -w stop

    echo "--- Primary initialized ---"
  fi

  echo "--- Generating repmgr.conf ---"
  generate_repmgr_config

  echo "--- Starting PostgreSQL ---"
  postgres -D "$PGDATA" &
  PG_PID=$!

  until pg_isready -q; do
    echo "Waiting for PostgreSQL..." >&2
    sleep 1
  done

  # Register primary — idempotent with --force
  echo "--- Registering primary node ---"
  repmgr -f "$REPMGR_CONFIG_FILE" primary register --force || {
    echo "Primary register failed but continuing (may already be registered)" >&2
  }

  echo "--- Starting repmgrd ---"
  exec repmgrd -f "$REPMGR_CONFIG_FILE" --daemonize=false

else

  if [ -z "$REPMGR_UPSTREAM_NAME" ]; then
    echo "ERROR: REPMGR_UPSTREAM_NAME is not set" >&2
    exit 1
  fi

  echo "--- Generating repmgr.conf ---"
  generate_repmgr_config

  if [ ! -s "$PGDATA/PG_VERSION" ]; then
    echo "--- Waiting for primary ($REPMGR_UPSTREAM_NAME) ---"
    until pg_isready -h "$REPMGR_UPSTREAM_NAME" -p 5432 -U "$REPMGR_USER"; do
      echo "Primary unavailable - sleeping" >&2
      sleep 5
    done

    echo "--- Cloning from primary ---"
    repmgr -h "$REPMGR_UPSTREAM_NAME" -U "$REPMGR_USER" -d "$REPMGR_DB" \
           -f "$REPMGR_CONFIG_FILE" standby clone
    echo "--- Clone complete ---"
  fi

  echo "--- Starting PostgreSQL (standby) ---"
  postgres -D "$PGDATA" &
  PG_PID=$!

  until pg_isready -q; do
    echo "Waiting for local PostgreSQL..." >&2
    sleep 1
  done

  # Register standby — idempotent with --force
  echo "--- Registering standby node ---"
  repmgr -f "$REPMGR_CONFIG_FILE" standby register --force || {
    echo "Standby register failed but continuing" >&2
  }

  echo "--- Starting repmgrd ---"
  exec repmgrd -f "$REPMGR_CONFIG_FILE" --daemonize=false
fi
