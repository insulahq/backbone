services:
  postgresql:
    image: {{ postgresql_image }}
    container_name: postgresql
    restart: unless-stopped
    ports:
      - '{{ wireguard_ip | default("127.0.0.1", true) }}:{{ postgresql_port }}:{{ postgresql_port }}'
    volumes:
      - postgresql_data:{{ postgresql_data_dir }}
      - /opt/postgresql/entrypoint-wrapper.sh:/entrypoint-wrapper.sh:ro
      - /opt/postgresql/pgproxy-target:/opt/postgresql/pgproxy-target  # PG write proxy target (updated by wrapper)
      - /var/run/docker.sock:/var/run/docker.sock:ro  # Restart Gatus after PG failover
    # Own hostname → 127.0.0.1: repmgr self-registration connects via localhost
    # (Docker hairpin NAT workaround — containers can't reach the host's WireGuard IP).
    # Peer hostname → real WireGuard IP: WAL streaming replication + cross-wire repmgrd
    # monitoring use this to reach the other node.
    extra_hosts:
      - "ns1:{{ '127.0.0.1' if inventory_hostname == 'ns1' else hostvars['ns1']['wireguard_ip'] }}"
      - "ns2:{{ '127.0.0.1' if inventory_hostname == 'ns2' else hostvars['ns2']['wireguard_ip'] }}"
    environment:
      # Data directory — must match the volume mount target.
      # Explicit because the custom entrypoint replaces the image default.
      PGDATA: "{{ postgresql_data_dir }}"

      # PostgreSQL superuser credentials (used by initdb on first run)
      POSTGRES_USER: "postgres"
      POSTGRES_PASSWORD: "{{ postgresql_superuser_password }}"

      # repmgr replication user and database
      REPMGR_USER: "repmgr"
      REPMGR_PASSWORD: "{{ postgresql_repmgr_password }}"
      REPMGR_DB: "repmgr"

      # REPMGR_INITIAL_ROLE: Only used on first boot (empty PGDATA).
      # On subsequent boots, the entrypoint detects the actual cluster state
      # by querying the peer, comparing timelines, and checking demotion markers.
      REPMGR_INITIAL_ROLE: "{{ 'primary' if postgresql_is_primary else 'standby' }}"
      NODE_ID: "{{ postgresql_node_id }}"
      NODE_NAME: "{{ inventory_hostname }}"

      # PEER_NAME: The other node in the 2-node cluster.
      # Used for failover detection, pg_rewind, split-brain watchdog.
      PEER_NAME: "{{ groups['dns_servers'] | difference([inventory_hostname]) | first }}"

      # Alerting — Gatus external endpoint + fallback webhook
      GATUS_URL: "http://gatus:{{ gatus_local_port | default('8080') }}"
      GATUS_TOKEN: "{{ gatus_external_token | default('') }}"
      ALERT_WEBHOOK_URL: "{{ alert_webhook_url | default('') }}"

      # WireGuard IPs for pgproxy target resolution (entrypoint-wrapper uses these)
      LOCAL_WG_IP: "{{ wireguard_ip }}"
      PEER_WG_IP: "{{ hostvars[groups['dns_servers'] | difference([inventory_hostname]) | first]['wireguard_ip'] }}"

      # DNS switching: delegated to /usr/local/bin/platform-dns-switch on the host
      # (called via nsenter from entrypoint-wrapper). Config in /etc/platform-dns-switch.env.

    entrypoint: ["/bin/bash", "/entrypoint-wrapper.sh"]
    command: []
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 60s
    logging:
      driver: "json-file"
      options:
        max-size: "200m"
        max-file: "2"

  # PG write proxy — always routes to the current primary.
  # Services with drivers that lack multi-host DSN support (lib/pq < 1.11, gpgsql)
  # connect to pgproxy:5432 instead of postgresql:5432 directly.
  # Target is read from /pgproxy-target at startup (mounted from host).
  # The PG entrypoint-wrapper updates this file after failover and restarts pgproxy.
  pgproxy:
    image: alpine/socat:1.8.0.1
    container_name: pgproxy
    restart: unless-stopped
    volumes:
      - /opt/postgresql/pgproxy-target:/pgproxy-target:ro
    entrypoint: ["/bin/sh", "-c"]
    command:
      - |
        TARGET=$$(cat /pgproxy-target 2>/dev/null || echo postgresql)
        # Validate target is an IP address or hostname (prevent injection)
        if ! echo "$$TARGET" | grep -qE '^[a-zA-Z0-9._-]+$$'; then
          echo "pgproxy: INVALID target '$$TARGET' — falling back to postgresql"
          TARGET=postgresql
        fi
        echo "pgproxy: forwarding to $$TARGET:5432"
        exec socat TCP-LISTEN:5432,fork,reuseaddr TCP:$$TARGET:5432
    healthcheck:
      test: ["CMD-SHELL", "socat -T1 /dev/null TCP:localhost:5432,connect-timeout=2"]
      interval: 10s
      timeout: 3s
      retries: 3
      start_period: 5s
    logging:
      driver: "json-file"
      options:
        max-size: "50m"
        max-file: "2"

networks:
  default:
    name: postgresql_default

volumes:
  postgresql_data:
