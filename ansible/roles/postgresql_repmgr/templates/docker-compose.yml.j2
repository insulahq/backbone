services:
  postgresql:
    image: {{ postgresql_image }}
    container_name: postgresql
    restart: unless-stopped
    ports:
      - '0.0.0.0:{{ postgresql_port }}:{{ postgresql_port }}'
    volumes:
      - postgresql_data:{{ postgresql_data_dir }}
      - /opt/postgresql/entrypoint-wrapper.sh:/entrypoint-wrapper.sh:ro
    # Own hostname → 127.0.0.1: repmgr self-registration connects via localhost
    # (Docker hairpin NAT workaround — containers can't reach the host's WireGuard IP).
    # Peer hostname → real NetBird IP: WAL streaming replication + cross-wire repmgrd
    # monitoring use this to reach the other node.
    # Written role-agnostically so either ns1 or ns2 can be primary after a failover.
    extra_hosts:
      - "ns1:{{ '127.0.0.1' if inventory_hostname == 'ns1' else hostvars['ns1']['netbird_ip'] }}"
      - "ns2:{{ '127.0.0.1' if inventory_hostname == 'ns2' else hostvars['ns2']['netbird_ip'] }}"
    environment:
      # PostgreSQL superuser credentials (used by initdb on first run)
      POSTGRES_USER: "postgres"
      POSTGRES_PASSWORD: "{{ postgresql_superuser_password }}"

      # repmgr replication user and database
      REPMGR_USER: "repmgr"
      REPMGR_PASSWORD: "{{ postgresql_repmgr_password }}"
      REPMGR_DB: "repmgr"

      REPMGR_ROLE: "{{ 'primary' if postgresql_is_primary else 'standby' }}"
      NODE_ID: "{{ postgresql_node_id }}"
      NODE_NAME: "{{ inventory_hostname }}"

      # Standby only: primary hostname to clone from (resolves to NetBird IP via extra_hosts)
{% if not postgresql_is_primary %}
      REPMGR_UPSTREAM_NAME: "{{ postgresql_primary_node }}"
{% endif %}

    entrypoint: ["/bin/bash", "/entrypoint-wrapper.sh"]
    command: []
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 60s
    logging:
      driver: "json-file"
      options:
        max-size: "200m"
        max-file: "2"

volumes:
  postgresql_data:
